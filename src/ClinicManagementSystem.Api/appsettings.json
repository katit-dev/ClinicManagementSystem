{
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": "",
    "AzureBlob": {
      "ServiceUri": "",
      "ContainerName": "medical-records"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ClinicDb": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Jwt": {
    "Issuer": "ClinicManagementSystem.Api",
    "Audience": "ClinicManagementSystem.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "PasswordResetOtpExpirationMinutes": 5
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "Clinic Management System"
  },
  "AllowedHosts": "*",
  "SupportChat": {
    "Enabled": false,
    "SupportHours": "Giờ hành chính hằng ngày, gồm Thứ Bảy và Chủ Nhật",
    "Hotline": "0389479884",
    "MaxMessageLength": 2000,
    "ReconciliationIntervalSeconds": 30,
    "MessagesPerMinute": 30,
    "CreatesPerHour": 10
  }
}
