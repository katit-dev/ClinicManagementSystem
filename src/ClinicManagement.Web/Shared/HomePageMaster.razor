@inherits LayoutComponentBase

@inject UserStateService _userStateService

@implements IDisposable


@* =====================================================
   APPLICATION LAYOUT
   ===================================================== *@

<div class="app-layout">


    @* =================================================
       SIDEBAR
       ================================================= *@

    <aside class="app-sidebar">

        @* =============================================
           BRAND
           ============================================= *@

        <div class="sidebar-brand">

            <div class="sidebar-logo">

                <i class="fas fa-clinic-medical"></i>

            </div>


            <div class="sidebar-brand-text">

                <div class="sidebar-brand-title">
                    Clinic
                </div>

                <div class="sidebar-brand-subtitle">
                    Management System
                </div>

            </div>

        </div>


        @* =============================================
           NAVIGATION
           ============================================= *@

        <nav class="sidebar-navigation">


            @* =========================================
               DASHBOARD
               ========================================= *@

            <a href="@GetDashboardUrl()"
               class="sidebar-link">

                <i class="fas fa-home"></i>

                <span>
                    Trang chủ
                </span>

            </a>


            @* =========================================
               PATIENT MENU
               ========================================= *@

            @if (HasRole("Patient"))
            {
                <a href="/book-appointment"
                   class="sidebar-link">

                    <i class="fas fa-calendar-plus"></i>

                    <span>
                        Đặt lịch khám
                    </span>

                </a>


                <a href="/my-appointments"
                   class="sidebar-link">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        Lịch hẹn của tôi
                    </span>

                </a>
            }

        </nav>


        @* =============================================
           SIDEBAR BOTTOM
           ============================================= *@

        @if (_userStateService.CurrentUser != null)
        {
            <div class="sidebar-bottom">

                <button type="button"
                        class="sidebar-logout"
                        @onclick="HandleLogout">

                    <i class="fas fa-sign-out-alt"></i>

                    <span>
                        Đăng xuất
                    </span>

                </button>

            </div>
        }

    </aside>


    @* =================================================
       APPLICATION CONTENT
       ================================================= *@

    <div class="app-content">


        @* =============================================
           TEMPORARY HEADER
           ============================================= *@

        <header class="app-header">

            @if (_userStateService.CurrentUser != null)
            {
                <div class="header-user-name">

                    @_userStateService.CurrentUser.FullName

                </div>
            }

        </header>


        @* =============================================
           MAIN CONTENT
           ============================================= *@

        <main class="app-main">

            @Body

        </main>

    </div>

</div>


@code {

    // =====================================================
    // CHECK ROLE
    // =====================================================

    private bool HasRole(
        string roleName)
    {
        var user =
            _userStateService.CurrentUser;


        if (user == null)
        {
            return false;
        }


        return user.Roles.Any(
            role =>
                role.Equals(
                    roleName,
                    StringComparison.OrdinalIgnoreCase
                )
        );
    }


    // =====================================================
    // GET DASHBOARD URL
    // =====================================================

    private string GetDashboardUrl()
    {
        var user =
            _userStateService.CurrentUser;


        if (user == null)
        {
            return "/";
        }


        if (HasRole("Admin"))
        {
            return "/admin";
        }


        if (HasRole("Doctor"))
        {
            return "/doctor";
        }


        if (HasRole("Receptionist"))
        {
            return "/reception";
        }


        if (HasRole("Patient"))
        {
            return "/patient";
        }


        return "/";
    }


    // =====================================================
    // LOGOUT
    // =====================================================

    private async Task HandleLogout()
    {
        await _userStateService
            .LogoutAsync();
    }


    // =====================================================
    // COMPONENT INITIALIZATION
    //
    // 1. Đăng ký lắng nghe UserStateService.OnChange
    //
    // 2. Load lại user từ LocalStorage
    // khi F5 hoặc mở lại website
    // =====================================================

    protected override async Task
        OnInitializedAsync()
    {
        _userStateService.OnChange +=
            StateHasChanged;


        await _userStateService
            .LoadUserStateAsync();
    }


    // =====================================================
    // DISPOSE
    //
    // Khi component bị hủy
    // phải unsubscribe event
    // =====================================================

    public void Dispose()
    {
        _userStateService.OnChange -=
            StateHasChanged;
    }
}