@inherits LayoutComponentBase

@inject UserStateService _userStateService

@implements IDisposable


@* =====================================================
   APPLICATION LAYOUT
   ===================================================== *@

<div class="app-layout">


    @* =================================================
       SIDEBAR
       ================================================= *@

    <aside class="app-sidebar @(_isSidebarOpen ? "open" : "")">

        @* =============================================
           BRAND
           ============================================= *@

        <div class="sidebar-brand">

            <div class="sidebar-logo">

                <i class="fas fa-clinic-medical"></i>

            </div>


            <div class="sidebar-brand-text">

                <div class="sidebar-brand-title">
                    Clinic
                </div>

                <div class="sidebar-brand-subtitle">
                    Management System
                </div>

            </div>

        </div>


        @* =============================================
        NAVIGATION
        ============================================= *@

        <nav class="sidebar-navigation">


            @* =========================================
            DASHBOARD
            ========================================= *@

            <NavLink href="@GetDashboardUrl()" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                     @onclick="CloseSidebar">

                <i class="fas fa-home"></i>

                <span>
                    Trang chủ
                </span>

            </NavLink>


            @* =========================================
            PATIENT MENU
            ========================================= *@

            @if (HasRole("Patient"))
            {
                @* =====================================================
                BOOK APPOINTMENT
                ===================================================== *@

                <NavLink href="/patient/booking" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-calendar-plus"></i>

                    <span>
                        Đặt lịch khám
                    </span>

                </NavLink>


                @* =====================================================
                MY APPOINTMENTS
                ===================================================== *@

                <NavLink href="/patient/appointments" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        Lịch hẹn của tôi
                    </span>

                </NavLink>


                @* =====================================================
                MEDICAL RECORDS
                ===================================================== *@

                <NavLink href="/patient/records" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-file-medical-alt"></i>

                    <span>
                        Lịch sử khám
                    </span>

                </NavLink>
            }

        </nav>

        

    </aside>

    @* =================================================
    MOBILE SIDEBAR OVERLAY
    ================================================= *@

    @if (_isSidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar">
        </div>
    }


    @* =================================================
       APPLICATION CONTENT
       ================================================= *@

    <div class="app-content">


        @* =============================================
           TEMPORARY HEADER
           ============================================= *@

        @* =============================================
            TOPBAR
            ============================================= *@

        <header class="app-header">

            @* =========================================
            HEADER LEFT
            ========================================= *@

            <div class="header-left">

                @* =====================================
                MOBILE MENU
                ===================================== *@

                <button type="button" class="mobile-menu-button" aria-label="Mở menu" @onclick="ToggleSidebar">

                    <i class="fas fa-bars"></i>

                </button>


                @* =====================================
                PAGE INFORMATION
                ===================================== *@

                <div class="header-information">

                    <h1 class="header-title">
                        Không gian làm việc
                    </h1>

                    <p class="header-subtitle">
                        Quản lý hoạt động phòng khám
                    </p>

                </div>

            </div>


            @* =========================================
            CURRENT USER
            ========================================= *@

            @if (_userStateService.CurrentUser != null)
            {
                <div class="header-user-area">

                    @* =====================================
                    USER PROFILE
                    ===================================== *@

                    <div class="header-user">

                        <div class="header-avatar">

                            @GetUserInitials()

                        </div>


                        <div class="header-user-information">

                            <div class="header-user-name">
                                @(_userStateService.CurrentUser.FullName)
                            </div>


                            <div class="header-user-role">
                                @string.Join(
                                    ", ",
                                    _userStateService.CurrentUser.Roles
                                )
                            </div>

                        </div>

                    </div>


                    @* =====================================
                    LOGOUT
                    ===================================== *@

                    <button type="button" class="header-logout" title="Đăng xuất" @onclick="HandleLogout">

                        <i class="fas fa-sign-out-alt"></i>

                    </button>

                </div>
            }

        </header>


        @* =============================================
        MAIN CONTENT
        ============================================= *@

        <main class="app-main">

            <div class="app-main-container">

                @Body

            </div>

        </main>

    </div>

</div>


@code {

    // =====================================================
    // CHECK ROLE
    // =====================================================

    private bool HasRole(
        string roleName)
    {
        var user =
            _userStateService.CurrentUser;


        if (user == null)
        {
            return false;
        }


        return user.Roles.Any(
            role =>
                role.Equals(
                    roleName,
                    StringComparison.OrdinalIgnoreCase
                )
        );
    }


    // =====================================================
    // GET DASHBOARD URL
    // =====================================================

    private string GetDashboardUrl()
    {
        var user =
            _userStateService.CurrentUser;


        if (user == null)
        {
            return "/";
        }


        if (HasRole("Admin"))
        {
            return "/admin";
        }


        if (HasRole("Doctor"))
        {
            return "/doctor";
        }


        if (HasRole("Receptionist"))
        {
            return "/reception";
        }


        if (HasRole("Patient"))
        {
            return "/patient";
        }


        return "/";
    }


    // =====================================================
    // LOGOUT
    // =====================================================

    private async Task HandleLogout()
    {
        await _userStateService
            .LogoutAsync();
    }

    // =====================================================
    // GET USER INITIALS
    //
    // Ví dụ:
    //
    // "Trần Nguyên Khánh Vy"
    // → TV
    //
    // "Nguyễn An"
    // → NA
    // =====================================================

    private string GetUserInitials()
    {
        var fullName =
            _userStateService
                .CurrentUser?
                .FullName;


        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "U";
        }


        var nameParts =
            fullName
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries
                );


        if (nameParts.Length == 1)
        {
            return nameParts[0]
                .Substring(0, 1)
                .ToUpper();
        }


        var firstInitial =
            nameParts[0][0];

        var lastInitial =
            nameParts[^1][0];


        return $"{firstInitial}{lastInitial}"
            .ToUpper();
    }

    // =====================================================
    // COMPONENT INITIALIZATION
    // =====================================================

    protected override async Task
        OnInitializedAsync()
    {
        _userStateService.OnChange +=
            StateHasChanged;


        await _userStateService
            .LoadUserStateAsync();
    }


    // =====================================================
    // SIDEBAR STATE
    // =====================================================

    private bool _isSidebarOpen;


    // =====================================================
    // TOGGLE SIDEBAR
    // =====================================================

    private void ToggleSidebar()
    {
        _isSidebarOpen =
            !_isSidebarOpen;
    }


    // =====================================================
    // CLOSE SIDEBAR
    // =====================================================

    private void CloseSidebar()
    {
        _isSidebarOpen =
            false;
    }

    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _userStateService.OnChange -=
            StateHasChanged;
    }
}