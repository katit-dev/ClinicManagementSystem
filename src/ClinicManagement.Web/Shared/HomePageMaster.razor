@inherits LayoutComponentBase

@inject UserStateService _userStateService
@inject IJSRuntime JS

@implements IDisposable


@* =====================================================
   APPLICATION LAYOUT
   ===================================================== *@

<div class="app-layout">


    @* =================================================
       SIDEBAR
       ================================================= *@

    <aside class="app-sidebar @(_isSidebarOpen ? "open" : "")">


        @* =============================================
           BRAND
           ============================================= *@

        <div class="sidebar-brand">

            <div class="sidebar-logo">
                <i class="fas fa-clinic-medical"></i>
            </div>

            <div class="sidebar-brand-text">

                <div class="sidebar-brand-title">
                    Clinic
                </div>

                <div class="sidebar-brand-subtitle">
                    Management System
                </div>

            </div>

        </div>


        @* =============================================
           NAVIGATION
           ============================================= *@

        <nav class="sidebar-navigation">


            @* =========================================
               DASHBOARD
               ========================================= *@

            @if (!HasRole("Doctor") && !HasRole("Pharmacist"))
            {
                <NavLink href="@GetDashboardUrl()" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-home"></i>

                    <span>
                        Trang chủ
                    </span>

                </NavLink>
            }

            @* =========================================
               RECEPTION MENU
               ========================================= *@

            @if (HasRole("Admin"))
            {
                <NavLink href="/admin/specialties" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-stethoscope" aria-hidden="true"></i>
                    <span>Chuyên khoa</span>
                </NavLink>
                <NavLink href="/admin/schedules" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                    <span>Lịch làm việc &amp; nghỉ phép</span>
                </NavLink>
                <NavLink href="/admin/services" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-file-medical" aria-hidden="true"></i>
                    <span>Danh mục dịch vụ</span>
                </NavLink>
                <NavLink href="/admin/users" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-user-shield" aria-hidden="true"></i>
                    <span>Người dùng &amp; phân quyền</span>
                </NavLink>
                <NavLink href="/admin/reports" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-chart-line" aria-hidden="true"></i>
                    <span>Báo cáo doanh thu &amp; lượt khám</span>
                </NavLink>
                <NavLink href="/admin/audit-logs" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">
                    <i class="fas fa-history" aria-hidden="true"></i>
                    <span>Nhật ký truy cập bệnh án</span>
                </NavLink>
            }
            @if (HasRole("Receptionist"))
            {
                <NavLink href="/reception/affected-appointments" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <i class="fas fa-calendar-times" aria-hidden="true"></i>
                    <span>Lịch hẹn bị ảnh hưởng</span>
                </NavLink>
                <NavLink href="/reception/notifications" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All" @onclick="CloseSidebar">
                    <i class="fas fa-bell" aria-hidden="true"></i>
                    <span>Thông báo</span>
                </NavLink>
                @* =========================================
       BOOKING
       ========================================= *@

                <NavLink href="/reception/booking" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-calendar-plus"></i>

                    <span>
                        Đặt lịch khám
                    </span>

                </NavLink>


                @* =========================================
       QUEUE
       ========================================= *@

                <NavLink href="/reception/queue" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-list-ol"></i>

                    <span>
                        Hàng chờ
                    </span>

                </NavLink>


                @* =========================================
       PATIENTS
       ========================================= *@

                <NavLink href="/reception/patients" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">

                    <i class="fas fa-user-injured"></i>

                    <span>
                        Hồ sơ bệnh nhân
                    </span>

                </NavLink>
            }

            @if (HasRole("Patient"))
            {
                @* =====================================
                   BOOK APPOINTMENT
                   ===================================== *@

                <NavLink href="/patient/booking" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-calendar-plus"></i>

                    <span>
                        Đặt lịch khám
                    </span>

                </NavLink>


                @* =====================================
                   MY APPOINTMENTS
                   ===================================== *@

                <NavLink href="/patient/appointments" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-calendar-check"></i>

                    <span>
                        Lịch hẹn của tôi
                    </span>

                </NavLink>


                @* =====================================
                   MEDICAL RECORDS
                   ===================================== *@

                <NavLink href="/patient/records" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-file-medical-alt"></i>

                    <span>
                        Lịch sử khám
                    </span>

                </NavLink>


                @* =====================================
                   MY INVOICES
                   ===================================== *@

                <NavLink href="/patient/invoices" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-file-invoice-dollar"></i>

                    <span>
                        Hóa đơn của tôi
                    </span>

                </NavLink>
            }

            @* =====================================================
   DOCTOR MENU
   ===================================================== *@

            @if (HasRole("Doctor"))
            {
                @* =================================================
       DOCTOR QUEUE
       ================================================= *@

                <NavLink href="/doctor/doctor-queue" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-user-md"></i>

                    <span>
                        Hàng chờ bệnh nhân
                    </span>

                </NavLink>

                <NavLink href="/doctor/notifications" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-bell"></i>

                    <span>
                        Thông báo
                    </span>

                </NavLink>
            }

            @* =====================================================
   PHARMACIST MENU
   ===================================================== *@

            @if (HasRole("Pharmacist"))
            {
                <NavLink href="/pharmacy" class="sidebar-link" ActiveClass="active" Match="NavLinkMatch.All"
                         @onclick="CloseSidebar">

                    <i class="fas fa-pills"></i>

                    <span>
                        Phát thuốc
                    </span>

                </NavLink>

                <NavLink href="/pharmacy/inventory" class="sidebar-link" Match="NavLinkMatch.Prefix"
                         @onclick="CloseSidebar">

                    <i class="fas fa-pills"></i>

                    <span>
                        Kho thuốc
                    </span>

                </NavLink>


            }

        </nav>

    </aside>


    @* =================================================
       MOBILE SIDEBAR OVERLAY
       ================================================= *@

    @if (_isSidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="CloseSidebar">
        </div>
    }


    @* =================================================
       APPLICATION CONTENT
       ================================================= *@

    <div class="app-content">


        @* =============================================
           TOPBAR
           ============================================= *@

        <header class="app-header">


            @* =========================================
               HEADER LEFT
               ========================================= *@

            <div class="header-left">


                @* =====================================
                   MOBILE MENU
                   ===================================== *@

                <button type="button" class="mobile-menu-button" aria-label="Mở menu" @onclick="ToggleSidebar">

                    <i class="fas fa-bars"></i>

                </button>


                @* =====================================
                   PAGE INFORMATION
                   ===================================== *@

                <div class="header-information">

                    <h1 class="header-title">
                        Không gian làm việc
                    </h1>

                    <p class="header-subtitle">
                        Quản lý hoạt động phòng khám
                    </p>

                </div>

            </div>


            @* =========================================
               CURRENT USER
               ========================================= *@

            @if (_userStateService.CurrentUser != null)
            {
                <div class="header-user-area">


                    @* =================================
                       USER PROFILE
                       ================================= *@

                    <div class="header-user">

                        <div class="header-avatar">
                            @GetUserInitials()
                        </div>

                        <div class="header-user-information">

                            <div class="header-user-name">
                                @_userStateService.CurrentUser.FullName
                            </div>

                            <div class="header-user-role">
                                @string.Join(
                                    ", ",
                                    _userStateService.CurrentUser.Roles
                                )
                            </div>

                        </div>

                    </div>


                    @* =================================
                       LOGOUT
                       ================================= *@

                    <button type="button" class="header-logout" title="Đăng xuất" aria-label="Đăng xuất" @onclick="HandleLogout">

                        <i class="fas fa-sign-out-alt" aria-hidden="true"></i>

                    </button>

                </div>
            }

        </header>


        @* =============================================
           MAIN CONTENT
           ============================================= *@

        <main class="app-main">

            <div class="app-main-container">

                @Body

            </div>

        </main>

    </div>

</div>

@if (_userStateService.CurrentUser != null)
{
    <dialog id="logout-confirm-dialog" class="logout-confirm-dialog"
            aria-labelledby="logout-confirm-title" aria-describedby="logout-confirm-description">
        <div class="logout-confirm-body">
            <button type="submit" value="cancel" form="logout-confirm-form" class="logout-confirm-close"
                    aria-label="Đóng xác nhận đăng xuất" title="Đóng">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
            <div class="logout-confirm-icon"><i class="fas fa-sign-out-alt" aria-hidden="true"></i></div>
            <h2 id="logout-confirm-title">Bạn muốn đăng xuất?</h2>
            <p id="logout-confirm-description">Bạn cần đăng nhập lại để tiếp tục sử dụng hệ thống.</p>
        </div>
        <form id="logout-confirm-form" method="dialog" class="logout-confirm-actions">
            <button type="submit" value="cancel" class="logout-confirm-button logout-confirm-cancel" autofocus>Ở lại</button>
            <button type="submit" value="confirm" class="logout-confirm-button logout-confirm-submit">
                <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
                <span>Đăng xuất</span>
            </button>
        </form>
    </dialog>
}


@code {

    // =====================================================
    // SIDEBAR STATE
    // =====================================================

    private bool _isSidebarOpen;
    private bool _logoutPending;


    // =====================================================
    // CHECK ROLE
    // =====================================================

    private bool HasRole(string roleName)
    {
        var user = _userStateService.CurrentUser;

        if (user == null)
        {
            return false;
        }

        return user.Roles.Any(
            role =>
                role.Equals(
                    roleName,
                    StringComparison.OrdinalIgnoreCase
                )
        );
    }


    // =====================================================
    // GET DASHBOARD URL
    // =====================================================

    private string GetDashboardUrl()
    {
        var user = _userStateService.CurrentUser;

        if (user == null)
        {
            return "/";
        }

        if (HasRole("Admin"))
        {
            return "/admin";
        }

        if (HasRole("Doctor"))
        {
            return "/doctor";
        }

        if (HasRole("Receptionist"))
        {
            return "/reception";
        }

        if (HasRole("Pharmacist"))
        {
            return "/pharmacy";
        }

        if (HasRole("Patient"))
        {
            return "/patient";
        }

        return "/";
    }
    // =====================================================
    // LOGOUT
    // =====================================================

    private async Task HandleLogout()
    {
        if (_logoutPending) return;
        _logoutPending = true;
        try
        {
            if (await JS.InvokeAsync<bool>("clinicLayout.confirmLogout", CancellationToken.None))
                await _userStateService.LogoutAsync();
        }
        finally
        {
            _logoutPending = false;
        }
    }


    // =====================================================
    // GET USER INITIALS
    // =====================================================

    private string GetUserInitials()
    {
        var fullName =
            _userStateService.CurrentUser?.FullName;

        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "U";
        }

        var nameParts = fullName.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries
        );

        if (nameParts.Length == 1)
        {
            return nameParts[0]
                .Substring(0, 1)
                .ToUpper();
        }

        var firstInitial = nameParts[0][0];
        var lastInitial = nameParts[^1][0];

        return $"{firstInitial}{lastInitial}"
            .ToUpper();
    }


    // =====================================================
    // COMPONENT INITIALIZATION
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        _userStateService.OnChange += StateHasChanged;

        // await _userStateService.LoadUserStateAsync();
    }


    // =====================================================
    // TOGGLE SIDEBAR
    // =====================================================

    private void ToggleSidebar()
    {
        _isSidebarOpen = !_isSidebarOpen;
    }


    // =====================================================
    // CLOSE SIDEBAR
    // =====================================================

    private void CloseSidebar()
    {
        _isSidebarOpen = false;
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _userStateService.OnChange -= StateHasChanged;
    }
}
