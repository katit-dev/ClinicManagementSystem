@inherits LayoutComponentBase

@inject UserStateService _userStateService

@implements IDisposable


@* =====================================================
   HEADER
   ===================================================== *@

<header class="bg-primary text-white">

    <div class="container py-3">

        <div class="d-flex justify-content-between align-items-center">

            @* =================================================
               LOGO / HOME
               ================================================= *@

            <a href="/" class="text-white text-decoration-none">

                <h4 class="mb-0">

                    <i class="fas fa-clinic-medical me-2"></i>

                    Clinic Management

                </h4>

            </a>


            @* =================================================
               USER INFORMATION
               ================================================= *@

            <div class="d-flex align-items-center gap-3">

                @if (_userStateService.CurrentUser == null)
                {
                    @* =========================================
                       CHƯA ĐĂNG NHẬP
                       ========================================= *@

                    <a href="/login" class="btn btn-light btn-sm">

                        <i class="fas fa-sign-in-alt me-1"></i>

                        Đăng nhập

                    </a>
                }
                else
                {
                    @* =========================================
                       ĐÃ ĐĂNG NHẬP
                       ========================================= *@

                    <div class="text-end">

                        @* Tên người dùng *@

                        <div class="fw-semibold">

                            <i class="fas fa-user-circle me-1"></i>

                            @_userStateService.CurrentUser.FullName

                        </div>


                        @* Role của người dùng *@

                        <div class="small opacity-75">

                            @string.Join(
                                ", ",
                                _userStateService.CurrentUser.Roles
                            )

                        </div>

                    </div>

                    @* =================================================
                        DASHBOARD BUTTON
                    ================================================= *@

                    <a href="@GetDashboardUrl()" class="btn btn-light btn-sm">

                        <i class="fas fa-home me-1"></i>

                        Trang làm việc

                    </a>
                }

            </div>

        </div>

    </div>

</header>


@* =====================================================
   MAIN CONTENT
   ===================================================== *@

<main class="py-4">

    <div class="container">

        @Body

    </div>

</main>


@* =====================================================
   FOOTER
   ===================================================== *@

<footer class="bg-light border-top mt-5">

    <div class="container py-4">

        <div class="text-center text-secondary">

            © 2026 Clinic Management System

        </div>

    </div>

</footer>


@code {

    private string GetDashboardUrl()
    {
        var user = _userStateService.CurrentUser;

        if (user == null)
        {
            return "/";
        }

        if (user.Roles.Any(
            role => role.Equals(
                "Admin",
                StringComparison.OrdinalIgnoreCase)))
        {
            return "/admin";
        }

        if (user.Roles.Any(
            role => role.Equals(
                "Doctor",
                StringComparison.OrdinalIgnoreCase)))
        {
            return "/doctor";
        }

        if (user.Roles.Any(
            role => role.Equals(
                "Receptionist",
                StringComparison.OrdinalIgnoreCase)))
        {
            return "/reception";
        }

        if (user.Roles.Any(
            role => role.Equals(
                "Patient",
                StringComparison.OrdinalIgnoreCase)))
        {
            return "/patient";
        }

        return "/";
    }


    // =====================================================
    // COMPONENT INITIALIZATION
    //
    // 1. Đăng ký lắng nghe UserStateService.OnChange
    //
    // 2. Load lại user từ LocalStorage
    // khi F5 hoặc mở lại website
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        _userStateService.OnChange += StateHasChanged;

        await _userStateService.LoadUserStateAsync();
    }


    // =====================================================
    // DISPOSE
    //
    // Khi component bị hủy
    // phải unsubscribe event
    // =====================================================

    public void Dispose()
    {
        _userStateService.OnChange -= StateHasChanged;
    }

}