@page "/admin"
@page "/admin/dashboard"
@layout HomePageMaster
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Quản trị phòng khám</PageTitle>

<div class="mb-4">
    <h1 class="fw-bold">Quản trị phòng khám</h1>
    <p class="text-secondary">Chuẩn bị và quản lý dữ liệu phục vụ hoạt động phòng khám.</p>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <i class="fas fa-stethoscope fa-2x text-primary mb-3" aria-hidden="true"></i>
                <h2 class="h4">Chuyên khoa</h2>
                <p class="text-secondary">Tra cứu, thêm, cập nhật và quản lý trạng thái hoạt động của chuyên khoa.</p>
                <a class="btn btn-primary" href="/admin/specialties">Quản lý chuyên khoa</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <i class="fas fa-calendar-alt fa-2x text-primary mb-3" aria-hidden="true"></i>
                <h2 class="h4">Lịch làm việc &amp; nghỉ phép</h2>
                <p class="text-secondary">Khai lịch làm việc theo giai đoạn hiệu lực, đăng ký nghỉ và kiểm tra lịch hẹn bị ảnh hưởng.</p>
                <a class="btn btn-primary" href="/admin/schedules">Quản lý lịch làm việc</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <i class="fas fa-file-medical fa-2x text-primary mb-3" aria-hidden="true"></i>
                <h2 class="h4">Danh mục dịch vụ</h2>
                <p class="text-secondary">Quản lý dịch vụ khám, xét nghiệm và chẩn đoán hình ảnh, giá và thời lượng thực hiện.</p>
                <a class="btn btn-primary" href="/admin/services">Quản lý dịch vụ</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <i class="fas fa-user-shield fa-2x text-primary mb-3" aria-hidden="true"></i>
                <h2 class="h4">Người dùng &amp; phân quyền</h2>
                <p class="text-secondary">Tra cứu tài khoản, gán nhiều vai trò, reset mật khẩu và khóa hoặc mở khóa tài khoản.</p>
                <a class="btn btn-primary" href="/admin/users">Quản lý người dùng</a>
            </div>
        </div>
    </div>
</div>
