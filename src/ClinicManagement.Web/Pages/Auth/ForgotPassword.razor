@page "/forgot-password"

@layout LandingPageMaster

@using ClinicManagementSystem.Application.DTOs.Auth

@inject UserStateService _userStateService
@inject ILocalStorageService _localStorageService
@inject NavigationManager _navigationManager

<PageTitle>Quên mật khẩu</PageTitle>


@* =====================================================
   FORGOT PASSWORD PAGE
   ===================================================== *@

<section class="auth-page">

    @* =================================================
       BACKGROUND OVERLAY
       ================================================= *@

    <div class="auth-overlay"></div>


    @* =================================================
       AUTH SHELL
       ================================================= *@

    <div class="auth-shell">

        @* =================================================
           BRAND PANEL
           ================================================= *@

        <div class="auth-brand-panel">

            <div class="auth-brand">
                Clinic Management System
            </div>

            <h1 class="auth-brand-title">
                Khôi phục tài khoản
                <span>nhanh chóng</span>
            </h1>

            <p class="auth-brand-description">
                Chúng tôi sẽ gửi mã OTP đến email đã đăng ký
                để bạn xác minh tài khoản và tạo mật khẩu mới.
            </p>


            @* =================================================
               BENEFITS
               ================================================= *@

            <div class="auth-benefits">

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-envelope"></i>
                    </div>

                    <span>
                        Nhận mã OTP qua email
                    </span>

                </div>

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>

                    <span>
                        Xác minh tài khoản an toàn
                    </span>

                </div>

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-key"></i>
                    </div>

                    <span>
                        Tạo lại mật khẩu mới
                    </span>

                </div>

            </div>

        </div>


        @* =================================================
           FORM PANEL
           ================================================= *@

        <div class="auth-form-panel">

            @* =================================================
               FORM HEADER
               ================================================= *@

            <div class="auth-form-header">

                <div class="auth-form-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h2 class="auth-form-title">
                    Quên mật khẩu
                </h2>

                <p class="auth-form-description">
                    Nhập email đã đăng ký.
                    Hệ thống sẽ gửi mã OTP để bạn đặt lại mật khẩu.
                </p>

            </div>


            @* =================================================
               FORGOT PASSWORD FORM
               ================================================= *@

            <EditForm Model="@forgotPasswordRequest"
                      OnValidSubmit="HandleForgotPassword">

                <DataAnnotationsValidator />


                @* =================================================
                   EMAIL
                   ================================================= *@

                <div class="auth-field">

                    <label for="email"
                           class="auth-label">
                        Email
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-envelope"></i>
                        </span>

                        <InputText id="email"
                                   class="auth-input"
                                   type="email"
                                   @bind-Value="forgotPasswordRequest.Email"
                                   placeholder="Nhập email đã đăng ký"
                                   autocomplete="email" />

                    </div>

                    <ValidationMessage
                        For="@(() => forgotPasswordRequest.Email)"
                        class="auth-validation" />

                    <div class="auth-helper">
                        Mã OTP sẽ được gửi đến email này.
                    </div>

                </div>


                @* =================================================
                   ERROR MESSAGE
                   ================================================= *@

                @if (!string.IsNullOrWhiteSpace(
                    _userStateService.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-danger">

                        <i class="fas fa-exclamation-circle me-1"></i>

                        @_userStateService.ErrorMessage

                    </div>
                }


                @* =================================================
                   SUBMIT
                   ================================================= *@

                <button type="submit"
                        class="auth-submit"
                        disabled="@isSubmitting">

                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>
                            Đang gửi OTP...
                        </span>
                    }
                    else
                    {
                        <i class="fas fa-paper-plane"></i>

                        <span>
                            Gửi mã OTP
                        </span>
                    }

                </button>

            </EditForm>


            @* =================================================
               LOGIN
               ================================================= *@

            <div class="auth-divider">
                hoặc
            </div>

            <div class="auth-footer">

                <span>
                    Đã nhớ mật khẩu?
                </span>

                <a href="/login"
                   class="auth-link">
                    Đăng nhập
                </a>

            </div>


            @* =================================================
               HOME
               ================================================= *@

            <div class="auth-footer mt-3">

                <a href="/"
                   class="auth-link">

                    <i class="fas fa-arrow-left me-1"></i>

                    Quay lại trang chủ

                </a>

            </div>

        </div>

    </div>

</section>


@code {

    // =====================================================
    // FORGOT PASSWORD MODEL
    // =====================================================

    private ForgotPasswordRequestDTO forgotPasswordRequest = new();


    // =====================================================
    // SUBMIT STATE
    // =====================================================

    private bool isSubmitting;


    // =====================================================
    // HANDLE FORGOT PASSWORD
    // =====================================================

    private async Task HandleForgotPassword()
    {
        // =================================================
        // PREVENT DOUBLE SUBMIT
        // =================================================

        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            // =================================================
            // CALL FORGOT PASSWORD API
            // =================================================

            var success =
                await _userStateService
                    .ForgotPasswordAsync(
                        forgotPasswordRequest
                    );


            // =================================================
            // FAILED
            // =================================================

            if (!success)
            {
                return;
            }


            // =================================================
            // SAVE EMAIL FOR RESET PASSWORD PAGE
            // =================================================

            await _localStorageService
                .SetItemAsync(
                    "resetPasswordEmail",
                    forgotPasswordRequest.Email.Trim()
                );


            // =================================================
            // NAVIGATE TO RESET PASSWORD
            // =================================================

            _navigationManager.NavigateTo(
                "/reset-password"
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }
}