@page "/forgot-password"

@layout HomePageMaster

@inject UserStateService _userStateService
@inject ILocalStorageService _localStorageService
@inject NavigationManager _navigationManager


<PageTitle>Quên mật khẩu</PageTitle>


@* =====================================================
   FORGOT PASSWORD PAGE
   ===================================================== *@

<div class="row justify-content-center">

    <div class="col-12 col-md-7 col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-md-5">


                @* =================================================
                   HEADER
                   ================================================= *@

                <div class="text-center mb-4">

                    <h2 class="fw-bold">
                        Quên mật khẩu
                    </h2>

                    <p class="text-secondary mb-0">

                        Nhập email đã đăng ký.

                        Hệ thống sẽ gửi mã OTP
                        để đặt lại mật khẩu.

                    </p>

                </div>


                @* =================================================
                   FORGOT PASSWORD FORM
                   ================================================= *@

                <EditForm Model="@forgotPasswordRequest"
                          OnValidSubmit="HandleForgotPassword">

                    <DataAnnotationsValidator />


                    @* =================================================
                       EMAIL
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="forgotPasswordRequest.Email"
                                   placeholder="Nhập email đã đăng ký" />

                        <ValidationMessage
                            For="@(() => forgotPasswordRequest.Email)"
                            class="text-danger" />

                    </div>


                    @* =================================================
                       ERROR MESSAGE
                       ================================================= *@

                    @if (!string.IsNullOrWhiteSpace(
                        _userStateService.ErrorMessage))
                    {
                        <div class="alert alert-danger">

                            @_userStateService.ErrorMessage

                        </div>
                    }


                    @* =================================================
                       SUBMIT BUTTON
                       ================================================= *@

                    <div class="d-grid mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span>

                                    <span class="spinner-border
                                                 spinner-border-sm
                                                 me-1">
                                    </span>

                                    Đang gửi OTP...

                                </span>
                            }
                            else
                            {
                                <span>
                                    Gửi mã OTP
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>


                @* =================================================
                   LOGIN LINK
                   ================================================= *@

                <div class="text-center mt-4">

                    <span class="text-secondary">
                        Đã nhớ mật khẩu?
                    </span>

                    <a href="/login"
                       class="text-decoration-none ms-1">

                        Đăng nhập

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    // =====================================================
    // FORGOT PASSWORD MODEL
    // =====================================================

    private ForgotPasswordRequestDTO forgotPasswordRequest =
        new();


    // =====================================================
    // SUBMIT STATE
    // =====================================================

    private bool isSubmitting;


    // =====================================================
    // HANDLE FORGOT PASSWORD
    // =====================================================

    private async Task HandleForgotPassword()
    {
        // =================================================
        // CHẶN DOUBLE SUBMIT
        // =================================================

        if (isSubmitting)
        {
            return;
        }


        isSubmitting = true;


        try
        {
            // =================================================
            // CALL FORGOT PASSWORD API
            // =================================================

            var success =
                await _userStateService
                    .ForgotPasswordAsync(
                        forgotPasswordRequest
                    );


            // =================================================
            // FAILED
            // =================================================

            if (!success)
            {
                return;
            }

            await _localStorageService.SetItemAsync(
                "resetPasswordEmail",
                forgotPasswordRequest.Email.Trim()
            );


            // =================================================
            // NAVIGATE TO RESET PASSWORD
            // =================================================

            _navigationManager.NavigateTo(
                "/reset-password"
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }

}