@page "/reset-password"

@layout HomePageMaster

@inject UserStateService _userStateService
@inject ILocalStorageService _localStorageService
@inject NavigationManager _navigationManager


<PageTitle>Đặt lại mật khẩu</PageTitle>


@* =====================================================
   RESET PASSWORD PAGE
   ===================================================== *@

<div class="row justify-content-center">

    <div class="col-12 col-md-7 col-lg-5">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-md-5">


                @* =================================================
                   HEADER
                   ================================================= *@

                <div class="text-center mb-4">

                    <h2 class="fw-bold">
                        Đặt lại mật khẩu
                    </h2>

                    <p class="text-secondary mb-0">

                        Nhập mã OTP đã được gửi đến email
                        và tạo mật khẩu mới.

                    </p>

                </div>


                @* =================================================
                   LOADING
                   ================================================= *@

                @if (isLoading)
                {
                    <div class="text-center py-4">

                        <div class="spinner-border text-primary"
                             role="status">
                        </div>

                        <div class="text-secondary mt-2">
                            Đang tải...
                        </div>

                    </div>
                }
                else
                {
                    @* =============================================
                       RESET PASSWORD FORM
                       ============================================= *@

                    <EditForm Model="@resetPasswordRequest"
                              OnValidSubmit="HandleResetPassword">

                        <DataAnnotationsValidator />


                        @* =============================================
                           EMAIL
                           ============================================= *@

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="resetPasswordRequest.Email"
                                       disabled />

                            <div class="form-text">

                                Mã OTP đã được gửi đến email này.

                            </div>

                        </div>


                        @* =============================================
                           OTP
                           ============================================= *@

                        <div class="mb-3">

                            <label class="form-label">
                                Mã OTP
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="resetPasswordRequest.Otp"
                                       placeholder="Nhập mã OTP gồm 6 chữ số"
                                       maxlength="6" />

                            <ValidationMessage
                                For="@(() => resetPasswordRequest.Otp)"
                                class="text-danger" />

                        </div>


                        @* =============================================
                           NEW PASSWORD
                           ============================================= *@

                        <div class="mb-3">

                            <label class="form-label">
                                Mật khẩu mới
                            </label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="resetPasswordRequest.NewPassword"
                                       placeholder="Nhập mật khẩu mới" />

                            <ValidationMessage
                                For="@(() => resetPasswordRequest.NewPassword)"
                                class="text-danger" />

                        </div>


                        @* =============================================
                           CONFIRM PASSWORD
                           ============================================= *@

                        <div class="mb-3">

                            <label class="form-label">
                                Xác nhận mật khẩu mới
                            </label>

                            <InputText class="form-control"
                                       type="password"
                                       @bind-Value="resetPasswordRequest.ConfirmPassword"
                                       placeholder="Nhập lại mật khẩu mới" />

                            <ValidationMessage
                                For="@(() => resetPasswordRequest.ConfirmPassword)"
                                class="text-danger" />

                        </div>


                        @* =============================================
                           ERROR MESSAGE
                           ============================================= *@

                        @if (!string.IsNullOrWhiteSpace(
                            _userStateService.ErrorMessage))
                        {
                            <div class="alert alert-danger">

                                @_userStateService.ErrorMessage

                            </div>
                        }


                        @* =============================================
                           SUBMIT
                           ============================================= *@

                        <div class="d-grid mt-4">

                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@isSubmitting">

                                @if (isSubmitting)
                                {
                                    <span>

                                        <span class="spinner-border
                                                     spinner-border-sm
                                                     me-1">
                                        </span>

                                        Đang đặt lại mật khẩu...

                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Đặt lại mật khẩu
                                    </span>
                                }

                            </button>

                        </div>

                    </EditForm>


                    @* =============================================
                       BACK TO FORGOT PASSWORD
                       ============================================= *@

                    <div class="text-center mt-4">

                        <span class="text-secondary">
                            Không nhận được mã OTP?
                        </span>

                        <a href="/forgot-password"
                           class="text-decoration-none ms-1">

                            Gửi lại

                        </a>

                    </div>


                    @* =============================================
                       BACK TO LOGIN
                       ============================================= *@

                    <div class="text-center mt-2">

                        <a href="/login"
                           class="text-decoration-none">

                            Quay lại đăng nhập

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


@code {

    // =====================================================
    // RESET PASSWORD MODEL
    // =====================================================

    private ResetPasswordRequestDTO resetPasswordRequest =
        new();


    // =====================================================
    // STATE
    // =====================================================

    private bool isLoading = true;

    private bool isSubmitting;


    // =====================================================
    // LOAD EMAIL FROM LOCAL STORAGE
    //
    // ForgotPassword.razor đã lưu:
    //
    // resetPasswordEmail
    //
    // Trang này lấy Email đó và đưa vào
    // ResetPasswordRequestDTO.
    // =====================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        // =================================================
        // READ EMAIL
        // =================================================

        var email =
            await _localStorageService
                .GetItemAsync<string>(
                    "resetPasswordEmail"
                );


        // =================================================
        // KHÔNG CÓ EMAIL
        //
        // User truy cập /reset-password trực tiếp
        // mà chưa đi qua Forgot Password.
        // =================================================

        if (string.IsNullOrWhiteSpace(email))
        {
            _navigationManager.NavigateTo(
                "/forgot-password"
            );

            return;
        }


        // =================================================
        // SET EMAIL VÀO DTO
        // =================================================

        resetPasswordRequest.Email =
            email;


        // =================================================
        // FINISH LOADING
        // =================================================

        isLoading = false;

        StateHasChanged();
    }


    // =====================================================
    // HANDLE RESET PASSWORD
    // =====================================================

    private async Task HandleResetPassword()
    {
        // =================================================
        // CHẶN DOUBLE SUBMIT
        // =================================================

        if (isSubmitting)
        {
            return;
        }


        isSubmitting = true;


        try
        {
            // =================================================
            // CALL RESET PASSWORD API
            // =================================================

            var success =
                await _userStateService
                    .ResetPasswordAsync(
                        resetPasswordRequest
                    );


            // =================================================
            // FAILED
            // =================================================

            if (!success)
            {
                return;
            }


            // =================================================
            // SUCCESS
            //
            // Không cần giữ Email reset nữa.
            // =================================================

            await _localStorageService
                .RemoveItemAsync(
                    "resetPasswordEmail"
                );


            // =================================================
            // REDIRECT LOGIN
            // =================================================

            _navigationManager.NavigateTo(
                "/login"
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }

}