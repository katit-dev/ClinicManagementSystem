@page "/reset-password"

@layout LandingPageMaster

@using ClinicManagementSystem.Application.DTOs.Auth

@inject UserStateService _userStateService
@inject ILocalStorageService _localStorageService
@inject NavigationManager _navigationManager

<PageTitle>Đặt lại mật khẩu</PageTitle>


@* =====================================================
   RESET PASSWORD PAGE
   ===================================================== *@

<section class="auth-page">

    @* =================================================
       BACKGROUND OVERLAY
       ================================================= *@

    <div class="auth-overlay"></div>


    @* =================================================
       AUTH SHELL
       ================================================= *@

    <div class="auth-shell">

        @* =================================================
           BRAND PANEL
           ================================================= *@

        <div class="auth-brand-panel">

            <div class="auth-brand">
                Clinic Management System
            </div>

            <h1 class="auth-brand-title">
                Tạo lại mật khẩu
                <span>an toàn hơn</span>
            </h1>

            <p class="auth-brand-description">
                Sử dụng mã OTP đã được gửi đến email
                để xác minh tài khoản và thiết lập mật khẩu mới.
            </p>


            @* =================================================
               BENEFITS
               ================================================= *@

            <div class="auth-benefits">

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-envelope-open-text"></i>
                    </div>

                    <span>
                        Xác minh bằng mã OTP
                    </span>

                </div>

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>

                    <span>
                        Bảo vệ tài khoản của bạn
                    </span>

                </div>

                <div class="auth-benefit">

                    <div class="auth-benefit-icon">
                        <i class="fas fa-lock"></i>
                    </div>

                    <span>
                        Thiết lập mật khẩu mới
                    </span>

                </div>

            </div>

        </div>


        @* =================================================
           FORM PANEL
           ================================================= *@

        <div class="auth-form-panel">

            @if (isLoading)
            {
                @* =================================================
                   LOADING
                   ================================================= *@

                <div class="auth-loading">

                    <span class="spinner-border text-info" role="status">
                    </span>

                    <div class="mt-3">
                        Đang tải...
                    </div>

                </div>
            }
            else
            {
                @* =================================================
                   FORM HEADER
                   ================================================= *@

                <div class="auth-form-header">

                    <div class="auth-form-icon">
                        <i class="fas fa-lock"></i>
                    </div>

                    <h2 class="auth-form-title">
                        Đặt lại mật khẩu
                    </h2>

                    <p class="auth-form-description">
                        Nhập mã OTP đã được gửi đến email
                        và tạo mật khẩu mới cho tài khoản.
                    </p>

                </div>


                @* =================================================
                   RESET PASSWORD FORM
                   ================================================= *@

                <EditForm Model="@resetPasswordRequest" OnValidSubmit="HandleResetPassword">

                    <DataAnnotationsValidator />


                    @* =================================================
                       EMAIL
                       ================================================= *@

                    <div class="auth-field">

                        <label class="auth-label">
                            Email
                        </label>

                        <div class="auth-input-group">

                            <span class="auth-input-icon">
                                <i class="fas fa-envelope"></i>
                            </span>

                            <InputText class="auth-input" @bind-Value="resetPasswordRequest.Email" disabled />

                        </div>

                        <div class="auth-helper auth-email-helper">

                            <span>
                                Mã OTP đã được gửi đến email này.
                            </span>

                            <button type="button" class="auth-change-email" @onclick="HandleChangeEmail">
                                Đổi email
                            </button>

                        </div>

                    </div>


                    @* =================================================
                       OTP
                       ================================================= *@

                    <div class="auth-field">

                        <label class="auth-label">
                            Mã OTP
                        </label>

                        <div class="auth-input-group">

                            <span class="auth-input-icon">
                                <i class="fas fa-shield-alt"></i>
                            </span>

                            <InputText class="auth-input" @bind-Value="resetPasswordRequest.Otp"
                                       placeholder="Nhập mã OTP gồm 6 chữ số" maxlength="6" autocomplete="one-time-code" />

                        </div>

                        <ValidationMessage For="@(() => resetPasswordRequest.Otp)" class="auth-validation" />

                    </div>


                    @* =================================================
                       NEW PASSWORD
                       ================================================= *@

                    <div class="auth-field">

                        <label class="auth-label">
                            Mật khẩu mới
                        </label>

                        <div class="auth-input-group">

                            <span class="auth-input-icon">
                                <i class="fas fa-key"></i>
                            </span>

                            <InputText class="auth-input" type="password" @bind-Value="resetPasswordRequest.NewPassword"
                                       placeholder="Nhập mật khẩu mới" autocomplete="new-password" />

                        </div>

                        <ValidationMessage For="@(() => resetPasswordRequest.NewPassword)" class="auth-validation" />

                    </div>


                    @* =================================================
                       CONFIRM PASSWORD
                       ================================================= *@

                    <div class="auth-field">

                        <label class="auth-label">
                            Xác nhận mật khẩu mới
                        </label>

                        <div class="auth-input-group">

                            <span class="auth-input-icon">
                                <i class="fas fa-lock"></i>
                            </span>

                            <InputText class="auth-input" type="password" @bind-Value="resetPasswordRequest.ConfirmPassword"
                                       placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />

                        </div>

                        <ValidationMessage For="@(() => resetPasswordRequest.ConfirmPassword)" class="auth-validation" />

                    </div>


                    @* =================================================
                       ERROR MESSAGE
                       ================================================= *@

                    @if (!string.IsNullOrWhiteSpace(
                        _userStateService.ErrorMessage))
                    {
                        <div class="auth-alert auth-alert-danger">

                            <i class="fas fa-exclamation-circle me-1"></i>

                            @_userStateService.ErrorMessage

                        </div>
                    }


                    @* =================================================
                       SUBMIT
                       ================================================= *@

                    <button type="submit" class="auth-submit" disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status">
                            </span>

                            <span>
                                Đang đặt lại mật khẩu...
                            </span>
                        }
                        else
                        {
                            <i class="fas fa-key"></i>

                            <span>
                                Đặt lại mật khẩu
                            </span>
                        }

                    </button>

                </EditForm>


                @* =================================================
                   RESEND OTP
                   ================================================= *@

                <div class="auth-divider">
                    hoặc
                </div>

                <div class="auth-footer">

                    <span>
                        Không nhận được mã OTP?
                    </span>

                    <a href="/forgot-password" class="auth-link">
                        Gửi lại
                    </a>

                </div>


                @* =================================================
                   LOGIN
                   ================================================= *@

                <div class="auth-footer mt-3">

                    <a href="/login" class="auth-link">

                        <i class="fas fa-arrow-left me-1"></i>

                        Quay lại đăng nhập

                    </a>

                </div>
            }

        </div>

    </div>

</section>


@code {

    // =====================================================
    // RESET PASSWORD MODEL
    // =====================================================

    private ResetPasswordRequestDTO resetPasswordRequest = new();


    // =====================================================
    // STATE
    // =====================================================

    private bool isLoading = true;
    private bool isSubmitting;


    // =====================================================
    // LOAD EMAIL FROM LOCAL STORAGE
    // =====================================================

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }


        // =================================================
        // READ EMAIL
        // =================================================

        var email =
            await _localStorageService
                .GetItemAsync<string>(
                    "resetPasswordEmail"
                );


        // =================================================
        // DIRECT ACCESS WITHOUT EMAIL
        // =================================================

        if (string.IsNullOrWhiteSpace(email))
        {
            _navigationManager.NavigateTo(
                "/forgot-password"
            );

            return;
        }


        // =================================================
        // SET EMAIL
        // =================================================

        resetPasswordRequest.Email =
            email;


        // =================================================
        // FINISH LOADING
        // =================================================

        isLoading = false;

        StateHasChanged();
    }


    // =====================================================
    // HANDLE RESET PASSWORD
    // =====================================================

    private async Task HandleResetPassword()
    {
        // =================================================
        // PREVENT DOUBLE SUBMIT
        // =================================================

        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            // =================================================
            // CALL RESET PASSWORD API
            // =================================================

            var success =
                await _userStateService
                    .ResetPasswordAsync(
                        resetPasswordRequest
                    );


            // =================================================
            // FAILED
            // =================================================

            if (!success)
            {
                return;
            }


            // =================================================
            // REMOVE STORED EMAIL
            // =================================================

            await _localStorageService
                .RemoveItemAsync(
                    "resetPasswordEmail"
                );


            // =================================================
            // REDIRECT LOGIN
            // =================================================

            _navigationManager.NavigateTo(
                "/login"
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // =====================================================
    // CHANGE EMAIL
    // =====================================================

    private async Task HandleChangeEmail()
    {
        await _localStorageService.RemoveItemAsync(
            "resetPasswordEmail"
        );

        _navigationManager.NavigateTo(
            "/forgot-password"
        );
    }
}