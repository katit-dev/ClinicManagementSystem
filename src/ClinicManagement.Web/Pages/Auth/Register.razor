@page "/register"

@layout HomePageMaster

@inject UserStateService _userStateService
@inject PatientStateService _patientStateService
@inject NavigationManager _navigationManager


<PageTitle>Đăng ký</PageTitle>


@* =====================================================
   REGISTER PAGE
   ===================================================== *@

<div class="row justify-content-center">

    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-md-5">


                @* =================================================
                   TITLE
                   ================================================= *@

                <div class="text-center mb-4">

                    <h2 class="fw-bold">
                        Đăng ký tài khoản
                    </h2>

                    <p class="text-secondary mb-0">
                        Tạo tài khoản bệnh nhân
                    </p>

                </div>


                @* =================================================
                   REGISTER FORM
                   ================================================= *@

                <EditForm Model="@registerRequest" OnValidSubmit="HandleRegister">

                    <DataAnnotationsValidator />


                    @* =============================================
                       FULL NAME
                       ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Họ và tên
                        </label>

                        <InputText class="form-control" @bind-Value="registerRequest.FullName"
                                   placeholder="Nhập họ và tên" />

                        <ValidationMessage For="@(() => registerRequest.FullName)" />

                    </div>


                    @* =============================================
                    PHONE
                    ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Số điện thoại
                        </label>


                        <div class="input-group">

                            <InputText class="form-control" @bind-Value="registerRequest.Phone"
                                       placeholder="Ví dụ: 0901234567" />


                            <button type="button" class="btn btn-outline-primary" @onclick="HandleLookupPhone"
                                    disabled="@isCheckingPhone">

                                @if (isCheckingPhone)
                                {
                                    <span>
                                        Đang kiểm tra...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Kiểm tra hồ sơ
                                    </span>
                                }

                            </button>

                        </div>


                        <ValidationMessage For="@(() => registerRequest.Phone)" />

                    </div>


                    @* =============================================
                       EMAIL
                       ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <InputText class="form-control" type="email" @bind-Value="registerRequest.Email"
                                   placeholder="Nhập email" />

                        <ValidationMessage For="@(() => registerRequest.Email)" />

                    </div>

                    @* =============================================
                    PATIENT LOOKUP RESULT
                    ============================================= *@

                    @if (hasCheckedPhone)
                    {
                        if (patientFound &&
                            _patientStateService.LookupPatient != null)
                        {
                            <div class="alert alert-success">

                                <div class="fw-semibold mb-2">
                                    Đã tìm thấy hồ sơ bệnh nhân.
                                </div>

                                <div>
                                    Họ tên:
                                    <strong>
                                        @_patientStateService.LookupPatient.FullName
                                    </strong>
                                </div>

                                <div>
                                    Ngày sinh:

                                    <strong>
                                        @(_patientStateService.LookupPatient.DateOfBirth?
                                            .ToString("dd/MM/yyyy")
                                            ?? "Chưa cập nhật")
                                    </strong>
                                </div>

                                <div class="mt-2 small">

                                    Tài khoản mới sẽ được liên kết
                                    với hồ sơ bệnh nhân hiện có.

                                </div>

                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(
                            _patientStateService.ErrorMessage))
                        {
                            <div class="alert alert-danger">

                                @_patientStateService.ErrorMessage

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">

                                Không tìm thấy hồ sơ bệnh nhân cũ.

                                Bạn có thể tiếp tục đăng ký.
                                Hệ thống sẽ tạo hồ sơ bệnh nhân mới.

                            </div>
                        }
                    }

                    @* =============================================
                       DATE OF BIRTH
                       ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Ngày sinh
                        </label>

                        <InputDate TValue="DateTime?" class="form-control" @bind-Value="registerRequest.DateOfBirth" />

                        <ValidationMessage For="@(() => registerRequest.DateOfBirth)" />

                    </div>


                    @* =============================================
                       PASSWORD
                       ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Mật khẩu
                        </label>

                        <InputText class="form-control" type="password" @bind-Value="registerRequest.Password"
                                   placeholder="Nhập mật khẩu" />

                        <ValidationMessage For="@(() => registerRequest.Password)" />

                    </div>


                    @* =============================================
                       CONFIRM PASSWORD
                       ============================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Xác nhận mật khẩu
                        </label>

                        <InputText class="form-control" type="password" @bind-Value="registerRequest.ConfirmPassword"
                                   placeholder="Nhập lại mật khẩu" />

                        <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" />

                    </div>


                    @* =============================================
                       BACKEND ERROR
                       ============================================= *@

                    @if (!string.IsNullOrWhiteSpace(
                        _userStateService.ErrorMessage))
                    {
                        <div class="alert alert-danger">

                            @_userStateService.ErrorMessage

                        </div>
                    }


                    @* =============================================
                       SUBMIT
                       ============================================= *@

                    <div class="d-grid mt-4">

                        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span>
                                    Đang đăng ký...
                                </span>
                            }
                            else
                            {
                                <span>
                                    Đăng ký
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>


                @* =================================================
                   LOGIN LINK
                   ================================================= *@

                <div class="text-center mt-4">

                    <span class="text-secondary">
                        Đã có tài khoản?
                    </span>

                    <a href="/login" class="text-decoration-none ms-1">

                        Đăng nhập

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    // =====================================================
    // REGISTER MODEL
    // =====================================================

    private UserRegisterDTO registerRequest = new();


    // =====================================================
    // STATE
    // =====================================================


    private bool isCheckingPhone;

    private bool hasCheckedPhone;

    private bool patientFound;

    private string checkedPhone = string.Empty; private bool isSubmitting;

    // =====================================================
    // LOOKUP PATIENT BY PHONE
    // =====================================================

    private async Task HandleLookupPhone()
    {
        var phone =
            registerRequest.Phone?.Trim()
            ?? string.Empty;


        // =================================================
        // KIỂM TRA SỐ ĐIỆN THOẠI CƠ BẢN
        // =================================================

        if (phone.Length != 10 ||
            !phone.StartsWith("0") ||
            !phone.All(char.IsDigit))
        {
            hasCheckedPhone = false;
            patientFound = false;
            checkedPhone = string.Empty;

            return;
        }


        isCheckingPhone = true;

        hasCheckedPhone = false;
        patientFound = false;


        try
        {
            patientFound =
                await _patientStateService
                    .LookupByPhoneAsync(phone);


            checkedPhone = phone;

            hasCheckedPhone = true;
        }
        finally
        {
            isCheckingPhone = false;
        }
    }

    // =====================================================
    // HANDLE REGISTER
    // =====================================================

    private async Task HandleRegister()
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;

        try
        {
            var success =
                await _userStateService.RegisterAsync(
                    registerRequest
                );


            if (success)
            {
                _navigationManager.NavigateTo("/login");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

}