@page "/register"

@layout HomePageMaster

@using System.ComponentModel.DataAnnotations
@using ClinicManagementSystem.Application.DTOs.Auth
@using ClinicManagementSystem.Application.DTOs.Patient

@inject UserStateService _userStateService
@inject PatientStateService _patientStateService
@inject NavigationManager _navigationManager


<PageTitle>Đăng ký tài khoản</PageTitle>


@* =====================================================
   REGISTER PAGE
   ===================================================== *@

<div class="row justify-content-center">

    <div class="col-12 col-md-9 col-lg-7">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4 p-md-5">


                @* =================================================
                   HEADER
                   ================================================= *@

                <div class="text-center mb-4">

                    <h2 class="fw-bold">
                        Đăng ký tài khoản bệnh nhân
                    </h2>

                    <p class="text-secondary mb-0">
                        Bệnh nhân tự tạo tài khoản.
                        Nếu đã từng khám, hệ thống sẽ liên kết
                        tài khoản với hồ sơ bệnh nhân hiện có.
                    </p>

                </div>


                @* =================================================
                   REGISTER FORM
                   ================================================= *@

                <EditForm Model="@registerRequest"
                          OnValidSubmit="HandleRegister">

                    <DataAnnotationsValidator />


                    @* =================================================
                       FULL NAME
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Họ và tên
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="registerRequest.FullName"
                                   placeholder="Nhập họ và tên" />

                        <ValidationMessage
                            For="@(() => registerRequest.FullName)" />

                    </div>


                    @* =================================================
                       PHONE
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Số điện thoại
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="registerRequest.Phone"
                                   @onblur="HandlePhoneBlur"
                                   placeholder="Ví dụ: 0901234567" />

                        <ValidationMessage
                            For="@(() => registerRequest.Phone)" />


                        @if (isCheckingPhone)
                        {
                            <div class="text-secondary small mt-2">

                                <span class="spinner-border
                                             spinner-border-sm
                                             me-1">
                                </span>

                                Đang kiểm tra hồ sơ bệnh nhân...

                            </div>
                        }

                    </div>


                    @* =================================================
                       PATIENT LOOKUP ERROR
                       ================================================= *@

                    @if (hasLookupError &&
                         !string.IsNullOrWhiteSpace(
                             _patientStateService.ErrorMessage))
                    {
                        <div class="alert alert-danger">

                            @_patientStateService.ErrorMessage

                        </div>
                    }


                    @* =================================================
                       PATIENT LOOKUP RESULT
                       ================================================= *@

                    @if (hasCheckedPhone)
                    {
                        var patient =
                            _patientStateService.LookupPatient;


                        @* =============================================
                           CASE 1:
                           CHƯA CÓ HỒ SƠ PATIENT
                           ============================================= *@

                        if (patient == null)
                        {
                            <div class="alert alert-info">

                                <div class="fw-semibold mb-1">
                                    Chưa tìm thấy hồ sơ bệnh nhân.
                                </div>

                                <div>
                                    Bạn có thể tiếp tục đăng ký.
                                    Hệ thống sẽ tạo hồ sơ bệnh nhân mới.
                                </div>

                            </div>
                        }


                        @* =============================================
                           CASE 2:
                           PATIENT ĐÃ CÓ ACCOUNT
                           ============================================= *@

                        else if (patient.HasAccount)
                        {
                            <div class="alert alert-warning">

                                <div class="fw-semibold mb-1">
                                    Hồ sơ bệnh nhân này đã có tài khoản.
                                </div>

                                <div class="mb-2">
                                    Vui lòng đăng nhập hoặc sử dụng
                                    chức năng quên mật khẩu.
                                </div>

                                <a href="/login"
                                   class="alert-link me-3">
                                    Đăng nhập
                                </a>

                                <a href="/forgot-password"
                                   class="alert-link">
                                    Quên mật khẩu
                                </a>

                            </div>
                        }


                        @* =============================================
                           CASE 3:
                           PATIENT VÃNG LAI - CHƯA CÓ ACCOUNT
                           ============================================= *@

                        else
                        {
                            <div class="alert alert-success">

                                <div class="fw-semibold mb-2">

                                    Đã tìm thấy hồ sơ bệnh nhân.

                                </div>


                                <div>

                                    Họ tên:

                                    <strong>
                                        @patient.FullName
                                    </strong>

                                </div>


                                <div>

                                    Ngày sinh:

                                    <strong>

                                        @(patient.DateOfBirth.HasValue
                                            ? patient.DateOfBirth.Value
                                                .ToString("dd/MM/yyyy")
                                            : "Chưa cập nhật")

                                    </strong>

                                </div>


                                <div class="mt-2">

                                    Tài khoản mới sẽ được liên kết
                                    với hồ sơ bệnh nhân hiện có.

                                </div>

                            </div>
                        }
                    }


                    @* =================================================
                       EMAIL
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <InputText class="form-control"
                                   type="email"
                                   @bind-Value="registerRequest.Email"
                                   placeholder="Nhập email" />

                        <ValidationMessage
                            For="@(() => registerRequest.Email)" />

                    </div>


                    @* =================================================
                       DATE OF BIRTH
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Ngày sinh
                        </label>

                        <InputDate TValue="DateTime?"
                                   class="form-control"
                                   @bind-Value="registerRequest.DateOfBirth" />

                        <ValidationMessage
                            For="@(() => registerRequest.DateOfBirth)" />

                    </div>


                    @* =================================================
                       PASSWORD
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Mật khẩu
                        </label>

                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="registerRequest.Password"
                                   placeholder="Nhập mật khẩu" />

                        <ValidationMessage
                            For="@(() => registerRequest.Password)" />

                    </div>


                    @* =================================================
                       CONFIRM PASSWORD
                       ================================================= *@

                    <div class="mb-3">

                        <label class="form-label">
                            Xác nhận mật khẩu
                        </label>

                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="registerRequest.ConfirmPassword"
                                   placeholder="Nhập lại mật khẩu" />

                        <ValidationMessage
                            For="@(() => registerRequest.ConfirmPassword)" />

                    </div>


                    @* =================================================
                       REGISTER ERROR
                       ================================================= *@

                    @if (registerAttempted &&
                         !string.IsNullOrWhiteSpace(
                             _userStateService.ErrorMessage))
                    {
                        <div class="alert alert-danger">

                            @_userStateService.ErrorMessage

                        </div>
                    }


                    @* =================================================
                       SUBMIT
                       ================================================= *@

                    <div class="d-grid mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@IsRegisterDisabled">

                            @if (isSubmitting)
                            {
                                <span>

                                    <span class="spinner-border
                                                 spinner-border-sm
                                                 me-1">
                                    </span>

                                    Đang đăng ký...

                                </span>
                            }
                            else
                            {
                                <span>
                                    Đăng ký
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>


                @* =================================================
                   LOGIN LINK
                   ================================================= *@

                <div class="text-center mt-4">

                    <span class="text-secondary">
                        Đã có tài khoản?
                    </span>

                    <a href="/login"
                       class="text-decoration-none ms-1">

                        Đăng nhập

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    // =====================================================
    // REGISTER MODEL
    // =====================================================

    private UserRegisterDTO registerRequest = new();


    // =====================================================
    // LOOKUP STATE
    // =====================================================

    private bool isCheckingPhone;

    private bool hasCheckedPhone;

    private bool hasLookupError;

    private string checkedPhone = string.Empty;


    // =====================================================
    // REGISTER STATE
    // =====================================================

    private bool isSubmitting;

    private bool registerAttempted;


    // =====================================================
    // DISABLE REGISTER BUTTON
    //
    // Không cho submit khi:
    // - đang register
    // - đang lookup
    // - Patient đã có account
    // =====================================================

    private bool IsRegisterDisabled =>
        isSubmitting ||
        isCheckingPhone ||
        (
            hasCheckedPhone &&
            _patientStateService.LookupPatient?.HasAccount == true
        );


    // =====================================================
    // PHONE BLUR
    //
    // Khi user nhập xong SĐT và rời khỏi input:
    //
    // 1. Validate bằng PatientLookupRequestDTO
    // 2. Nếu hợp lệ mới gọi API lookup
    // =====================================================

    private async Task HandlePhoneBlur()
    {
        var phone =
            registerRequest.Phone.Trim();


        // =================================================
        // TẠO LOOKUP REQUEST
        // =================================================

        var lookupRequest =
            new PatientLookupRequestDTO
            {
                Phone = phone
            };


        // =================================================
        // VALIDATE BẰNG DATA ANNOTATION TRONG DTO
        //
        // Không viết lại Regex ở frontend
        // =================================================

        var validationResults =
            new List<ValidationResult>();

        var validationContext =
            new ValidationContext(lookupRequest);


        var isValid =
            Validator.TryValidateObject(
                lookupRequest,
                validationContext,
                validationResults,
                validateAllProperties: true
            );


        // =================================================
        // PHONE KHÔNG HỢP LỆ
        // =================================================

        if (!isValid)
        {
            hasCheckedPhone = false;
            hasLookupError = false;

            checkedPhone = string.Empty;

            return;
        }


        // =================================================
        // SĐT NÀY ĐÃ LOOKUP RỒI
        //
        // Không gọi API lại nếu user không đổi SĐT
        // =================================================

        if (hasCheckedPhone &&
            checkedPhone == phone)
        {
            return;
        }


        // =================================================
        // LOOKUP
        // =================================================

        isCheckingPhone = true;

        hasCheckedPhone = false;
        hasLookupError = false;


        try
        {
            var lookupSucceeded =
                await _patientStateService
                    .LookupByPhoneAsync(phone);


            // =================================================
            // API LOOKUP FAILED
            // =================================================

            if (!lookupSucceeded)
            {
                hasLookupError = true;

                return;
            }


            // =================================================
            // LOOKUP SUCCESS
            // =================================================

            checkedPhone = phone;

            hasCheckedPhone = true;


            // =================================================
            // NẾU TÌM THẤY PATIENT VÃNG LAI
            // THÌ ĐIỀN THÔNG TIN CŨ VÀO FORM
            // =================================================

            var patient =
                _patientStateService.LookupPatient;


            if (patient != null &&
                !patient.HasAccount)
            {
                registerRequest.FullName =
                    patient.FullName;


                if (patient.DateOfBirth.HasValue)
                {
                    registerRequest.DateOfBirth =
                        patient.DateOfBirth.Value
                            .ToDateTime(
                                TimeOnly.MinValue
                            );
                }
            }
        }
        finally
        {
            isCheckingPhone = false;
        }
    }


    // =====================================================
    // REGISTER
    // =====================================================

    private async Task HandleRegister()
    {
        if (isSubmitting)
        {
            return;
        }


        registerAttempted = false;


        var currentPhone =
            registerRequest.Phone.Trim();


        // =================================================
        // PHONE CHƯA LOOKUP
        // HOẶC USER ĐÃ ĐỔI PHONE SAU KHI LOOKUP
        //
        // → Lookup lại trước khi Register
        // =================================================

        if (!hasCheckedPhone ||
            checkedPhone != currentPhone)
        {
            await HandlePhoneBlur();


            // Lookup không thành công
            if (!hasCheckedPhone)
            {
                return;
            }
        }


        // =================================================
        // PATIENT ĐÃ CÓ ACCOUNT
        //
        // Không cho đăng ký account thứ hai
        // =================================================

        if (_patientStateService
                .LookupPatient?
                .HasAccount == true)
        {
            return;
        }


        // =================================================
        // CALL REGISTER API
        // =================================================

        isSubmitting = true;

        registerAttempted = true;


        try
        {
            var success =
                await _userStateService
                    .RegisterAsync(
                        registerRequest
                    );


            // =================================================
            // REGISTER SUCCESS
            // =================================================

            if (success)
            {
                _navigationManager
                    .NavigateTo("/login");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

}