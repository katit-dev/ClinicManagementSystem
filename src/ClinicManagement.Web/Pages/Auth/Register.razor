@page "/register"

@layout LandingPageMaster

@using System.ComponentModel.DataAnnotations
@using ClinicManagementSystem.Application.DTOs.Auth
@using ClinicManagementSystem.Application.DTOs.Patient

@inject UserStateService _userStateService
@inject PatientStateService _patientStateService
@inject NavigationManager _navigationManager

<PageTitle>Đăng ký tài khoản</PageTitle>


@* =====================================================
   REGISTER PAGE
   ===================================================== *@

<section class="auth-page">

    @* =================================================
       BACKGROUND OVERLAY
       ================================================= *@

    <div class="auth-overlay"></div>


    @* =================================================
       AUTH SHELL
       ================================================= *@

    <div class="auth-shell">

        @* =================================================
           BRAND PANEL
           ================================================= *@

        <div class="auth-brand-panel">

            <div class="auth-brand">
                Clinic Management System
            </div>

            <h1 class="auth-brand-title">
                Bắt đầu hành trình
                <span>chăm sóc sức khỏe</span>
            </h1>

            <p class="auth-brand-description">
                Tạo tài khoản bệnh nhân để đặt lịch,
                quản lý lịch hẹn và theo dõi thông tin
                sức khỏe thuận tiện hơn.
            </p>


            @* =================================================
               BENEFITS
               ================================================= *@

            <div class="auth-benefits">

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-calendar-plus"></i>
                    </div>

                    <span>
                        Đặt lịch khám trực tuyến
                    </span>
                </div>

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-user-check"></i>
                    </div>

                    <span>
                        Liên kết hồ sơ bệnh nhân hiện có
                    </span>
                </div>

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-file-medical-alt"></i>
                    </div>

                    <span>
                        Theo dõi lịch sử khám và hóa đơn
                    </span>
                </div>

            </div>

        </div>


        @* =================================================
           REGISTER FORM PANEL
           ================================================= *@

        <div class="auth-form-panel">

            @* =================================================
               FORM HEADER
               ================================================= *@

            <div class="auth-form-header">

                <div class="auth-form-icon">
                    <i class="fas fa-user-plus"></i>
                </div>

                <h2 class="auth-form-title">
                    Đăng ký tài khoản
                </h2>

                <p class="auth-form-description">
                    Dành cho bệnh nhân đăng ký tài khoản mới.
                    Nếu đã từng khám, hệ thống sẽ tự động kiểm tra
                    và liên kết hồ sơ hiện có.
                </p>

            </div>


            @* =================================================
               REGISTER FORM
               ================================================= *@

            <EditForm Model="@registerRequest"
                      OnValidSubmit="HandleRegister">

                <DataAnnotationsValidator />


                @* =================================================
                   FULL NAME
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Họ và tên
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-user"></i>
                        </span>

                        <InputText class="auth-input"
                                   @bind-Value="registerRequest.FullName"
                                   placeholder="Nhập họ và tên"
                                   autocomplete="name" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.FullName)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   PHONE
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Số điện thoại
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-phone-alt"></i>
                        </span>

                        <InputText class="auth-input"
                                   @bind-Value="registerRequest.Phone"
                                   @onblur="HandlePhoneBlur"
                                   placeholder="Ví dụ: 0901234567"
                                   autocomplete="tel" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.Phone)"
                        class="auth-validation" />

                    @if (isCheckingPhone)
                    {
                        <div class="auth-helper">

                            <span class="spinner-border spinner-border-sm me-1">
                            </span>

                            Đang kiểm tra hồ sơ bệnh nhân...

                        </div>
                    }

                </div>


                @* =================================================
                   PATIENT LOOKUP ERROR
                   ================================================= *@

                @if (hasLookupError &&
                     !string.IsNullOrWhiteSpace(
                         _patientStateService.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-danger">

                        <i class="fas fa-exclamation-circle me-1"></i>

                        @_patientStateService.ErrorMessage

                    </div>
                }


                @* =================================================
                   PATIENT LOOKUP RESULT
                   ================================================= *@

                @if (hasCheckedPhone)
                {
                    var patient =
                        _patientStateService.LookupPatient;


                    @* =============================================
                       CASE 1 - PATIENT DOES NOT EXIST
                       ============================================= *@

                    if (patient == null)
                    {
                        <div class="auth-alert auth-alert-info">

                            <div class="fw-semibold mb-1">
                                <i class="fas fa-info-circle me-1"></i>
                                Chưa tìm thấy hồ sơ bệnh nhân
                            </div>

                            <div>
                                Bạn có thể tiếp tục đăng ký.
                                Hệ thống sẽ tạo hồ sơ bệnh nhân mới.
                            </div>

                        </div>
                    }


                    @* =============================================
                       CASE 2 - PATIENT ALREADY HAS ACCOUNT
                       ============================================= *@

                    else if (patient.HasAccount)
                    {
                        <div class="auth-alert auth-alert-warning">

                            <div class="fw-semibold mb-1">
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                Hồ sơ này đã có tài khoản
                            </div>

                            <div class="mb-2">
                                Vui lòng đăng nhập hoặc sử dụng
                                chức năng quên mật khẩu.
                            </div>

                            <a href="/login"
                               class="auth-link me-3">
                                Đăng nhập
                            </a>

                            <a href="/forgot-password"
                               class="auth-link">
                                Quên mật khẩu
                            </a>

                        </div>
                    }


                    @* =============================================
                       CASE 3 - EXISTING PATIENT WITHOUT ACCOUNT
                       ============================================= *@

                    else
                    {
                        <div class="auth-alert auth-alert-success">

                            <div class="fw-semibold mb-2">
                                <i class="fas fa-check-circle me-1"></i>
                                Đã tìm thấy hồ sơ bệnh nhân
                            </div>

                            <div>
                                Họ tên:
                                <strong>
                                    @patient.FullName
                                </strong>
                            </div>

                            <div>
                                Ngày sinh:
                                <strong>
                                    @(patient.DateOfBirth.HasValue
                                        ? patient.DateOfBirth.Value
                                            .ToString("dd/MM/yyyy")
                                        : "Chưa cập nhật")
                                </strong>
                            </div>

                            <div class="mt-2">
                                Tài khoản mới sẽ được liên kết
                                với hồ sơ bệnh nhân hiện có.
                            </div>

                        </div>
                    }
                }


                @* =================================================
                   EMAIL
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Email
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-envelope"></i>
                        </span>

                        <InputText class="auth-input"
                                   type="email"
                                   @bind-Value="registerRequest.Email"
                                   placeholder="Nhập email"
                                   autocomplete="email" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.Email)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   DATE OF BIRTH
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Ngày sinh
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </span>

                        <InputDate TValue="DateTime?"
                                   class="auth-input"
                                   @bind-Value="registerRequest.DateOfBirth" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.DateOfBirth)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   PASSWORD
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Mật khẩu
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-lock"></i>
                        </span>

                        <InputText class="auth-input"
                                   type="password"
                                   @bind-Value="registerRequest.Password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="new-password" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.Password)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   CONFIRM PASSWORD
                   ================================================= *@

                <div class="auth-field">

                    <label class="auth-label">
                        Xác nhận mật khẩu
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-shield-alt"></i>
                        </span>

                        <InputText class="auth-input"
                                   type="password"
                                   @bind-Value="registerRequest.ConfirmPassword"
                                   placeholder="Nhập lại mật khẩu"
                                   autocomplete="new-password" />

                    </div>

                    <ValidationMessage
                        For="@(() => registerRequest.ConfirmPassword)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   REGISTER ERROR
                   ================================================= *@

                @if (registerAttempted &&
                     !string.IsNullOrWhiteSpace(
                         _userStateService.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-danger">

                        <i class="fas fa-exclamation-circle me-1"></i>

                        @_userStateService.ErrorMessage

                    </div>
                }


                @* =================================================
                   SUBMIT
                   ================================================= *@

                <button type="submit"
                        class="auth-submit"
                        disabled="@IsRegisterDisabled">

                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>
                            Đang đăng ký...
                        </span>
                    }
                    else
                    {
                        <i class="fas fa-user-plus"></i>

                        <span>
                            Đăng ký
                        </span>
                    }

                </button>

            </EditForm>


            @* =================================================
               LOGIN
               ================================================= *@

            <div class="auth-divider">
                hoặc
            </div>

            <div class="auth-footer">

                <span>
                    Đã có tài khoản?
                </span>

                <a href="/login"
                   class="auth-link">
                    Đăng nhập
                </a>

            </div>


            @* =================================================
               HOME
               ================================================= *@

            <div class="auth-footer mt-3">

                <a href="/"
                   class="auth-link">

                    <i class="fas fa-arrow-left me-1"></i>

                    Quay lại trang chủ

                </a>

            </div>

        </div>

    </div>

</section>


@code {

    // =====================================================
    // REGISTER MODEL
    // =====================================================

    private UserRegisterDTO registerRequest = new();


    // =====================================================
    // LOOKUP STATE
    // =====================================================

    private bool isCheckingPhone;
    private bool hasCheckedPhone;
    private bool hasLookupError;
    private string checkedPhone = string.Empty;


    // =====================================================
    // REGISTER STATE
    // =====================================================

    private bool isSubmitting;
    private bool registerAttempted;


    // =====================================================
    // DISABLE REGISTER BUTTON
    // =====================================================

    private bool IsRegisterDisabled =>
        isSubmitting ||
        isCheckingPhone ||
        (
            hasCheckedPhone &&
            _patientStateService.LookupPatient?.HasAccount == true
        );


    // =====================================================
    // PHONE BLUR
    // =====================================================

    private async Task HandlePhoneBlur()
    {
        var phone =
            registerRequest.Phone.Trim();


        // =================================================
        // CREATE LOOKUP REQUEST
        // =================================================

        var lookupRequest =
            new PatientLookupRequestDTO
            {
                Phone = phone
            };


        // =================================================
        // VALIDATE WITH DTO DATA ANNOTATIONS
        // =================================================

        var validationResults =
            new List<ValidationResult>();

        var validationContext =
            new ValidationContext(lookupRequest);

        var isValid =
            Validator.TryValidateObject(
                lookupRequest,
                validationContext,
                validationResults,
                validateAllProperties: true
            );


        // =================================================
        // INVALID PHONE
        // =================================================

        if (!isValid)
        {
            hasCheckedPhone = false;
            hasLookupError = false;
            checkedPhone = string.Empty;

            return;
        }


        // =================================================
        // PHONE ALREADY CHECKED
        // =================================================

        if (hasCheckedPhone &&
            checkedPhone == phone)
        {
            return;
        }


        // =================================================
        // LOOKUP
        // =================================================

        isCheckingPhone = true;
        hasCheckedPhone = false;
        hasLookupError = false;

        try
        {
            var lookupSucceeded =
                await _patientStateService
                    .LookupByPhoneAsync(phone);


            // =================================================
            // LOOKUP FAILED
            // =================================================

            if (!lookupSucceeded)
            {
                hasLookupError = true;

                return;
            }


            // =================================================
            // LOOKUP SUCCESS
            // =================================================

            checkedPhone = phone;
            hasCheckedPhone = true;

            var patient =
                _patientStateService.LookupPatient;


            // =================================================
            // EXISTING PATIENT WITHOUT ACCOUNT
            // =================================================

            if (patient != null &&
                !patient.HasAccount)
            {
                registerRequest.FullName =
                    patient.FullName;

                if (patient.DateOfBirth.HasValue)
                {
                    registerRequest.DateOfBirth =
                        patient.DateOfBirth.Value
                            .ToDateTime(
                                TimeOnly.MinValue
                            );
                }
            }
        }
        finally
        {
            isCheckingPhone = false;
        }
    }


    // =====================================================
    // REGISTER
    // =====================================================

    private async Task HandleRegister()
    {
        if (isSubmitting)
        {
            return;
        }

        registerAttempted = false;

        var currentPhone =
            registerRequest.Phone.Trim();


        // =================================================
        // LOOKUP PHONE BEFORE REGISTER
        // =================================================

        if (!hasCheckedPhone ||
            checkedPhone != currentPhone)
        {
            await HandlePhoneBlur();

            if (!hasCheckedPhone)
            {
                return;
            }
        }


        // =================================================
        // PATIENT ALREADY HAS ACCOUNT
        // =================================================

        if (_patientStateService
                .LookupPatient?
                .HasAccount == true)
        {
            return;
        }


        // =================================================
        // CALL REGISTER API
        // =================================================

        isSubmitting = true;
        registerAttempted = true;

        try
        {
            var success =
                await _userStateService
                    .RegisterAsync(
                        registerRequest
                    );


            // =================================================
            // REGISTER SUCCESS
            // =================================================

            if (success)
            {
                _navigationManager
                    .NavigateTo("/login");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}