@page "/login"

@layout HomePageMaster


@inject UserStateService _userStateService

@implements IDisposable


@* =====================================================
   LOGIN PAGE
   ===================================================== *@

<div class="row justify-content-center py-5">

    <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                @* =================================================
                   TITLE
                   ================================================= *@

                <div class="text-center mb-4">

                    <i class="fas fa-clinic-medical fa-3x text-primary mb-3"></i>

                    <h4 class="fw-bold">
                        Đăng nhập
                    </h4>

                    <p class="text-secondary small mb-0">
                        Hệ thống quản lý phòng khám
                    </p>

                </div>


                @* =================================================
                   LOGIN FORM
                   ================================================= *@

                <EditForm Model="@loginRequest"
                          OnValidSubmit="HandleLogin">

                    @* Sử dụng Data Annotation từ LoginRequestDTO *@
                    <DataAnnotationsValidator />


                    @* =================================================
                       USERNAME
                       ================================================= *@

                    <div class="mb-3">

                        <label for="username"
                               class="form-label">

                            Tên đăng nhập hoặc Email

                        </label>


                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="fas fa-user text-secondary"></i>

                            </span>


                            <InputText id="username"
                                       class="form-control"
                                       @bind-Value="loginRequest.Username"
                                       placeholder="Nhập tên đăng nhập hoặc email" />

                        </div>


                        <ValidationMessage For="@(() => loginRequest.Username)"
                                           class="text-danger small" />

                    </div>


                    @* =================================================
                       PASSWORD
                       ================================================= *@

                    <div class="mb-3">

                        <label for="password"
                               class="form-label">

                            Mật khẩu

                        </label>


                        <div class="input-group">

                            <span class="input-group-text bg-white">

                                <i class="fas fa-lock text-secondary"></i>

                            </span>


                            <InputText id="password"
                                       type="password"
                                       class="form-control"
                                       @bind-Value="loginRequest.Password"
                                       placeholder="Nhập mật khẩu" />

                        </div>


                        <ValidationMessage For="@(() => loginRequest.Password)"
                                           class="text-danger small" />

                    </div>


                    @* =================================================
                       REMEMBER + FORGOT PASSWORD
                       ================================================= *@

                    <div class="d-flex justify-content-between
                                align-items-center mb-3 small">

                        <div class="form-check">

                            <input class="form-check-input"
                                   type="checkbox"
                                   id="remember" />

                            <label class="form-check-label"
                                   for="remember">

                                Ghi nhớ đăng nhập

                            </label>

                        </div>


                        <a href="/forgot-password"
                           class="text-primary text-decoration-none">

                            Quên mật khẩu?

                        </a>

                    </div>


                    @* =================================================
                       ERROR MESSAGE TỪ BACKEND
                       ================================================= *@

                    @if (!string.IsNullOrWhiteSpace(
                        _userStateService.ErrorMessage))
                    {
                        <div class="alert alert-danger py-2"
                             role="alert">

                            @_userStateService.ErrorMessage

                        </div>
                    }


                    @* =================================================
                       LOGIN BUTTON
                       ================================================= *@

                    <div class="d-grid mb-3">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@isSubmitting">

                            @if (isSubmitting)
                            {
                                <span class="spinner-border
                                             spinner-border-sm
                                             me-2"
                                      role="status">
                                </span>

                                <span>
                                    Đang đăng nhập...
                                </span>
                            }
                            else
                            {
                                <span>
                                    ĐĂNG NHẬP
                                </span>
                            }

                        </button>

                    </div>

                </EditForm>


                @* =================================================
                   REGISTER
                   ================================================= *@

                <hr class="my-3" />


                <p class="text-center small text-secondary mb-0">

                    Chưa có tài khoản?

                    <a href="/register"
                       class="text-primary
                              text-decoration-none
                              fw-semibold">

                        Đăng ký

                    </a>

                </p>

            </div>

        </div>

    </div>

</div>


@code {

    private LoginRequestDTO loginRequest = new();
    private bool isSubmitting;


    protected override void OnInitialized()
    {
        _userStateService.OnChange += StateHasChanged;
    }


    // =====================================================
    // HANDLE LOGIN
    // =====================================================

    private async Task HandleLogin()
    {
        try
        {
            isSubmitting = true;


            await _userStateService.LoginAsync(
                loginRequest
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }


    public void Dispose()
    {
        _userStateService.OnChange -= StateHasChanged;
    }

}