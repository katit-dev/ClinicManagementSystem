@page "/login"

@layout LandingPageMaster

@using ClinicManagementSystem.Application.DTOs.Auth

@inject UserStateService _userStateService

@implements IDisposable

<PageTitle>Đăng nhập</PageTitle>


@* =====================================================
   LOGIN PAGE
   ===================================================== *@

<section class="auth-page">

    @* =================================================
       BACKGROUND OVERLAY
       ================================================= *@

    <div class="auth-overlay"></div>


    @* =================================================
       AUTH SHELL
       ================================================= *@

    <div class="auth-shell">

        @* =================================================
           BRAND PANEL
           ================================================= *@

        <div class="auth-brand-panel">

            <div class="auth-brand">
                Clinic Management System
            </div>

            <h1 class="auth-brand-title">
                Chăm sóc sức khỏe
                <span>dễ dàng hơn</span>
            </h1>

            <p class="auth-brand-description">
                Quản lý lịch khám, theo dõi hồ sơ sức khỏe
                và kết nối với phòng khám trên một hệ thống
                thuận tiện và an toàn.
            </p>


            @* =================================================
               BENEFITS
               ================================================= *@

            <div class="auth-benefits">

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>

                    <span>
                        Đặt lịch khám nhanh chóng
                    </span>
                </div>

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-notes-medical"></i>
                    </div>

                    <span>
                        Theo dõi lịch sử khám bệnh
                    </span>
                </div>

                <div class="auth-benefit">
                    <div class="auth-benefit-icon">
                        <i class="fas fa-file-medical"></i>
                    </div>

                    <span>
                        Quản lý hồ sơ sức khỏe thuận tiện
                    </span>
                </div>

            </div>

        </div>


        @* =================================================
           LOGIN FORM PANEL
           ================================================= *@

        <div class="auth-form-panel">

            @* =================================================
               FORM HEADER
               ================================================= *@

            <div class="auth-form-header">

                <div class="auth-form-icon">
                    <i class="fas fa-user"></i>
                </div>

                <h2 class="auth-form-title">
                    Đăng nhập
                </h2>

                <p class="auth-form-description">
                    Chào mừng bạn quay trở lại.
                    Vui lòng đăng nhập để tiếp tục.
                </p>

            </div>


            @* =================================================
               LOGIN FORM
               ================================================= *@

            <EditForm Model="@loginRequest"
                      OnValidSubmit="HandleLogin">

                <DataAnnotationsValidator />


                @* =================================================
                   USERNAME
                   ================================================= *@

                <div class="auth-field">

                    <label for="username"
                           class="auth-label">
                        Tên đăng nhập hoặc Email
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-user"></i>
                        </span>

                        <InputText id="username"
                                   class="auth-input"
                                   @bind-Value="loginRequest.Username"
                                   placeholder="Nhập tên đăng nhập hoặc email"
                                   autocomplete="username" />

                    </div>

                    <ValidationMessage
                        For="@(() => loginRequest.Username)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   PASSWORD
                   ================================================= *@

                <div class="auth-field">

                    <label for="password"
                           class="auth-label">
                        Mật khẩu
                    </label>

                    <div class="auth-input-group">

                        <span class="auth-input-icon">
                            <i class="fas fa-lock"></i>
                        </span>

                        <InputText id="password"
                                   type="password"
                                   class="auth-input"
                                   @bind-Value="loginRequest.Password"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password" />

                    </div>

                    <ValidationMessage
                        For="@(() => loginRequest.Password)"
                        class="auth-validation" />

                </div>


                @* =================================================
                   OPTIONS
                   ================================================= *@

                <div class="auth-options">

                    <label class="auth-remember">
                        <input type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <a href="/forgot-password"
                       class="auth-link">
                        Quên mật khẩu?
                    </a>

                </div>


                @* =================================================
                   ERROR MESSAGE
                   ================================================= *@

                @if (!string.IsNullOrWhiteSpace(
                    _userStateService.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-danger">

                        <i class="fas fa-exclamation-circle me-1"></i>

                        @_userStateService.ErrorMessage

                    </div>
                }


                @* =================================================
                   LOGIN BUTTON
                   ================================================= *@

                <button type="submit"
                        class="auth-submit"
                        disabled="@isSubmitting">

                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"
                              role="status">
                        </span>

                        <span>
                            Đang đăng nhập...
                        </span>
                    }
                    else
                    {
                        <i class="fas fa-sign-in-alt"></i>

                        <span>
                            Đăng nhập
                        </span>
                    }

                </button>

            </EditForm>


            @* =================================================
               REGISTER
               ================================================= *@

            <div class="auth-divider">
                hoặc
            </div>

            <div class="auth-footer">

                <span>
                    Chưa có tài khoản?
                </span>

                <a href="/register"
                   class="auth-link">
                    Đăng ký ngay
                </a>

            </div>


            @* =================================================
               BACK TO LANDING PAGE
               ================================================= *@

            <div class="auth-footer mt-3">

                <a href="/"
                   class="auth-link">

                    <i class="fas fa-arrow-left me-1"></i>

                    Quay lại trang chủ

                </a>

            </div>

        </div>

    </div>

</section>


@code {

    // =====================================================
    // LOGIN MODEL
    // =====================================================

    private LoginRequestDTO loginRequest = new();


    // =====================================================
    // STATE
    // =====================================================

    private bool isSubmitting;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override void OnInitialized()
    {
        _userStateService.OnChange += StateHasChanged;
    }


    // =====================================================
    // HANDLE LOGIN
    // =====================================================

    private async Task HandleLogin()
    {
        if (isSubmitting)
        {
            return;
        }

        try
        {
            isSubmitting = true;

            await _userStateService.LoginAsync(
                loginRequest
            );
        }
        finally
        {
            isSubmitting = false;
        }
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _userStateService.OnChange -= StateHasChanged;
    }
}