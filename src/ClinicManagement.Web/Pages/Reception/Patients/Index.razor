@page "/reception/patients"

@using ClinicManagementSystem.Application.DTOs.Patient

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Receptionist")]

@layout HomePageMaster

@inject ReceptionPatientStateService PatientState

@implements IDisposable


<PageTitle>Hồ sơ bệnh nhân</PageTitle>


<div class="reception-patients-page">

    @* =====================================================
       HEADER
       ===================================================== *@
    <div class="patients-header">

        <div>
            <h1>Hồ sơ bệnh nhân</h1>
            <p>Tra cứu và quản lý hồ sơ bệnh nhân tại phòng khám.</p>
        </div>

        <button type="button" class="patients-create-button" @onclick="OpenCreateForm">

            <i class="fas fa-plus"></i>
            Tạo bệnh nhân mới

        </button>

    </div>


    @* =====================================================
       SEARCH
       ===================================================== *@

    <div class="patients-search-card">

        <form @onsubmit="HandleSearchAsync" @onsubmit:preventDefault>

            <div class="patients-search-row">

                <input type="text" class="patients-search-input"
                       placeholder="Tìm theo tên, số điện thoại hoặc mã bệnh nhân..." @bind="SearchKeyword"
                       @bind:event="oninput" />

                <button type="submit" class="patients-search-button" disabled="@PatientState.IsLoading">

                    Tìm kiếm

                </button>

                <button type="button" class="patients-reset-button" disabled="@PatientState.IsLoading"
                        @onclick="HandleResetAsync">

                    Đặt lại

                </button>

            </div>

        </form>

    </div>

    @* =====================================================
   CREATE PATIENT
   ===================================================== *@

    @if (_showCreateForm)
    {
        <div class="patient-form-card">

            <div class="patient-form-header">

                <div>
                    <h2>Tạo hồ sơ bệnh nhân</h2>
                    <p>Bệnh nhân được tạo tại quầy tiếp đón và chưa cần có tài khoản.</p>
                </div>

                <button type="button" class="patient-form-close" @onclick="CloseCreateForm">
                    ✕
                </button>

            </div>


            <EditForm Model="_createPatientRequest" OnValidSubmit="HandleCreatePatientAsync">

                <DataAnnotationsValidator />


                <div class="patient-form-grid">

                    @* =================================================
                   FULL NAME
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Họ và tên *</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.FullName" />

                        <ValidationMessage For="@(() => _createPatientRequest.FullName)" />
                    </div>


                    @* =================================================
                   PHONE
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Số điện thoại *</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.Phone" />

                        <ValidationMessage For="@(() => _createPatientRequest.Phone)" />
                    </div>


                    @* =================================================
                   GENDER
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Giới tính</label>

                        <InputSelect class="patient-form-input" @bind-Value="_createPatientRequest.Gender">

                            <option value="">-- Chọn giới tính --</option>
                            <option value="1">Nam</option>
                            <option value="0">Nữ</option>
                            <option value="2">Khác</option>

                        </InputSelect>
                    </div>


                    @* =================================================
                   DATE OF BIRTH
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Ngày sinh</label>

                        <InputDate class="patient-form-input" @bind-Value="_createPatientRequest.DateOfBirth" />
                    </div>


                    @* =================================================
                   EMAIL
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Email</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.Email" />
                    </div>


                    @* =================================================
                   NATIONAL ID
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>CCCD</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.NationalId" />
                    </div>


                    @* =================================================
                   INSURANCE
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Số BHYT</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.InsuranceNumber" />
                    </div>


                    @* =================================================
                   BLOOD TYPE
                   ================================================= *@

                    <div class="patient-form-field">
                        <label>Nhóm máu</label>

                        <InputText class="patient-form-input" @bind-Value="_createPatientRequest.BloodType" />
                    </div>


                    @* =================================================
                   ADDRESS
                   ================================================= *@

                    <div class="patient-form-field patient-form-full">
                        <label>Địa chỉ</label>

                        <InputTextArea class="patient-form-input patient-form-textarea"
                                       @bind-Value="_createPatientRequest.Address" />
                    </div>

                </div>


                @* =================================================
               ACTION MESSAGE
               ================================================= *@

                @if (!string.IsNullOrWhiteSpace(PatientState.ActionErrorMessage))
                {
                    <div class="patients-error">
                        @PatientState.ActionErrorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(PatientState.ActionMessage))
                {
                    <div class="patients-success">
                        @PatientState.ActionMessage
                    </div>
                }
                
                // message loi/thanh cong
                @if (!string.IsNullOrWhiteSpace(PatientState.ActionErrorMessage))
                {
                    <div class="patients-error">
                        @PatientState.ActionErrorMessage
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(
                        PatientState.ActionMessage))
                {
                    <div class="patients-success">
                        @PatientState.ActionMessage
                    </div>
                }

                @* =================================================
               ACTIONS
               ================================================= *@

                <div class="patient-form-actions">

                    <button type="button" class="patient-form-cancel" disabled="@PatientState.IsSubmitting"
                            @onclick="CloseCreateForm">

                        Hủy

                    </button>

                    <button type="submit" class="patient-form-save" disabled="@PatientState.IsSubmitting">

                        @if (PatientState.IsSubmitting)
                        {
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <span>Lưu bệnh nhân</span>
                        }

                    </button>

                </div>

            </EditForm>

        </div>
    }

    

    @* =====================================================
       ERROR
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(PatientState.ErrorMessage))
    {
        <div class="patients-error">
            @PatientState.ErrorMessage
        </div>
    }


    @* =====================================================
       CONTENT
       ===================================================== *@

    <div class="patients-table-card">

        <div class="patients-table-header">

            <div>
                <h2>Danh sách bệnh nhân</h2>

                <span>
                    Tổng:
                    <strong>@PatientState.TotalItems</strong>
                    bệnh nhân
                </span>
            </div>

        </div>


        @if (PatientState.IsLoading)
        {
            <div class="patients-empty">
                Đang tải danh sách bệnh nhân...
            </div>
        }
        else if (PatientState.Patients.Count == 0)
        {
            <div class="patients-empty">
                Không tìm thấy bệnh nhân phù hợp.
            </div>
        }
        else
        {
            <div class="patients-table-wrapper">

                <table class="patients-table">

                    <thead>
                        <tr>
                            <th>Mã BN</th>
                            <th>Họ và tên</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Số điện thoại</th>
                            <th>CCCD</th>
                            <th>BHYT</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var patient in PatientState.Patients)
                        {
                            <tr>
                                <td>
                                    <strong>@patient.PatientCode</strong>
                                </td>

                                <td>
                                    @patient.FullName
                                </td>

                                <td>
                                    @FormatDateOfBirth(patient.DateOfBirth)
                                </td>

                                <td>
                                    @GetGenderText(patient.Gender)
                                </td>

                                <td>
                                    @patient.Phone
                                </td>

                                <td>
                                    @GetDisplayValue(patient.NationalId)
                                </td>

                                <td>
                                    @GetDisplayValue(patient.InsuranceNumber)
                                </td>

                                <td>
                                    <button type="button" class="patients-view-button"
                                            @onclick="() => HandleSelectPatient(patient)">
                                        Xem
                                    </button>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        @* =================================================
           PAGINATION
           ================================================= *@

        @if (!PatientState.IsLoading &&
             PatientState.TotalPages > 0)
        {
            <div class="patients-pagination">

                <button type="button" disabled="@(PatientState.CurrentPage <= 1)" @onclick="PreviousPageAsync">

                    ← Trước

                </button>


                <span>
                    Trang
                    <strong>@PatientState.CurrentPage</strong>
                    /
                    <strong>@PatientState.TotalPages</strong>
                </span>


                <button type="button" disabled="@(PatientState.CurrentPage >= PatientState.TotalPages)"
                        @onclick="NextPageAsync">

                    Sau →
                </button>

            </div>
        }

    </div>

    @* =====================================================
   PATIENT DETAIL
   ===================================================== *@

    @if (PatientState.SelectedPatient is not null)
    {
        var patient = PatientState.SelectedPatient;

        <div class="patient-detail-card">

            <div class="patient-detail-header">

                <div>
                    <h2>Thông tin bệnh nhân</h2>

                    <span>
                        @patient.PatientCode
                    </span>
                </div>

                <button type="button" class="patient-detail-close" @onclick="HandleClearSelectedPatient">
                    ✕
                </button>

            </div>


            @if (!_showEditForm)
            {
                <div class="patient-detail-grid">

                    <div class="patient-detail-item">
                        <label>Họ và tên</label>
                        <span>
                            @patient.FullName
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Giới tính</label>
                        <span>
                            @GetGenderText(patient.Gender)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Ngày sinh</label>
                        <span>
                            @FormatDateOfBirth(patient.DateOfBirth)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Số điện thoại</label>
                        <span>
                            @GetDisplayValue(patient.Phone)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Email</label>
                        <span>
                            @GetDisplayValue(patient.Email)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Nhóm máu</label>
                        <span>
                            @GetDisplayValue(patient.BloodType)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>CCCD</label>
                        <span>
                            @GetDisplayValue(patient.NationalId)
                        </span>
                    </div>


                    <div class="patient-detail-item">
                        <label>Số BHYT</label>
                        <span>
                            @GetDisplayValue(patient.InsuranceNumber)
                        </span>
                    </div>


                    <div class="patient-detail-item patient-detail-full">
                        <label>Địa chỉ</label>
                        <span>
                            @GetDisplayValue(patient.Address)
                        </span>
                    </div>

                </div>


                <div class="patient-detail-actions">

                    <button class="patient-edit-button" @onclick="OpenEditForm">

                        <i class="fas fa-edit"></i>

                        Sửa hồ sơ

                    </button>


                    <button class="patient-allergy-button" @onclick="OpenAllergyForm">

                        <i class="fas fa-exclamation-triangle"></i>

                        Thêm dị ứng

                    </button>


                    <button type="button" class="patient-record-button">

                        Xem lịch sử khám

                    </button>

                </div>

                @if (_showAllergyForm)
                {
                    <div class="patient-form-card mt-3">


                        <div class="patient-form-header">

                            <div>

                                <h3>
                                    Thêm thông tin dị ứng
                                </h3>

                                <p>
                                    Cập nhật dị ứng của bệnh nhân.
                                </p>

                            </div>

                        </div>



                        <EditForm Model="_allergyRequest" OnValidSubmit="HandleAddAllergyAsync">


                            <DataAnnotationsValidator />


                            <div class="patient-form-grid">


                                <div class="patient-form-field">

                                    <label>
                                        Chất gây dị ứng
                                    </label>


                                    <InputText class="patient-form-input" @bind-Value="_allergyRequest.Allergen" />

                                </div>



                                <div class="patient-form-field">

                                    <label>
                                        Mức độ
                                    </label>


                                    <InputSelect class="patient-form-input" @bind-Value="_allergyRequest.Severity">


                                        <option value="">
                                            -- Chọn mức độ --
                                        </option>


                                        <option value="1">
                                            Nhẹ
                                        </option>


                                        <option value="2">
                                            Trung bình
                                        </option>


                                        <option value="3">
                                            Nặng
                                        </option>


                                    </InputSelect>

                                </div>



                                <div class="patient-form-field patient-form-full">

                                    <label>
                                        Ghi chú
                                    </label>


                                    <InputTextArea class="patient-form-input" @bind-Value="_allergyRequest.Note" />

                                </div>


                            </div>



                            <div class="patient-form-actions">


                                <button type="button" class="patient-form-cancel" @onclick="() => _showAllergyForm = false">

                                    Hủy

                                </button>



                                <button type="submit" class="patient-form-save" disabled="@PatientState.IsAddingAllergy">


                                    @if (PatientState.IsAddingAllergy)
                                    {
                                        <span>
                                            Đang lưu...
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Lưu dị ứng
                                        </span>
                                    }


                                </button>


                            </div>


                        </EditForm>


                    </div>
                }

            }
            else
            {
                <EditForm Model="_editPatientRequest" OnValidSubmit="HandleUpdatePatientAsync">

                    <DataAnnotationsValidator />


                    <div class="patient-form-grid">


                        <div class="patient-form-field">

                            <label>
                                Họ và tên
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.FullName" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                Giới tính
                            </label>

                            <InputSelect class="patient-form-input" @bind-Value="_editPatientRequest.Gender">

                                <option value="">
                                    -- Chọn giới tính --
                                </option>

                                <option value="1">
                                    Nam
                                </option>

                                <option value="0">
                                    Nữ
                                </option>

                                <option value="2">
                                    Khác
                                </option>

                            </InputSelect>

                        </div>



                        <div class="patient-form-field">

                            <label>
                                Ngày sinh
                            </label>

                            <InputDate class="patient-form-input" @bind-Value="_editPatientRequest.DateOfBirth" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                Số điện thoại
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.Phone" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                Email
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.Email" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                CCCD
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.NationalId" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                BHYT
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.InsuranceNumber" />

                        </div>



                        <div class="patient-form-field">

                            <label>
                                Nhóm máu
                            </label>

                            <InputText class="patient-form-input" @bind-Value="_editPatientRequest.BloodType" />

                        </div>



                        <div class="patient-form-field patient-form-full">

                            <label>
                                Địa chỉ
                            </label>

                            <InputTextArea class="patient-form-input" @bind-Value="_editPatientRequest.Address" />

                        </div>


                    </div>



                    <div class="patient-form-actions">

                        <button type="button" class="patient-form-cancel" @onclick="() => _showEditForm = false">

                            Hủy

                        </button>


                        <button type="submit" class="patient-form-save" disabled="@PatientState.IsEditing">

                            @if (PatientState.IsEditing)
                            {
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <span>Lưu thay đổi</span>
                            }

                        </button>

                    </div>


                </EditForm>
            }

        </div>
    }

</div>


@code {

    // =====================================================
    // CREATE PATIENT FORM - state
    // =====================================================

    private bool _showCreateForm;

    private PatientRequestDTO _createPatientRequest = new();

    // EDIT PATIENT FORM
    private bool _showEditForm;

    private PatientRequestDTO _editPatientRequest = new();

    // =====================================================
    // ADD ALLERGY FORM
    // =====================================================

    private bool _showAllergyForm;

    private PatientAllergyRequestDTO _allergyRequest = new();


    // =====================================================
    // OPEN ALLERGY FORM
    // =====================================================

    private void OpenAllergyForm()
    {
        _allergyRequest =
            new PatientAllergyRequestDTO();

        _showAllergyForm = true;
    }

    // =====================================================
    // ADD ALLERGY
    // =====================================================

    private async Task HandleAddAllergyAsync()
    {
        if (PatientState.SelectedPatient == null)
        {
            return;
        }


        var success =
            await PatientState.AddPatientAllergyAsync(
                PatientState.SelectedPatient.Id,
                _allergyRequest
            );


        if (!success)
        {
            return;
        }


        _showAllergyForm = false;


        _allergyRequest =
            new PatientAllergyRequestDTO();
    }

    // =====================================================
    // UPDATE PATIENT
    // =====================================================

    private async Task HandleUpdatePatientAsync()
    {
        Console.WriteLine("========== UPDATE START ==========");

        if (PatientState.SelectedPatient == null)
        {
            Console.WriteLine("NO PATIENT");
            return;
        }


        var success =
            await PatientState.UpdatePatientAsync(
                PatientState.SelectedPatient.Id,
                _editPatientRequest
            );


        Console.WriteLine($"UPDATE RESULT: {success}");


        if (success)
        {
            _showEditForm = false;
        }
    }

    
    // =====================================================
    // OPEN EDIT FORM
    // =====================================================

    private void OpenEditForm()
    {
        if (PatientState.SelectedPatient == null)
        {
            return;
        }


        var patient =
            PatientState.SelectedPatient;


        _editPatientRequest =
            new PatientRequestDTO
            {
                FullName = patient.FullName,

                Gender = patient.Gender,

                DateOfBirth = patient.DateOfBirth,

                Phone = patient.Phone,

                Email = patient.Email,

                Address = patient.Address,

                NationalId = patient.NationalId,

                InsuranceNumber =
                    patient.InsuranceNumber,

                BloodType =
                    patient.BloodType
            };


        _showEditForm = true;
    }
    

    // =====================================================
    // SEARCH
    // =====================================================

    private string SearchKeyword { get; set; } = string.Empty;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        PatientState.OnChange = HandleStateChanged;

        SearchKeyword = PatientState.Keyword;

        await PatientState.LoadPatientsAsync();
    }

    // =====================================================
    // OPEN CREATE FORM
    // =====================================================

    private void OpenCreateForm()
    {
        _createPatientRequest = new PatientRequestDTO();

        _showCreateForm = true;
    }


    // =====================================================
    // CLOSE CREATE FORM
    // =====================================================

    private void CloseCreateForm()
    {
        if (PatientState.IsSubmitting)
        {
            return;
        }

        _showCreateForm = false;

        _createPatientRequest = new PatientRequestDTO();
    }


    // =====================================================
    // CREATE PATIENT
    // =====================================================

    private async Task HandleCreatePatientAsync()
    {
        var success =
            await PatientState.CreatePatientAsync(
                _createPatientRequest
            );

        if (!success)
        {
            return;
        }

        _showCreateForm = false;

        _createPatientRequest =
            new PatientRequestDTO();
    }

    // =====================================================
    // SELECT PATIENT
    // =====================================================
    private async Task HandleSelectPatient(
        PatientDTO patient)
    {
        PatientState.SelectPatient(patient);


        await PatientState.LoadPatientAllergiesAsync(
            patient.Id
        );
    }


    // =====================================================
    // CLEAR SELECTED PATIENT
    // =====================================================

    private void HandleClearSelectedPatient()
    {
        PatientState.ClearSelectedPatient();
    }

    // =====================================================
    // SEARCH
    // =====================================================

    private async Task HandleSearchAsync()
    {
        PatientState.SetKeyword(SearchKeyword);

        await PatientState.LoadPatientsAsync();
    }


    // =====================================================
    // RESET SEARCH
    // =====================================================

    private async Task HandleResetAsync()
    {
        SearchKeyword = string.Empty;

        PatientState.SetKeyword(string.Empty);

        await PatientState.LoadPatientsAsync();
    }


    // =====================================================
    // PREVIOUS PAGE
    // =====================================================

    private async Task PreviousPageAsync()
    {
        if (PatientState.CurrentPage <= 1)
        {
            return;
        }

        PatientState.SetPage(
            PatientState.CurrentPage - 1
        );

        await PatientState.LoadPatientsAsync();
    }


    // =====================================================
    // NEXT PAGE
    // =====================================================

    private async Task NextPageAsync()
    {
        if (PatientState.CurrentPage >= PatientState.TotalPages)
        {
            return;
        }

        PatientState.SetPage(
            PatientState.CurrentPage + 1
        );

        await PatientState.LoadPatientsAsync();
    }


    // =====================================================
    // FORMAT DATE OF BIRTH
    // =====================================================

    private static string FormatDateOfBirth(
        DateOnly? dateOfBirth)
    {
        return dateOfBirth?.ToString("dd/MM/yyyy") ?? "-";
    }


    // =====================================================
    // GENDER TEXT
    // =====================================================

    private static string GetGenderText(
        byte? gender)
    {
        return gender switch
        {
            0 => "Nữ",
            1 => "Nam",
            2 => "Khác",
            _ => "-"
        };
    }


    // =====================================================
    // DISPLAY VALUE
    // =====================================================

    private static string GetDisplayValue(
        string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "-"
            : value;
    }


    // =====================================================
    // STATE CHANGE
    // =====================================================

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        PatientState.OnChange = null;
    }
}