@page "/reception/invoices/{InvoiceId:int}"

@layout HomePageMaster

@attribute [Authorize(Roles = "Receptionist")]

@using Microsoft.AspNetCore.Authorization
@using ClinicManagementSystem.Application.DTOs.Invoice
@using ClinicManagementSystem.Application.DTOs.Payment

@inject ReceptionInvoiceStateService ReceptionInvoiceStateService

@implements IDisposable


<PageTitle>Chi tiết hóa đơn</PageTitle>


<div class="reception-invoice-page">

    @* =====================================================
       HEADER
       ===================================================== *@

    <div class="reception-invoice-header">

        <div>
            <div class="reception-invoice-label">
                VC-11
            </div>

            <h1>
                Chi tiết hóa đơn
            </h1>

            <p>
                Xem thông tin hóa đơn, các khoản mục và lịch sử thanh toán.
            </p>
        </div>

    </div>


    @* =====================================================
       ERROR
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(
        ReceptionInvoiceStateService.ErrorMessage))
    {
        <div class="reception-invoice-message reception-invoice-error">
            @ReceptionInvoiceStateService.ErrorMessage
        </div>
    }


    @* =====================================================
       LOADING
       ===================================================== *@

    @if (ReceptionInvoiceStateService.IsLoading)
    {
        <div class="reception-invoice-loading">
            Đang tải thông tin hóa đơn...
        </div>
    }
    else if (ReceptionInvoiceStateService.Invoice == null)
    {
        <div class="reception-invoice-empty">
            Không có thông tin hóa đơn.
        </div>
    }
    else
    {
        var invoice =
            ReceptionInvoiceStateService.Invoice;


        @* =================================================
           INVOICE HEADER
           ================================================= *@

        <section class="reception-invoice-card">

            <div class="reception-invoice-card-header">

                <div>
                    <span class="reception-invoice-card-label">
                        HÓA ĐƠN
                    </span>

                    <h2>
                        @invoice.InvoiceNo
                    </h2>
                </div>

                <div class="reception-invoice-header-actions">

                    <span class="reception-invoice-status @GetStatusClass(invoice.Status)">
                        @GetStatusText(invoice.Status)
                    </span>


                    @if (invoice.Status != 3 &&
                         invoice.RemainingAmount > 0)
                    {
                        <button type="button" class="invoice-action-button invoice-action-primary" @onclick="OpenPaymentModal">

                            Thu tiền

                        </button>
                    }


                    @if (invoice.Status != 3 &&
                         invoice.PaidAmount > 0)
                    {
                        <button type="button" class="invoice-action-button invoice-action-refund" @onclick="OpenRefundModal">

                            Hoàn tiền

                        </button>
                    }

                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(
    ReceptionInvoiceStateService.ActionMessage))
            {
                <div class="reception-invoice-message reception-invoice-success">
                    @ReceptionInvoiceStateService.ActionMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                ReceptionInvoiceStateService.ActionErrorMessage))
            {
                <div class="reception-invoice-message reception-invoice-error">
                    @ReceptionInvoiceStateService.ActionErrorMessage
                </div>
            }

            @* =============================================
               PATIENT INFORMATION
               ============================================= *@

            <div class="reception-invoice-section">

                <div class="reception-invoice-section-title">
                    Thông tin bệnh nhân
                </div>

                <div class="reception-invoice-info-grid">

                    <div class="reception-invoice-info-item">
                        <span>Bệnh nhân</span>
                        <strong>
                            @invoice.PatientName
                        </strong>
                    </div>

                    <div class="reception-invoice-info-item">
                        <span>Mã bệnh nhân</span>
                        <strong>
                            @invoice.PatientId
                        </strong>
                    </div>

                    <div class="reception-invoice-info-item">
                        <span>Ngày tạo</span>
                        <strong>
                            @invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </strong>
                    </div>

                    <div class="reception-invoice-info-item">
                        <span>Mã lịch hẹn</span>
                        <strong>
                            @(invoice.AppointmentId?.ToString() ?? "—")
                        </strong>
                    </div>

                </div>

            </div>


            @* =============================================
               ITEMS
               ============================================= *@

            <div class="reception-invoice-section">

                <div class="reception-invoice-section-title">
                    Chi tiết hóa đơn
                </div>

                @if (invoice.Items == null ||
                    invoice.Items.Count == 0)
                {
                    <div class="reception-invoice-muted">
                        Hóa đơn chưa có khoản mục.
                    </div>
                }
                else
                {
                    <div class="reception-invoice-table-wrapper">

                        <table class="reception-invoice-table">

                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Nội dung</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Giảm giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var itemIndex = 1;
                                }

                                @foreach (var item in invoice.Items)
                                {
                                    <tr>

                                        <td>
                                            @itemIndex
                                        </td>

                                        <td>
                                            @item.Description
                                        </td>

                                        <td>
                                            @item.Quantity
                                        </td>

                                        <td>
                                            @item.UnitPrice.ToString("N0")
                                        </td>

                                        <td>
                                            @item.DiscountAmount.ToString("N0")
                                        </td>

                                        <td>
                                            <strong>
                                                @item.Amount.ToString("N0")
                                            </strong>
                                        </td>

                                    </tr>

                                    itemIndex++;
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            @* =============================================
               TOTALS
               ============================================= *@

            <div class="reception-invoice-summary">

                <div class="reception-invoice-summary-row">
                    <span>Tổng tiền</span>
                    <strong>
                        @invoice.TotalAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="reception-invoice-summary-row">
                    <span>Giảm giá</span>
                    <strong>
                        -@invoice.DiscountAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="reception-invoice-summary-row">
                    <span>Thuế</span>
                    <strong>
                        @invoice.TaxAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="reception-invoice-summary-row">
                    <span>Bảo hiểm</span>
                    <strong>
                        -@invoice.InsuranceAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="reception-invoice-summary-row reception-invoice-summary-paid">
                    <span>Đã thanh toán</span>
                    <strong>
                        @invoice.PaidAmount.ToString("N0") đ
                    </strong>
                </div>

                <div class="reception-invoice-summary-row reception-invoice-summary-remaining">
                    <span>Còn phải thu</span>
                    <strong>
                        @invoice.RemainingAmount.ToString("N0") đ
                    </strong>
                </div>

            </div>


            @* =============================================
               PAYMENTS
               ============================================= *@

            <div class="reception-invoice-section">

                <div class="reception-invoice-section-title">
                    Lịch sử thanh toán
                </div>

                @if (invoice.Payments == null ||
                    invoice.Payments.Count == 0)
                {
                    <div class="reception-invoice-muted">
                        Chưa có giao dịch thanh toán.
                    </div>
                }
                else
                {
                    <div class="reception-invoice-table-wrapper">

                        <table class="reception-invoice-table">

                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Loại</th>
                                    <th>Phương thức</th>
                                    <th>Mã tham chiếu</th>
                                    <th>Ghi chú</th>
                                    <th>Số tiền</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var payment in invoice.Payments)
                                {
                                    <tr>

                                        <td>
                                            @payment.PaidAt.ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            <span class="@GetPaymentTypeClass(payment)">
                                                @(payment.IsRefund
                                                    ? "Hoàn tiền"
                                                    : "Thu tiền")
                                            </span>
                                        </td>

                                        <td>
                                            @GetPaymentMethodText(payment.Method)
                                        </td>

                                        <td>
                                            @(payment.ReferenceCode ?? "—")
                                        </td>

                                        <td>
                                            @(payment.Note ?? "—")
                                        </td>

                                        <td>
                                            <strong class="@GetPaymentAmountClass(payment)">
                                                @payment.Amount.ToString("N0") đ
                                            </strong>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>


            @* =============================================
               CANCEL INFORMATION
               ============================================= *@

            @if (invoice.Status == 3)
            {
                <div class="reception-invoice-cancelled">

                    <strong>
                        Hóa đơn đã hủy
                    </strong>

                    @if (invoice.CancelledAt.HasValue)
                    {
                        <span>
                            Thời gian:
                            @invoice.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(invoice.CancelReason))
                    {
                        <span>
                            Lý do:
                            @invoice.CancelReason
                        </span>
                    }

                </div>
            }

        </section>
    }

</div>

@if (ShowPaymentModal)
{
    <div class="invoice-modal-backdrop">

        <div class="invoice-modal">

            <div class="invoice-modal-header">

                <div>
                    <div class="invoice-modal-label">
                        THANH TOÁN
                    </div>

                    <h3>
                        Thu tiền hóa đơn
                    </h3>
                </div>

                <button type="button" class="invoice-modal-close" @onclick="ClosePaymentModal"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    ×

                </button>

            </div>


            <div class="invoice-modal-body">

                @if (ReceptionInvoiceStateService.Invoice != null)
                {
                    <div class="invoice-payment-summary">

                        <div>
                            <span>Hóa đơn</span>

                            <strong>
                                @ReceptionInvoiceStateService.Invoice.InvoiceNo
                            </strong>
                        </div>

                        <div>
                            <span>Còn phải thu</span>

                            <strong>
                                @ReceptionInvoiceStateService.Invoice.RemainingAmount.ToString("N0") đ
                            </strong>
                        </div>

                    </div>
                }


                @* =============================================
                   AMOUNT
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Số tiền thu
                    </label>

                    <input type="number" step="1000" min="0" class="invoice-form-input" @bind="PaymentAmount"
                           disabled="@ReceptionInvoiceStateService.IsSubmitting" />

                </div>


                @* =============================================
                   METHOD
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Phương thức thanh toán
                    </label>

                    <select class="invoice-form-input" @bind="PaymentMethod"
                            disabled="@ReceptionInvoiceStateService.IsSubmitting">

                        <option value="0">
                            Tiền mặt
                        </option>

                        <option value="1">
                            Thẻ
                        </option>

                        <option value="2">
                            Chuyển khoản
                        </option>

                        <option value="3">
                            Ví điện tử
                        </option>

                    </select>

                </div>


                @* =============================================
                   REFERENCE CODE
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Mã tham chiếu
                        <span>(không bắt buộc)</span>
                    </label>

                    <input type="text" maxlength="200" class="invoice-form-input" @bind="PaymentReferenceCode"
                           disabled="@ReceptionInvoiceStateService.IsSubmitting" />

                </div>


                @* =============================================
                   NOTE
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Ghi chú
                        <span>(không bắt buộc)</span>
                    </label>

                    <textarea class="invoice-form-input invoice-form-textarea" rows="3" @bind="PaymentNote"
                              disabled="@ReceptionInvoiceStateService.IsSubmitting">
                    </textarea>

                </div>


                @* =============================================
                   CLIENT VALIDATION
                   ============================================= *@

                @if (!string.IsNullOrWhiteSpace(PaymentValidationMessage))
                {
                    <div class="invoice-form-validation">
                        @PaymentValidationMessage
                    </div>
                }

            </div>


            <div class="invoice-modal-footer">

                <button type="button" class="invoice-modal-button invoice-modal-secondary" @onclick="ClosePaymentModal"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    Hủy
                </button>


                <button type="button" class="invoice-modal-button invoice-modal-primary" @onclick="SubmitPaymentAsync"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    @if (ReceptionInvoiceStateService.IsSubmitting)
                    {
                        <span>
                            Đang xử lý...
                        </span>
                    }
                    else
                    {
                        <span>
                            Xác nhận thu tiền
                        </span>
                    }

                </button>

            </div>

        </div>

    </div>
}

@* =====================================================
   REFUND MODAL
   ===================================================== *@

@if (ShowRefundModal)
{
    <div class="invoice-modal-backdrop">

        <div class="invoice-modal">

            <div class="invoice-modal-header">

                <div>

                    <div class="invoice-modal-label">
                        HOÀN TIỀN
                    </div>

                    <h3>
                        Hoàn tiền hóa đơn
                    </h3>

                </div>


                <button type="button" class="invoice-modal-close" @onclick="CloseRefundModal"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    ×

                </button>

            </div>


            <div class="invoice-modal-body">

                @if (ReceptionInvoiceStateService.Invoice != null)
                {
                    <div class="invoice-payment-summary">

                        <div>

                            <span>
                                Hóa đơn
                            </span>

                            <strong>
                                @ReceptionInvoiceStateService
                                .Invoice
                                .InvoiceNo
                            </strong>

                        </div>


                        <div>

                            <span>
                                Đã thanh toán
                            </span>

                            <strong>
                                @ReceptionInvoiceStateService
                                .Invoice
                                .PaidAmount
                                .ToString("N0") đ
                            </strong>

                        </div>

                    </div>
                }


                @* =============================================
                   AMOUNT
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Số tiền hoàn
                    </label>

                    <input type="number" step="1000" min="0" class="invoice-form-input" @bind="RefundAmount"
                           disabled="@ReceptionInvoiceStateService.IsSubmitting" />

                </div>


                @* =============================================
                   METHOD
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Phương thức hoàn tiền
                    </label>

                    <select class="invoice-form-input" @bind="RefundMethod"
                            disabled="@ReceptionInvoiceStateService.IsSubmitting">

                        <option value="0">
                            Tiền mặt
                        </option>

                        <option value="1">
                            Thẻ
                        </option>

                        <option value="2">
                            Chuyển khoản
                        </option>

                        <option value="3">
                            Ví điện tử
                        </option>

                    </select>

                </div>


                @* =============================================
                   REFERENCE CODE
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Mã tham chiếu
                        <span>(không bắt buộc)</span>
                    </label>

                    <input type="text" maxlength="200" class="invoice-form-input" @bind="RefundReferenceCode"
                           disabled="@ReceptionInvoiceStateService.IsSubmitting" />

                </div>


                @* =============================================
                   NOTE
                   ============================================= *@

                <div class="invoice-form-group">

                    <label>
                        Ghi chú
                        <span>(không bắt buộc)</span>
                    </label>

                    <textarea class="invoice-form-input invoice-form-textarea" rows="3" @bind="RefundNote"
                              disabled="@ReceptionInvoiceStateService.IsSubmitting">
                    </textarea>

                </div>


                @* =============================================
                   VALIDATION
                   ============================================= *@

                @if (!string.IsNullOrWhiteSpace(
                    RefundValidationMessage))
                {
                    <div class="invoice-form-validation">
                        @RefundValidationMessage
                    </div>
                }

            </div>


            @* =============================================
               FOOTER
               ============================================= *@

            <div class="invoice-modal-footer">

                <button type="button" class="invoice-modal-button invoice-modal-secondary" @onclick="CloseRefundModal"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    Hủy

                </button>


                <button type="button" class="invoice-modal-button invoice-modal-refund" @onclick="SubmitRefundAsync"
                        disabled="@ReceptionInvoiceStateService.IsSubmitting">

                    @if (ReceptionInvoiceStateService.IsSubmitting)
                    {
                        <span>
                            Đang xử lý...
                        </span>
                    }
                    else
                    {
                        <span>
                            Xác nhận hoàn tiền
                        </span>
                    }

                </button>

            </div>

        </div>

    </div>
}


@code
{
    [Parameter]
    public int InvoiceId { get; set; }

    // =====================================================
    // PAYMENT MODAL
    // =====================================================

    private bool ShowPaymentModal { get; set; }


    private decimal PaymentAmount { get; set; }


    private byte PaymentMethod { get; set; }


    private string PaymentReferenceCode { get; set; } =
        string.Empty;


    private string PaymentNote { get; set; } =
        string.Empty;


    private string PaymentValidationMessage { get; set; } =
        string.Empty;


    protected override async Task OnInitializedAsync()
    {
        ReceptionInvoiceStateService.OnChange += HandleStateChanged;

        await ReceptionInvoiceStateService
            .LoadInvoiceAsync(InvoiceId);
    }


    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        ReceptionInvoiceStateService.OnChange -= HandleStateChanged;
    }

    // =====================================================
    // REFUND MODAL
    // =====================================================

    private bool ShowRefundModal { get; set; }


    private decimal RefundAmount { get; set; }


    private byte RefundMethod { get; set; }


    private string RefundReferenceCode { get; set; } =
        string.Empty;


    private string RefundNote { get; set; } =
        string.Empty;


    private string RefundValidationMessage { get; set; } =
        string.Empty;

    // mo refund modal
    private void OpenRefundModal()
    {
        var invoice =
            ReceptionInvoiceStateService.Invoice;

        if (invoice == null)
        {
            return;
        }


        RefundAmount =
            invoice.PaidAmount;

        RefundMethod = 0;

        RefundReferenceCode =
            string.Empty;

        RefundNote =
            string.Empty;

        RefundValidationMessage =
            string.Empty;

        ShowRefundModal = true;
    }

    // close refund modal
    private void CloseRefundModal()
    {
        if (ReceptionInvoiceStateService.IsSubmitting)
        {
            return;
        }

        ShowRefundModal = false;

        RefundValidationMessage =
            string.Empty;
    }

    // submit refund
    private async Task SubmitRefundAsync()
    {
        var invoice =
            ReceptionInvoiceStateService.Invoice;

        if (invoice == null)
        {
            return;
        }


        // =====================================================
        // VALIDATE AMOUNT
        // =====================================================

        if (RefundAmount <= 0)
        {
            RefundValidationMessage =
                "Số tiền hoàn phải lớn hơn 0.";

            return;
        }


        if (RefundAmount >
            invoice.PaidAmount)
        {
            RefundValidationMessage =
                "Số tiền hoàn không được vượt quá số tiền đã thanh toán.";

            return;
        }


        // =====================================================
        // CLEAR VALIDATION
        // =====================================================

        RefundValidationMessage =
            string.Empty;


        // =====================================================
        // CALL REFUND API
        // =====================================================

        var success =
            await ReceptionInvoiceStateService
                .RefundInvoiceAsync(
                    RefundAmount,
                    RefundMethod,
                    RefundReferenceCode,
                    RefundNote
                );


        if (success)
        {
            ShowRefundModal = false;
        }
    }

    // Open Modal
    private void OpenPaymentModal()
    {
        var invoice =
            ReceptionInvoiceStateService.Invoice;

        if (invoice == null)
        {
            return;
        }

        PaymentAmount =
            invoice.RemainingAmount;

        PaymentMethod = 0;

        PaymentReferenceCode =
            string.Empty;

        PaymentNote =
            string.Empty;

        PaymentValidationMessage =
            string.Empty;

        ShowPaymentModal = true;
    }

    // close modal
    private void ClosePaymentModal()
    {
        if (ReceptionInvoiceStateService.IsSubmitting)
        {
            return;
        }

        ShowPaymentModal = false;

        PaymentValidationMessage =
            string.Empty;
    }

    // submit
    private async Task SubmitPaymentAsync()
    {
        var invoice =
            ReceptionInvoiceStateService.Invoice;

        if (invoice == null)
        {
            return;
        }


        // =====================================================
        // VALIDATE AMOUNT
        // =====================================================

        if (PaymentAmount <= 0)
        {
            PaymentValidationMessage =
                "Số tiền thanh toán phải lớn hơn 0.";

            return;
        }


        if (PaymentAmount >
            invoice.RemainingAmount)
        {
            PaymentValidationMessage =
                "Số tiền thanh toán vượt quá số tiền còn phải thu.";

            return;
        }


        // =====================================================
        // CLEAR VALIDATION
        // =====================================================

        PaymentValidationMessage =
            string.Empty;


        // =====================================================
        // CALL STATE SERVICE
        // =====================================================

        var success =
            await ReceptionInvoiceStateService
                .CreatePaymentAsync(
                    PaymentAmount,
                    PaymentMethod,
                    PaymentReferenceCode,
                    PaymentNote
                );


        if (success)
        {
            ShowPaymentModal = false;
        }
    }

    // =====================================================
    // INVOICE STATUS
    // =====================================================

    private static string GetStatusText(byte status)
    {
        return status switch
        {
            0 => "Chưa thanh toán",
            1 => "Thanh toán một phần",
            2 => "Đã thanh toán",
            3 => "Đã hủy",
            _ => "Không xác định"
        };
    }


    private static string GetStatusClass(byte status)
    {
        return status switch
        {
            0 => "invoice-status-unpaid",
            1 => "invoice-status-partial",
            2 => "invoice-status-paid",
            3 => "invoice-status-cancelled",
            _ => "invoice-status-unknown"
        };
    }


    // =====================================================
    // PAYMENT
    // =====================================================

    private static string GetPaymentMethodText(byte method)
    {
        return method switch
        {
            0 => "Tiền mặt",
            1 => "Thẻ",
            2 => "Chuyển khoản",
            3 => "Ví điện tử",
            _ => "Không xác định"
        };
    }


    private static string GetPaymentTypeClass(
        PaymentDTO payment)
    {
        return payment.IsRefund
            ? "invoice-payment-refund"
            : "invoice-payment-income";
    }


    private static string GetPaymentAmountClass(
        PaymentDTO payment)
    {
        return payment.IsRefund
            ? "invoice-payment-amount-refund"
            : "invoice-payment-amount-income";
    }
}