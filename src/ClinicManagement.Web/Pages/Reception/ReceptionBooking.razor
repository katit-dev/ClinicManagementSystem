@page "/reception/booking"


@layout HomePageMaster


@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Receptionist")]


@using ClinicManagementSystem.Application.DTOs.Appointment
@using ClinicManagementSystem.Application.Enums


@inject ReceptionBookingStateService ReceptionBookingStateService


@implements IDisposable



<PageTitle>
    Đặt lịch khám
</PageTitle>




<div class="reception-booking-page">


    @* =====================================================
       PAGE HEADER
       ===================================================== *@


    <div class="reception-booking-header">


        <div>

            <h1>
                Đặt lịch khám
            </h1>


            <p>
                Đặt lịch khám thay cho bệnh nhân tại quầy tiếp đón.
            </p>

        </div>


    </div>





    @* =====================================================
       PATIENT
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">


            <h2>
                Thông tin bệnh nhân
            </h2>


        </div>



        <div class="reception-booking-empty">

            Chưa chọn bệnh nhân.

        </div>


    </div>







    @* =====================================================
       SPECIALTY
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">


            <h2>
                Chọn chuyên khoa
            </h2>


        </div>



        <div class="reception-booking-empty">

            Chưa chọn chuyên khoa.

        </div>


    </div>







    @* =====================================================
       DOCTOR
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">


            <h2>
                Chọn bác sĩ
            </h2>


        </div>



        <div class="reception-booking-empty">

            Chưa chọn bác sĩ.

        </div>


    </div>







    @* =====================================================
       AVAILABLE SLOT
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">


            <h2>
                Chọn giờ khám
            </h2>


        </div>



        <div class="reception-booking-empty">

            Chưa chọn khung giờ.

        </div>


    </div>







    @* =====================================================
       REASON
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">


            <h2>
                Lý do khám
            </h2>


        </div>



        <textarea class="reception-booking-textarea"
                  placeholder="Nhập lý do khám">
        </textarea>


    </div>







    @* =====================================================
       ACTION
       ===================================================== *@


    <div class="reception-booking-actions">


        <button type="button"
                class="reception-booking-submit-button">


            Xác nhận đặt lịch


        </button>


    </div>




</div>





@code {



    // =====================================================
    // INITIALIZE
    // =====================================================


    protected override void OnInitialized()
    {

    }





    // =====================================================
    // STATE CHANGED
    // =====================================================


    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }





    // =====================================================
    // DISPOSE
    // =====================================================


    public void Dispose()
    {

    }


}