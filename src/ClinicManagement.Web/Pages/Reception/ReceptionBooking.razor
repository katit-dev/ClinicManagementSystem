@page "/reception/booking"


@layout HomePageMaster


@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Receptionist")]


@using ClinicManagementSystem.Application.DTOs.Appointment
@using ClinicManagementSystem.Application.DTOs.Patient
@using ClinicManagementSystem.Application.Enums


@inject ReceptionBookingStateService ReceptionBookingStateService


@implements IDisposable



<PageTitle>
    Đặt lịch khám
</PageTitle>




<div class="reception-booking-page">



    @* =====================================================
       PAGE HEADER
       ===================================================== *@


    <div class="reception-booking-header">

        <h1>
            Đặt lịch khám
        </h1>


        <p>
            Đặt lịch khám thay cho bệnh nhân tại quầy tiếp đón.
        </p>

    </div>





    @* =====================================================
       PATIENT
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Thông tin bệnh nhân
            </h2>

        </div>




        <div class="reception-booking-search-row">


            <input class="reception-booking-input" placeholder="Nhập số điện thoại" @bind="_phone" />



            <button class="reception-booking-button" @onclick="LookupPatientAsync">

                Tìm bệnh nhân

            </button>


        </div>




        @if (!string.IsNullOrWhiteSpace(
            ReceptionBookingStateService.ErrorMessage))
        {

            <div class="reception-booking-error">

                @ReceptionBookingStateService.ErrorMessage

            </div>


            @* QUICK CREATE *@

            <div class="reception-booking-quick-create">


                <h3>
                    Tạo nhanh bệnh nhân
                </h3>



                <input class="reception-booking-input" placeholder="Họ tên bệnh nhân" @bind="_quickPatientName" />



                <button class="reception-booking-button" @onclick="CreateQuickPatientAsync">

                    Tạo bệnh nhân

                </button>


            </div>

        }






        @if (ReceptionBookingStateService.SelectedPatient != null)
        {

            <div class="reception-booking-patient-result">


                <div>
                    <strong>
                        Mã bệnh nhân:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.PatientCode
                </div>



                <div>
                    <strong>
                        Họ tên:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.FullName
                </div>



                <div>
                    <strong>
                        Điện thoại:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.Phone
                </div>



                <div>

                    @if (ReceptionBookingStateService.SelectedPatient.HasAccount)
                    {
                        <span>
                            Đã có tài khoản
                        </span>
                    }
                    else
                    {
                        <span>
                            Chưa có tài khoản
                        </span>
                    }

                </div>


            </div>

        }


    </div>







    @* =====================================================
       SPECIALTY
       ===================================================== *@


    <div class="reception-booking-card">

        <div class="reception-booking-card-header">

            <h2>
                Chọn chuyên khoa
            </h2>

        </div>


        <select class="reception-booking-select" @onchange="SelectSpecialtyAsync">


            <option value="">
                -- Chọn chuyên khoa --
            </option>


            @foreach (var specialty
                in ReceptionBookingStateService.Specialties)
            {
                <option value="@specialty.Id">

                    @specialty.Name

                </option>
            }


        </select>


    </div>







    @* =====================================================
       DOCTOR
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Chọn bác sĩ
            </h2>

        </div>



        <div class="reception-booking-empty">

            Chưa chọn bác sĩ.

        </div>


    </div>







    @* =====================================================
       SLOT
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Chọn giờ khám
            </h2>

        </div>



        <div class="reception-booking-empty">

            Chưa chọn khung giờ.

        </div>


    </div>







    @* =====================================================
       REASON
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Lý do khám
            </h2>

        </div>



        <textarea class="reception-booking-textarea" placeholder="Nhập lý do khám">
        </textarea>


    </div>







    @* =====================================================
       ACTION
       ===================================================== *@


    <div class="reception-booking-actions">


        <button type="button" class="reception-booking-submit-button">

            Xác nhận đặt lịch

        </button>


    </div>




</div>






@code {


    private string _phone = string.Empty;


    private string _quickPatientName = string.Empty;



    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        ReceptionBookingStateService.OnChange +=
            HandleStateChanged;


        await ReceptionBookingStateService
            .LoadSpecialtiesAsync();
    }



    // =====================================================
    // Select SpecialtyAsync
    // =====================================================
    private async Task SelectSpecialtyAsync(
        ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var specialtyId))
        {
            await ReceptionBookingStateService
                .LoadDoctorsAsync(specialtyId);
        }
    }

    // =====================================================
    // LOOKUP PATIENT
    // =====================================================

    private async Task LookupPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(_phone))
        {
            return;
        }


        await ReceptionBookingStateService
            .LookupPatientAsync(_phone);
    }






    // =====================================================
    // CREATE QUICK PATIENT
    // =====================================================

    private async Task CreateQuickPatientAsync()
    {
        if (string.IsNullOrWhiteSpace(_quickPatientName))
        {
            return;
        }



        var request =
            new QuickPatientRequestDTO
            {
                FullName =
                    _quickPatientName,

                Phone =
                    _phone
            };



        await ReceptionBookingStateService
            .CreateQuickPatientAsync(request);
    }






    // =====================================================
    // STATE CHANGED
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }






    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        ReceptionBookingStateService.OnChange -=
            HandleStateChanged;
    }


}