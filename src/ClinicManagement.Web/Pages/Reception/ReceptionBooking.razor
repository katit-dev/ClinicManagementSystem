@page "/reception/booking"


@layout HomePageMaster


@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Receptionist")]


@using ClinicManagementSystem.Application.DTOs.Appointment
@using ClinicManagementSystem.Application.DTOs.Patient
@using ClinicManagementSystem.Application.Enums


@inject ReceptionBookingStateService ReceptionBookingStateService


@implements IDisposable



<PageTitle>
    Đặt lịch khám
</PageTitle>




<div class="reception-booking-page">



    @* =====================================================
       PAGE HEADER
       ===================================================== *@

    <div class="reception-booking-header">

        <h1>
            Đặt lịch khám
        </h1>


        <p>
            Đặt lịch khám thay cho bệnh nhân tại quầy tiếp đón.
        </p>

    </div>





    @* =====================================================
       PATIENT
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Thông tin bệnh nhân
            </h2>

        </div>




        <div class="reception-booking-search-row">


            <input class="reception-booking-input" placeholder="Nhập số điện thoại" @bind="_phone" />



            <button class="reception-booking-button" @onclick="LookupPatientAsync">

                Tìm bệnh nhân

            </button>


        </div>

        @if (!string.IsNullOrWhiteSpace(_phoneError))
        {
            <div class="reception-booking-error">
                @_phoneError
            </div>
        }


        @if (!string.IsNullOrWhiteSpace(
            ReceptionBookingStateService.ErrorMessage))
        {

            <div class="reception-booking-error">

                @ReceptionBookingStateService.ErrorMessage

            </div>




            @* =================================================
               QUICK CREATE PATIENT
               ================================================= *@


            <div class="reception-booking-quick-create">


                <h3>
                    Tạo nhanh bệnh nhân
                </h3>



                <input class="reception-booking-input" placeholder="Họ tên bệnh nhân" @bind="_quickPatientName" />



                <button class="reception-booking-button" @onclick="CreateQuickPatientAsync">

                    Tạo bệnh nhân

                </button>


            </div>

        }






        @if (ReceptionBookingStateService.SelectedPatient != null)
        {

            <div class="reception-booking-patient-result">


                <div>
                    <strong>
                        Mã bệnh nhân:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.PatientCode
                </div>



                <div>
                    <strong>
                        Họ tên:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.FullName
                </div>



                <div>
                    <strong>
                        Điện thoại:
                    </strong>

                    @ReceptionBookingStateService.SelectedPatient.Phone
                </div>



                <div>

                    @if (ReceptionBookingStateService.SelectedPatient.HasAccount)
                    {

                        <span>
                            Đã có tài khoản
                        </span>

                    }
                    else
                    {

                        <span>
                            Chưa có tài khoản
                        </span>

                    }

                </div>


            </div>

        }


    </div>







    @* =====================================================
       SPECIALTY
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Chọn chuyên khoa
            </h2>

        </div>



        <select class="reception-booking-select" @onchange="SelectSpecialtyAsync">


            <option value="">
                -- Chọn chuyên khoa --
            </option>



            @foreach (var specialty
                in ReceptionBookingStateService.Specialties)
            {

                <option value="@specialty.Id">

                    @specialty.Name

                </option>

            }


        </select>


    </div>







    @* =====================================================
       DOCTOR
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Chọn bác sĩ
            </h2>

        </div>

        @if (ReceptionBookingStateService.SelectedSpecialtyId == null)
        {
            <div class="reception-booking-empty">
                Vui lòng chọn chuyên khoa.
            </div>
        }
        else if (ReceptionBookingStateService.IsLoading)
        {
            <div class="reception-booking-empty">
                Đang tải danh sách bác sĩ...
            </div>
        }
        else if (!ReceptionBookingStateService.Doctors.Any())
        {
            <div class="reception-booking-empty">
                Không có bác sĩ thuộc chuyên khoa này.
            </div>
        }
        else
        {
            <select class="reception-booking-select" @onchange="SelectDoctorAsync">

                <option value="">
                    -- Chọn bác sĩ --
                </option>

                @foreach (var doctor
                    in ReceptionBookingStateService.Doctors)
                {
                    <option value="@doctor.Id">
                        @doctor.FullName
                    </option>
                }

            </select>
        }


    </div>







    @* =====================================================
   SLOT
   ===================================================== *@

    <div class="reception-booking-card">

        <div class="reception-booking-card-header">

            <h2>
                Chọn giờ khám
            </h2>

        </div>


        @if (ReceptionBookingStateService.SelectedDoctorId == null)
        {
            <div class="reception-booking-empty">

                Vui lòng chọn bác sĩ.

            </div>
        }
        else
        {
            <div class="reception-booking-slot-date">

                <label>
                    Ngày khám
                </label>

                <input type="date" class="reception-booking-input"
                       value="@ReceptionBookingStateService.SelectedDate.ToString("yyyy-MM-dd")"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" @onchange="SelectDateAsync" />

            </div>


            @if (ReceptionBookingStateService.IsLoading)
            {
                <div class="reception-booking-empty">

                    Đang tải khung giờ...

                </div>
            }
            else if (!ReceptionBookingStateService.Slots.Any())
            {
                <div class="reception-booking-empty">

                    Không có khung giờ khám trong ngày này.

                </div>
            }
            else
            {
                <div class="reception-booking-slots">

                    @foreach (var slot
                        in ReceptionBookingStateService.Slots)
                    {
                        <button type="button" class="@(slot.IsAvailable
                                    ? "reception-booking-slot"
                                    : "reception-booking-slot unavailable")
                            @(ReceptionBookingStateService.SelectedStartTime == slot.StartTime
    ? " selected"
    : "")" disabled="@(!slot.IsAvailable)" @onclick="() => SelectSlot(slot.StartTime)">

                            <span class="reception-booking-slot-time">

                                @slot.StartTime.ToString("HH:mm")
                                -
                                @slot.EndTime.ToString("HH:mm")

                            </span>


                            <span class="reception-booking-slot-status">

                                @(slot.IsAvailable
                                    ? "Trống"
                                    : "Đã đặt")

                            </span>

                        </button>
                    }

                </div>
            }

        }

    </div>






    @* =====================================================
       REASON
       ===================================================== *@


    <div class="reception-booking-card">


        <div class="reception-booking-card-header">

            <h2>
                Lý do khám
            </h2>

        </div>



        <textarea class="reception-booking-textarea" placeholder="Nhập lý do khám">
        </textarea>


    </div>







    @* =====================================================
       ACTION
       ===================================================== *@


    <div class="reception-booking-actions">


        <button type="button" class="reception-booking-submit-button">

            Xác nhận đặt lịch

        </button>


    </div>




</div>






@code {


    private string _phone = string.Empty;


    private string _quickPatientName = string.Empty;
    private string _phoneError = string.Empty;



    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {

        ReceptionBookingStateService.OnChange +=
            HandleStateChanged;


        await ReceptionBookingStateService
            .LoadSpecialtiesAsync();

    }

    // =====================================================
    // SELECT DATE
    // =====================================================

    private async Task SelectDateAsync(
        ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(
            e.Value?.ToString(),
            out var selectedDate))
        {
            return;
        }


        if (!ReceptionBookingStateService
            .SelectedDoctorId.HasValue)
        {
            return;
        }


        await ReceptionBookingStateService
            .LoadSlotsAsync(
                ReceptionBookingStateService
                    .SelectedDoctorId.Value,

                selectedDate
            );
    }

    // =====================================================
    // SELECT SLOT
    // =====================================================

    private void SelectSlot(
        DateTime startTime)
    {
        ReceptionBookingStateService
            .SelectSlot(startTime);
    }

    // =====================================================
    // SELECT DoctorAsync
    // =====================================================
    private async Task SelectDoctorAsync(
    ChangeEventArgs e)
    {
        if (int.TryParse(
            e.Value?.ToString(),
            out var doctorId))
        {
            ReceptionBookingStateService
                .SelectDoctor(doctorId);

            await Task.CompletedTask;
        }
    }

    // =====================================================
    // SELECT SPECIALTY
    // =====================================================

    private async Task SelectSpecialtyAsync(
        ChangeEventArgs e)
    {

        if (int.TryParse(
            e.Value?.ToString(),
            out var specialtyId))
        {

            await ReceptionBookingStateService
                .LoadDoctorsAsync(specialtyId);

        }

    }






    // =====================================================
    // LOOKUP PATIENT
    // =====================================================
    private async Task LookupPatientAsync()
    {
        _phoneError = string.Empty;

        if (string.IsNullOrWhiteSpace(_phone))
        {
            _phoneError =
                "Số điện thoại không được để trống.";

            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(
            _phone,
            @"^0[0-9]{9}$"))
        {
            _phoneError =
                "Số điện thoại phải có 10 chữ số và bắt đầu bằng 0.";

            return;
        }

        await ReceptionBookingStateService
            .LookupPatientAsync(_phone);
    }



    // =====================================================
    // CREATE QUICK PATIENT
    // =====================================================

    private async Task CreateQuickPatientAsync()
    {

        if (string.IsNullOrWhiteSpace(_quickPatientName))
        {
            return;
        }



        var request =
            new QuickPatientRequestDTO
            {
                FullName =
                    _quickPatientName,

                Phone =
                    _phone
            };



        await ReceptionBookingStateService
            .CreateQuickPatientAsync(request);

    }






    // =====================================================
    // STATE CHANGED
    // =====================================================

    private void HandleStateChanged()
    {

        InvokeAsync(StateHasChanged);

    }






    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {

        ReceptionBookingStateService.OnChange -=
            HandleStateChanged;

    }


}