@page "/reception"

@layout HomePageMaster

@attribute [Authorize(Roles = "Receptionist")]

@using Microsoft.AspNetCore.Authorization
@using ClinicManagementSystem.Application.Enums

@inject ReceptionAppointmentStateService ReceptionAppointmentStateService

@implements IDisposable

<PageTitle>Bàn tiếp đón</PageTitle>


<div class="reception-page">

    @* =====================================================
       PAGE HEADER
       ===================================================== *@

    <div class="reception-header">

        <div>
            <h1>Bàn tiếp đón</h1>
            <p>Theo dõi lịch hẹn trong ngày và trạng thái từng bệnh nhân.</p>
        </div>

    </div>


    @* =====================================================
       FILTERS
       ===================================================== *@

    <div class="reception-today">

        <div class="reception-today-title">

            <span>BÀN TIẾP ĐÓN</span>

            <strong>
                @ReceptionAppointmentStateService.SelectedDate.ToString("dd/MM/yyyy")
            </strong>

        </div>


        <div class="reception-filters">

            @* =================================================
               DATE
               ================================================= *@

            <div class="reception-filter-group">

                <label>Ngày</label>

                <input type="date" class="reception-filter-control"
                       value="@ReceptionAppointmentStateService.SelectedDate.ToString("yyyy-MM-dd")"
                       @onchange="HandleDateChanged" />

            </div>


            @* =================================================
               SPECIALTY
               ================================================= *@

            <div class="reception-filter-group">

                <label>Chuyên khoa</label>

                <select class="reception-filter-control" value="@GetSelectedSpecialtyValue()"
                        @onchange="HandleSpecialtyChanged">

                    <option value="">
                        Tất cả
                    </option>

                    @foreach (var specialty in ReceptionAppointmentStateService.Specialties)
                    {
                        <option value="@specialty.Id">
                            @specialty.Name
                        </option>
                    }

                </select>

            </div>


            @* =================================================
               DOCTOR
               ================================================= *@

            <div class="reception-filter-group">

                <label>Bác sĩ</label>

                <select class="reception-filter-control" value="@GetSelectedDoctorValue()"
                        @onchange="HandleDoctorChanged"
                        disabled="@(!ReceptionAppointmentStateService.SelectedSpecialtyId.HasValue)">

                    <option value="">
                        Tất cả
                    </option>

                    @foreach (var doctor in ReceptionAppointmentStateService.Doctors)
                    {
                        <option value="@doctor.Id">
                            @doctor.FullName
                        </option>
                    }

                </select>

            </div>


            @* =================================================
               STATUS
               ================================================= *@

            <div class="reception-filter-group">

                <label>Trạng thái</label>

                <select class="reception-filter-control" value="@GetSelectedStatusValue()"
                        @onchange="HandleStatusChanged">

                    <option value="">
                        Tất cả
                    </option>

                    <option value="@((byte)AppointmentStatus.Pending)">
                        Chờ xác nhận
                    </option>

                    <option value="@((byte)AppointmentStatus.Confirmed)">
                        Đã xác nhận
                    </option>

                    <option value="@((byte)AppointmentStatus.CheckedIn)">
                        Đã check-in
                    </option>

                    <option value="@((byte)AppointmentStatus.Completed)">
                        Đã khám xong
                    </option>

                    <option value="@((byte)AppointmentStatus.Cancelled)">
                        Đã hủy
                    </option>

                    <option value="@((byte)AppointmentStatus.NoShow)">
                        Không đến
                    </option>

                </select>

            </div>


            @* =================================================
               RESET
               ================================================= *@

            <div class="reception-filter-group reception-filter-action">

                <label>&nbsp;</label>

                <button type="button" class="reception-filter-reset" @onclick="HandleResetFilters">
                    Đặt lại
                </button>

            </div>

        </div>

    </div>


    @* =====================================================
       SUMMARY
       ===================================================== *@

    <div class="reception-summary">

        <div class="reception-summary-card">
            <strong>@TotalAppointments</strong>
            <span>Tổng lịch hẹn</span>
        </div>

        <div class="reception-summary-card">
            <strong>@WaitingAppointments</strong>
            <span>Chờ đến</span>
        </div>

        <div class="reception-summary-card">
            <strong>@CheckedInAppointments</strong>
            <span>Đã check-in</span>
        </div>

        <div class="reception-summary-card">
            <strong>@CompletedAppointments</strong>
            <span>Đã khám xong</span>
        </div>

        <div class="reception-summary-card">
            <strong>@NoShowAppointments</strong>
            <span>Không đến</span>
        </div>

    </div>


    @* =====================================================
       APPOINTMENTS
       ===================================================== *@

    <div class="reception-appointments">

        <div class="reception-section-header">
            <h3>Lịch hẹn</h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(
    ReceptionAppointmentStateService.ActionErrorMessage))
        {
            <div class="reception-action-message reception-action-error">
                @ReceptionAppointmentStateService.ActionErrorMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(
            ReceptionAppointmentStateService.ActionMessage))
        {
            <div class="reception-action-message reception-action-success">
                @ReceptionAppointmentStateService.ActionMessage
            </div>
        }


        @* =================================================
           LOADING
           ================================================= *@

        @if (ReceptionAppointmentStateService.IsLoading)
        {
            <div class="reception-empty">
                Đang tải danh sách lịch hẹn...
            </div>
        }

        @* =================================================
           ERROR
           ================================================= *@

        else if (!string.IsNullOrWhiteSpace(
            ReceptionAppointmentStateService.ErrorMessage))
        {
            <div class="reception-empty">
                @ReceptionAppointmentStateService.ErrorMessage
            </div>
        }

        @* =================================================
           EMPTY
           ================================================= *@

        else if (ReceptionAppointmentStateService.Appointments.Count == 0)
        {
            <div class="reception-empty">
                Không có lịch hẹn phù hợp.
            </div>
        }

        @* =================================================
   APPOINTMENT TABLE
   ================================================= *@

        else
        {
            <div class="reception-table-wrapper">

                <table class="reception-table">

                    <thead>

                        <tr>
                            <th>Giờ</th>
                            <th>STT</th>
                            <th>Bệnh nhân</th>
                            <th>Mã BN</th>
                            <th>Bác sĩ</th>
                            <th>Chuyên khoa</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var appointment in
                            ReceptionAppointmentStateService.Appointments)
                        {
                            <tr>

                                @* =====================================
                           TIME
                           ===================================== *@

                                <td>

                                    <div class="reception-time">

                                        <strong>
                                            @appointment.StartTime.ToString("HH:mm")
                                        </strong>

                                        <span>
                                            @appointment.EndTime.ToString("HH:mm")
                                        </span>

                                    </div>

                                </td>


                                @* =====================================
                           QUEUE NUMBER
                           ===================================== *@

                                <td>

                                    @if (CanCheckIn(appointment.Status))
                                    {
                                        <button type="button" class="reception-checkin-button"
                                                disabled="@IsProcessingAppointment(appointment.Id)"
                                                @onclick="() => HandleCheckIn(appointment.Id)">

                                            @if (IsProcessingAppointment(appointment.Id))
                                            {
                                                <span>Đang xử lý...</span>
                                            }
                                            else
                                            {
                                                <span>Check-in</span>
                                            }

                                        </button>
                                    }
                                    else
                                    {
                                        <span class="reception-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                @* =====================================
                           PATIENT
                           ===================================== *@

                                <td>

                                    <div class="reception-patient">

                                        <strong>
                                            @appointment.PatientName
                                        </strong>

                                        <span>
                                            @appointment.AppointmentCode
                                        </span>

                                    </div>

                                </td>


                                @* =====================================
                           PATIENT CODE
                           ===================================== *@

                                <td>
                                    @appointment.PatientCode
                                </td>


                                @* =====================================
                           DOCTOR
                           ===================================== *@

                                <td>
                                    @appointment.DoctorName
                                </td>


                                @* =====================================
                           SPECIALTY
                           ===================================== *@

                                <td>
                                    @appointment.SpecialtyName
                                </td>


                                @* =====================================
                           STATUS
                           ===================================== *@

                                <td>

                                    <span class="reception-status @GetStatusClass(appointment.Status)">
                                        @GetStatusText(appointment.Status)
                                    </span>

                                </td>


                                @* =====================================
                           ACTIONS
                           //
                           Sẽ làm ở bước 5.8.7 và 5.8.8.
                           ===================================== *@

                                <td>

                                    <span class="reception-muted">
                                        —
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    @* =====================================================
       QUICK ACTIONS
       ===================================================== *@

    <div class="reception-actions">

        <a href="/reception/booking" class="reception-action-button">
            Đặt lịch hộ
        </a>

        <a href="/reception/patients/new" class="reception-action-button">
            Tạo bệnh nhân mới
        </a>

    </div>

</div>


@code {

    // =====================================================
    // SUMMARY
    // =====================================================

    private int TotalAppointments =>
        ReceptionAppointmentStateService.Appointments.Count;

    private int WaitingAppointments =>
        ReceptionAppointmentStateService.Appointments.Count(
            a =>
                a.Status == (byte)AppointmentStatus.Pending ||
                a.Status == (byte)AppointmentStatus.Confirmed
        );

    private int CheckedInAppointments =>
        ReceptionAppointmentStateService.Appointments.Count(
            a => a.Status == (byte)AppointmentStatus.CheckedIn
        );

    private int CompletedAppointments =>
        ReceptionAppointmentStateService.Appointments.Count(
            a => a.Status == (byte)AppointmentStatus.Completed
        );

    private int NoShowAppointments =>
        ReceptionAppointmentStateService.Appointments.Count(
            a => a.Status == (byte)AppointmentStatus.NoShow
        );


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        ReceptionAppointmentStateService.OnChange +=
            HandleStateChanged;

        await ReceptionAppointmentStateService
            .LoadSpecialtiesAsync();

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // DATE CHANGED
    // =====================================================

    private async Task HandleDateChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        if (!DateOnly.TryParse(value, out var date))
        {
            return;
        }

        ReceptionAppointmentStateService.SetDate(date);

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // SPECIALTY CHANGED
    // =====================================================

    private async Task HandleSpecialtyChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        int? specialtyId =
            int.TryParse(value, out var parsedId)
                ? parsedId
                : null;

        ReceptionAppointmentStateService
            .SetSpecialty(specialtyId);


        // =================================================
        // LOAD DOCTORS
        // =================================================

        await ReceptionAppointmentStateService
            .LoadDoctorsAsync();


        // =================================================
        // RELOAD APPOINTMENTS
        // =================================================

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // DOCTOR CHANGED
    // =====================================================

    private async Task HandleDoctorChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        int? doctorId =
            int.TryParse(value, out var parsedId)
                ? parsedId
                : null;

        ReceptionAppointmentStateService
            .SetDoctor(doctorId);

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // STATUS TEXT
    // =====================================================

    private static string GetStatusText(byte status)
    {
        return status switch
        {
            (byte)AppointmentStatus.Pending => "Chờ xác nhận",
            (byte)AppointmentStatus.Confirmed => "Đã xác nhận",
            (byte)AppointmentStatus.CheckedIn => "Đã check-in",
            (byte)AppointmentStatus.Completed => "Đã khám xong",
            (byte)AppointmentStatus.Cancelled => "Đã hủy",
            (byte)AppointmentStatus.NoShow => "Không đến",

            _ => "Không xác định"
        };
    }


    // =====================================================
    // STATUS CLASS
    // =====================================================

    private static string GetStatusClass(byte status)
    {
        return status switch
        {
            (byte)AppointmentStatus.Pending => "status-pending",
            (byte)AppointmentStatus.Confirmed => "status-confirmed",
            (byte)AppointmentStatus.CheckedIn => "status-checked-in",
            (byte)AppointmentStatus.Completed => "status-completed",
            (byte)AppointmentStatus.Cancelled => "status-cancelled",
            (byte)AppointmentStatus.NoShow => "status-no-show",

            _ => string.Empty
        };
    }

    // =====================================================
    // STATUS CHANGED
    // =====================================================

    private async Task HandleStatusChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        AppointmentStatus? status = null;

        if (byte.TryParse(value, out var parsedStatus))
        {
            status =
                (AppointmentStatus)parsedStatus;
        }

        ReceptionAppointmentStateService
            .SetStatus(status);

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // RESET FILTERS
    // =====================================================

    private async Task HandleResetFilters()
    {
        ReceptionAppointmentStateService
            .ResetFilters();

        await ReceptionAppointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // SELECTED VALUES
    // =====================================================

    private string GetSelectedSpecialtyValue()
    {
        return ReceptionAppointmentStateService
            .SelectedSpecialtyId?
            .ToString()
            ?? string.Empty;
    }

    private string GetSelectedDoctorValue()
    {
        return ReceptionAppointmentStateService
            .SelectedDoctorId?
            .ToString()
            ?? string.Empty;
    }

    private string GetSelectedStatusValue()
    {
        return ReceptionAppointmentStateService
            .SelectedStatus.HasValue
                ? ((byte)ReceptionAppointmentStateService.SelectedStatus.Value)
                    .ToString()
                : string.Empty;
    }

    // =====================================================
    // CAN CHECK IN
    // =====================================================

    private static bool CanCheckIn(byte status)
    {
        return
            status == (byte)AppointmentStatus.Pending ||
            status == (byte)AppointmentStatus.Confirmed;
    }


    // =====================================================
    // PROCESSING APPOINTMENT
    // =====================================================

    private bool IsProcessingAppointment(int appointmentId)
    {
        return
            ReceptionAppointmentStateService.IsSubmitting &&
            ReceptionAppointmentStateService.ProcessingAppointmentId ==
                appointmentId;
    }


    // =====================================================
    // CHECK IN
    // =====================================================

    private async Task HandleCheckIn(int appointmentId)
    {
        await ReceptionAppointmentStateService
            .CheckInAppointmentAsync(
                appointmentId
            );
    }


    // =====================================================
    // STATE CHANGED
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        ReceptionAppointmentStateService.OnChange -=
            HandleStateChanged;
    }
}