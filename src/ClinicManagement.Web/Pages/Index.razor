@page "/"

@layout LandingPageMaster

<PageTitle>Clinic Management System</PageTitle>


@* =====================================================
   LANDING PAGE
   ===================================================== *@

<section class="landing-page">

    @* =================================================
       BACKGROUND OVERLAY
       ================================================= *@

    <div class="landing-overlay"></div>


    @* =================================================
       CONTENT
       ================================================= *@

    <div class="landing-content">

        @* =================================================
        HERO CONTENT
        ================================================= *@

        <div class="landing-hero">

            @* =================================================
            BRAND
            ================================================= *@

            <div class="landing-brand">
                Clinic Management System
            </div>


            @* =================================================
             TITLE
            ================================================= *@

            <h1 class="landing-title">
                Hệ thống quản lý
                <span>phòng khám</span>
            </h1>


            @* =================================================
            DESCRIPTION
            ================================================= *@

            <p class="landing-description">
                Đặt lịch khám nhanh chóng,
                quản lý lịch hẹn thuận tiện
                và theo dõi thông tin sức khỏe
                ngay trên một hệ thống duy nhất.
            </p>


            @* =================================================
            ACTIONS
            ================================================= *@

            <div class="landing-actions">

                <a href="/register" class="landing-button landing-button-register">

                    Đăng ký

                </a>


                <a href="/login" class="landing-button landing-button-login">

                    Đăng nhập

                </a>

            </div>

        </div>

    </div>

</section>