@page "/"

@layout HomePageMaster

@inject IHttpClientFactory HttpClientFactory
@inject UserStateService _userStateService

<PageTitle>Trang chủ</PageTitle>


<div>

    <h1>Hệ thống quản lý phòng khám</h1>

    <p class="text-secondary">
        Clinic Management System
    </p>

    <button class="btn btn-primary" @onclick="TestHttpClient">

        Test HttpClient

    </button>

    <p class="mt-3">@message</p>
    <button class="btn btn-warning" @onclick="TestRefreshToken">

        Test Refresh Token

    </button>
</div>


@code {

    private string message = "";

    private void TestHttpClient()
    {
        var client =
            HttpClientFactory.CreateClient("ClinicApi");

        message =
            $"Backend URL: {client.BaseAddress}";
    }

    private async Task TestRefreshToken()
    {
        var result =
            await _userStateService
                .RefreshTokenAsync();

        Console.WriteLine(
            $"Refresh result: {result}"
        );
    }

}