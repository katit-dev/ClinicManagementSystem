@page "/doctor/doctor-queue"
@page "/doctor"

@layout HomePageMaster


@using ClinicManagementSystem.Application.DTOs.Queue
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Doctor")]

@inject DoctorQueueStateService DoctorQueueStateService
@inject NavigationManager NavigationManager

@implements IDisposable


<PageTitle>Hàng chờ khám</PageTitle>


<div class="doctor-queue-page">

    @* =====================================================
       HEADER
       ===================================================== *@

    <div class="doctor-queue-header">

        <div class="doctor-queue-header-content">

            <div class="doctor-queue-label">
                DOCTOR QUEUE
            </div>

            <h1>
                Hàng chờ khám
            </h1>

            <p>
                Danh sách bệnh nhân đang chờ bác sĩ khám.
            </p>

        </div>


        @* =================================================
           DATE
           ================================================= *@

        <div class="doctor-queue-date">

            <label for="doctor-queue-date">
                Ngày khám
            </label>

            <InputDate id="doctor-queue-date" @bind-Value="_selectedDate" @bind-Value:after="OnDateChangedAsync"
                       class="doctor-queue-date-input" />

        </div>

    </div>


    @* =====================================================
       ERROR
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(
        DoctorQueueStateService.ErrorMessage))
    {
        <div class="doctor-queue-message doctor-queue-error">
            @DoctorQueueStateService.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(
    DoctorQueueStateService.ActionMessage))
    {
        <div class="doctor-queue-message doctor-queue-success">
            @DoctorQueueStateService.ActionMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(
        DoctorQueueStateService.ActionErrorMessage))
    {
        <div class="doctor-queue-message doctor-queue-error">
            @DoctorQueueStateService.ActionErrorMessage
        </div>
    }


    @* =====================================================
       LOADING
       ===================================================== *@

    @if (DoctorQueueStateService.IsLoading)
    {
        <div class="doctor-queue-state">

            <div class="doctor-queue-loading">
                Đang tải hàng chờ...
            </div>

        </div>
    }
    else
    {
        @* =================================================
           QUEUE
           ================================================= *@

        @if (DoctorQueueStateService.QueueItems.Count == 0)
        {
            <div class="doctor-queue-empty-card">

                <div class="doctor-queue-empty-icon">
                    <span>👥</span>
                </div>

                <h2>
                    Chưa có dữ liệu hàng chờ
                </h2>

                <p>
                    Danh sách bệnh nhân chờ khám sẽ được hiển thị tại đây.
                </p>

            </div>
        }
        else
        {
            <div class="doctor-queue-card">

                @* =============================================
                   CARD HEADER
                   ============================================= *@

                <div class="doctor-queue-card-header">

                    <div>

                        <h2>
                            Hàng chờ bệnh nhân
                        </h2>

                    </div>


                    <div class="doctor-queue-count">
                        @DoctorQueueStateService.QueueItems.Count bệnh nhân
                    </div>

                </div>


                @* =============================================
                   TABLE
                   ============================================= *@

                <div class="doctor-queue-table-wrapper">

                    <table class="doctor-queue-table">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Bệnh nhân</th>
                                <th>Tuổi</th>
                                <th>Giờ hẹn</th>
                                <th>Lý do khám</th>
                                <th>Cảnh báo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>


                        <tbody>

                            @for (var index = 0; index < DoctorQueueStateService.QueueItems.Count; index++)
                            {
                                var item =
                                    DoctorQueueStateService.QueueItems[index];

                                var isFirst =
                                    index == 0;

                                var isStarting =
                                    DoctorQueueStateService.IsStartingExam &&
                                    DoctorQueueStateService.StartingAppointmentId ==
                                        item.AppointmentId;
                                <tr>

                                    @* =================================
                                       QUEUE NUMBER
                                       ================================= *@

                                    <td>

                                        <span class="doctor-queue-number">
                                            @item.QueueNumber
                                        </span>

                                    </td>


                                    @* =================================
                                       PATIENT
                                       ================================= *@

                                    <td>

                                        <div class="doctor-queue-patient">

                                            <div class="doctor-queue-patient-name">
                                                @item.PatientName
                                            </div>

                                            <div class="doctor-queue-patient-code">
                                                @item.PatientCode
                                            </div>

                                        </div>

                                    </td>


                                    @* =================================
                                       AGE
                                       ================================= *@

                                    <td>
                                        @item.Age
                                    </td>


                                    @* =================================
                                       APPOINTMENT TIME
                                       ================================= *@

                                    <td>

                                        <span class="doctor-queue-time">
                                            @item.StartTime.ToString("HH:mm")
                                        </span>

                                    </td>


                                    @* =================================
                                       REASON
                                       ================================= *@

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Reason))
                                        {
                                            <span class="doctor-queue-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @item.Reason
                                            </span>
                                        }

                                    </td>


                                    @* =================================
                                       ALLERGY WARNING
                                       ================================= *@

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.AllergyWarning))
                                        {
                                            <span class="doctor-queue-allergy">
                                                @item.AllergyWarning
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="doctor-queue-muted">
                                                —
                                            </span>
                                        }

                                    </td>

                                    @*//thao tac *@
                                    <td class="doctor-queue-action-cell">

                                        <div class="doctor-queue-actions">

                                            @if (isFirst)
                                            {
                                                <button type="button" class="doctor-queue-start-button" disabled="@isStarting"
                                                        @onclick="() => HandleStartExam(item.AppointmentId)">

                                                    @if (isStarting)
                                                    {
                                                        <span>Đang bắt đầu...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Bắt đầu khám</span>
                                                    }

                                                </button>
                                            }

                                            <button type="button" class="doctor-queue-history-button"
                                                    @onclick="() => HandleViewHistory(item.PatientId)">

                                                Lịch sử
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }

</div>

@if (DoctorQueueStateService.PatientHistoryPatientId != null)
{
    <div class="doctor-history-overlay" @onclick="ClosePatientHistory">

        <div class="doctor-history-modal" @onclick:stopPropagation="true">

            <div class="doctor-history-header">

                <div>
                    <div class="doctor-history-label">
                        PATIENT HISTORY
                    </div>

                    <h2>
                        Lịch sử khám bệnh
                    </h2>
                </div>

                <button type="button" class="doctor-history-close" @onclick="ClosePatientHistory">

                    ×

                </button>

            </div>


            @if (DoctorQueueStateService.IsLoadingPatientHistory)
            {
                <div class="doctor-history-loading">
                    Đang tải lịch sử khám...
                </div>
            }
            else if (
                !string.IsNullOrWhiteSpace(
                    DoctorQueueStateService.PatientHistoryErrorMessage))
            {
                <div class="doctor-history-error">
                    @DoctorQueueStateService.PatientHistoryErrorMessage
                </div>
            }
            else if (
                DoctorQueueStateService.PatientMedicalRecords.Count == 0)
            {
                <div class="doctor-history-empty">
                    Chưa có lịch sử khám đã hoàn tất.
                </div>
            }
            else
            {
                <div class="doctor-history-list">

                    @foreach (
                        var record
                        in DoctorQueueStateService.PatientMedicalRecords)
                    {
                        <div class="doctor-history-item">

                            <div class="doctor-history-item-header">

                                <div>
                                    <strong>
                                        @record.DoctorName
                                    </strong>

                                    <span>
                                        @record.CreatedAt.ToString(
                                            "dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <span class="doctor-history-finalized">
                                    Đã hoàn tất
                                </span>

                            </div>


                            <div class="doctor-history-content">

                                <div>
                                    <label>
                                        Chẩn đoán
                                    </label>

                                    <p>
                                        @(string.IsNullOrWhiteSpace(
                                            record.Diagnosis)
                                            ? "—"
                                            : record.Diagnosis)
                                    </p>
                                </div>


                                <div>
                                    <label>
                                        ICD-10
                                    </label>

                                    <p>
                                        @(string.IsNullOrWhiteSpace(
                                            record.Icd10Code)
                                            ? "—"
                                            : record.Icd10Code)
                                    </p>
                                </div>


                                <div>
                                    <label>
                                        Kế hoạch điều trị
                                    </label>

                                    <p>
                                        @(string.IsNullOrWhiteSpace(
                                            record.TreatmentPlan)
                                            ? "—"
                                            : record.TreatmentPlan)
                                    </p>
                                </div>


                                <div>
                                    <label>
                                        Ngày tái khám
                                    </label>

                                    <p>
                                        @(record.FollowUpDate?.ToString(
                                            "dd/MM/yyyy")
                                            ?? "—")
                                    </p>
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>
}


@code {

    // =====================================================
    // SELECTED DATE
    // =====================================================

    private DateTime _selectedDate =
        DateTime.Today;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        DoctorQueueStateService.OnChange =
            StateHasChanged;

        await DoctorQueueStateService
            .LoadQueueAsync(
                DateOnly.FromDateTime(
                    _selectedDate
                )
            );
    }

    // =====================================================
    // VIEW PATIENT HISTORY
    // =====================================================

    private async Task HandleViewHistory(
        int patientId)
    {
        await DoctorQueueStateService
            .LoadPatientHistoryAsync(
                patientId
            );
    }

    // =====================================================
    // CLOSE PATIENT HISTORY
    // =====================================================

    private void ClosePatientHistory()
    {
        DoctorQueueStateService
            .ClearPatientHistory();
    }

    // =====================================================
    // START EXAM
    // =====================================================
    // =====================================================
    // START EXAM
    // =====================================================

    private async Task HandleStartExam(
        int appointmentId)
    {
        var success =
            await DoctorQueueStateService
                .StartExamAsync(
                    appointmentId
                );


        // =================================================
        // START EXAM FAILED
        // =================================================

        if (!success)
        {
            return;
        }


        // =================================================
        // GET MEDICAL RECORD
        // =================================================

        var medicalRecord =
            DoctorQueueStateService.MedicalRecord;


        if (medicalRecord == null)
        {
            return;
        }


        // =================================================
        // NAVIGATE TO DOCTOR EXAM
        //
        // MedicalRecordDTO.Id
        // = MedicalRecord.Id
        // = MedicalRecordId
        // =================================================

        NavigationManager.NavigateTo(
            $"/doctor/exam/{medicalRecord.Id}"
        );
    }

    // =====================================================
    // DATE CHANGED
    // =====================================================

    private async Task OnDateChangedAsync()
    {
        await DoctorQueueStateService
            .LoadQueueAsync(
                DateOnly.FromDateTime(
                    _selectedDate
                )
            );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        DoctorQueueStateService.OnChange =
            null;
    }
}