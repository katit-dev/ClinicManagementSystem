@page "/doctor/medical-records"

@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]


<PageTitle>Hồ sơ bệnh án</PageTitle>


@* =====================================================
   PAGE HEADER
   ===================================================== *@

<div class="d-flex justify-content-between
            align-items-center
            mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Hồ sơ bệnh án
        </h1>

        <p class="text-secondary mb-0">
            Tra cứu hồ sơ và lịch sử khám bệnh của bệnh nhân.
        </p>

    </div>


    <a href="/doctor"
       class="btn btn-outline-secondary">

        <i class="fas fa-arrow-left me-1"></i>

        Quay lại

    </a>

</div>


@* =====================================================
   MEDICAL RECORDS
   ===================================================== *@

<div class="card shadow-sm border-0">

    <div class="card-body">

        @* =============================================
           TEMPORARY CONTENT
           Chưa kết nối API hồ sơ bệnh án
           ============================================= *@

        <div class="text-center py-5">

            <i class="fas fa-file-medical
                      fa-3x
                      text-secondary
                      mb-3">
            </i>

            <h5>
                Chưa có dữ liệu hồ sơ bệnh án
            </h5>

            <p class="text-secondary mb-0">

                Danh sách hồ sơ và lịch sử khám bệnh
                sẽ được hiển thị tại đây.

            </p>

        </div>

    </div>

</div>