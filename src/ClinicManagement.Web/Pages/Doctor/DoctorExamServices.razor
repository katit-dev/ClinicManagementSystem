@page "/doctor/exam/{MedicalRecordId:int}/services"

@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]

@using ClinicManagementSystem.Application.DTOs.MedicalRecord
@using Microsoft.AspNetCore.Authorization
@using ClinicManagementSystem.Application.Enums
@using ClinicManagementSystem.Application.DTOs.MedicalRecord
@using Microsoft.AspNetCore.Authorization

@inject DoctorExamStateService DoctorExamStateService
@inject NavigationManager NavigationManager


<PageTitle>Chỉ định cận lâm sàng</PageTitle>


<div class="doctor-exam-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="doctor-exam-header">

        <div>

            <div class="doctor-exam-label">
                CẬN LÂM SÀNG
            </div>

            <h1>
                Chỉ định cận lâm sàng
            </h1>

            <p>
                Quản lý các dịch vụ cận lâm sàng của bệnh án.
            </p>

        </div>

    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->

    @if (!string.IsNullOrWhiteSpace(
        DoctorExamStateService.ErrorMessage))
    {
        <div class="doctor-exam-message doctor-exam-error">

            @DoctorExamStateService.ErrorMessage

        </div>
    }


    <!-- =====================================================
         LOADING
         ===================================================== -->

    @if (DoctorExamStateService.IsLoading)
    {
        <div class="doctor-exam-state">

            Đang tải dữ liệu cận lâm sàng...

        </div>
    }
    else if (DoctorExamStateService.MedicalRecord == null)
    {
        <div class="doctor-exam-state">

            Không tìm thấy bệnh án.

        </div>
    }
    else
    {
        var record =
            DoctorExamStateService.MedicalRecord;


        <!-- =====================================================
             MEDICAL RECORD SERVICES
             ===================================================== -->

        <section class="doctor-exam-card">

            <!-- =================================================
                 CARD HEADER
                 ================================================= -->

            <div class="doctor-exam-card-header">

                <div>

                    <div class="doctor-exam-card-label">
                        BỆNH ÁN
                    </div>

                    <h2>
                        #@record.Id
                    </h2>

                </div>

            </div>


            <div class="doctor-exam-content">

                <div class="doctor-exam-section">

                    <!-- =============================================
                         SECTION HEADER
                         ============================================= -->

                    <div class="doctor-exam-section-header">

                        <div class="doctor-exam-section-title">
                            Dịch vụ cận lâm sàng
                        </div>

                        <button type="button" class="doctor-exam-primary-button" @onclick="OpenAddServiceModal">

                            + Thêm chỉ định

                        </button>

                    </div>


                    <!-- =============================================
                         EMPTY
                         ============================================= -->

                    @if (record.Services == null ||
                         record.Services.Count == 0)
                    {
                        <div class="doctor-exam-state">

                            Chưa có chỉ định cận lâm sàng.

                        </div>
                    }
                    else
                    {
                        <!-- =========================================
                             SERVICES TABLE
                             ========================================= -->

                        <div class="doctor-exam-table-wrapper">

                            <table class="doctor-exam-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Mã chỉ định
                                        </th>

                                        <th>
                                            Dịch vụ
                                        </th>

                                        <th>
                                            Số lượng
                                        </th>

                                        <th>
                                            Đơn giá
                                        </th>

                                        <th>
                                            Trạng thái
                                        </th>

                                        <th>
                                            Ngày chỉ định
                                        </th>

                                        <th>
                                            Kết quả
                                        </th>

                                        <th>
                                            Thao tác
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (
                                        var service
                                        in record.Services)
                                    {
                                        <tr>

                                            <!-- =================================
                                                 ID
                                                 ================================= -->

                                            <td>
                                                #@service.Id
                                            </td>


                                            <!-- =================================
                                                 SERVICE NAME
                                                 ================================= -->

                                            <td>

                                                <strong>
                                                    @service.ServiceName
                                                </strong>

                                            </td>


                                            <!-- =================================
                                                 QUANTITY
                                                 ================================= -->

                                            <td>
                                                @service.Quantity
                                            </td>


                                            <!-- =================================
                                                 PRICE
                                                 ================================= -->

                                            <td>
                                                @service.UnitPriceSnapshot.ToString("N0") đ
                                            </td>


                                            <!-- =================================
                                                 STATUS
                                                 ================================= -->

                                            <td>
                                                <span class="@GetServiceStatusClass(service.Status)">
                                                    @GetServiceStatusText(service.Status)
                                                </span>
                                            </td>


                                            <!-- =================================
                                                 ORDERED AT
                                                 ================================= -->

                                            <td>
                                                @service.OrderedAt.ToString(
                                                    "dd/MM/yyyy HH:mm")
                                            </td>


                                            <!-- =================================
                                                 RESULT
                                                 ================================= -->

                                            <td>

                                                @if (service.Result == null)
                                                {
                                                    <span>
                                                        Chưa có kết quả
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        Đã có kết quả
                                                    </span>
                                                }

                                            </td>

                                            <td>

                                                @if (service.Status ==
                                                    (byte)MedicalRecordServiceStatus.Ordered)
                                                {
                                                    <button type="button" class="doctor-exam-danger-button"
                                                            @onclick="() => OpenCancelServiceModal(service)">

                                                        Hủy

                                                    </button>
                                                }
                                                else
                                                {
                                                    <span>—</span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="doctor-exam-actions">

                    <button type="button" class="doctor-exam-secondary-button" @onclick="GoBack">

                        Quay lại khám bệnh

                    </button>

                </div>

            </div>

        </section>
    }


    <!-- =====================================================
         ADD SERVICE MODAL
         ===================================================== -->

    @if (IsAddServiceModalOpen)
    {
        <div class="doctor-exam-modal-backdrop">

            <div class="doctor-exam-modal">

                <!-- =================================================
                     MODAL HEADER
                     ================================================= -->

                <div class="doctor-exam-modal-header">

                    <div>

                        <span>
                            CHỈ ĐỊNH CẬN LÂM SÀNG
                        </span>

                        <h3>
                            Thêm chỉ định
                        </h3>

                    </div>


                    <button type="button" class="doctor-exam-modal-close" @onclick="CloseAddServiceModal">

                        ×

                    </button>

                </div>


                <!-- =================================================
                     MODAL BODY
                     ================================================= -->

                <div class="doctor-exam-modal-body">

                    <!-- =============================================
                         ERROR
                         ============================================= -->

                    @if (!string.IsNullOrWhiteSpace(
                        AddServiceErrorMessage))
                    {
                        <div class="doctor-exam-message doctor-exam-error">

                            @AddServiceErrorMessage

                        </div>
                    }


                    <!-- =============================================
                         SERVICE
                         ============================================= -->

                    <div class="doctor-exam-form-group">

                        <label for="service">
                            Dịch vụ
                        </label>

                        <select id="service" class="doctor-exam-form-control" @bind="SelectedServiceId">

                            <option value="0">
                                Chọn dịch vụ
                            </option>

                            @foreach (
                                var service
                                in DoctorExamStateService.AvailableServices)
                            {
                                <option value="@service.Id">
                                    @service.Name
                                </option>
                            }

                        </select>

                    </div>


                    <!-- =============================================
                         QUANTITY
                         ============================================= -->

                    <div class="doctor-exam-form-group">

                        <label for="quantity">
                            Số lượng
                        </label>

                        <input id="quantity" type="number" min="1" class="doctor-exam-form-control"
                               @bind="ServiceQuantity" />

                    </div>

                </div>


                <!-- =================================================
                     MODAL FOOTER
                     ================================================= -->

                <div class="doctor-exam-modal-footer">

                    <button type="button" class="doctor-exam-secondary-button" @onclick="CloseAddServiceModal">

                        Hủy

                    </button>


                    <button type="button" class="doctor-exam-primary-button" @onclick="AddService"
                            disabled="@DoctorExamStateService.IsSubmitting">

                        @(DoctorExamStateService.IsSubmitting
                            ? "Đang thêm..."
                            : "Thêm")

                    </button>

                </div>

            </div>

        </div>
    }

    @if (IsCancelServiceModalOpen &&
     SelectedServiceToCancel != null)
    {
        <div class="doctor-exam-modal-backdrop">

            <div class="doctor-exam-modal">

                <!-- =================================================
                 MODAL HEADER
                 ================================================= -->

                <div class="doctor-exam-modal-header">

                    <div>
                        <h3>
                            Hủy chỉ định
                        </h3>

                    </div>


                    <button type="button" class="doctor-exam-modal-close" @onclick="CloseCancelServiceModal">

                        ×

                    </button>

                </div>


                <!-- =================================================
                 MODAL BODY
                 ================================================= -->

                <div class="doctor-exam-modal-body">

                    @if (!string.IsNullOrWhiteSpace(
                        CancelServiceErrorMessage))
                    {
                        <div class="doctor-exam-message doctor-exam-error">

                            @CancelServiceErrorMessage

                        </div>
                    }


                    <p class="doctor-exam-confirm-text">

                        Bạn có chắc muốn hủy chỉ định

                        <strong>
                            @SelectedServiceToCancel.ServiceName
                        </strong>

                        không?

                    </p>


                    <div class="doctor-exam-confirm-info">

                        <div>
                            Mã chỉ định:
                            <strong>
                                #@SelectedServiceToCancel.Id
                            </strong>
                        </div>

                        <div>
                            Số lượng:
                            <strong>
                                @SelectedServiceToCancel.Quantity
                            </strong>
                        </div>

                    </div>

                </div>


                <!-- =================================================
                 MODAL FOOTER
                 ================================================= -->

                <div class="doctor-exam-modal-footer">

                    <button type="button" class="doctor-exam-secondary-button" @onclick="CloseCancelServiceModal">

                        Không

                    </button>


                    <button type="button" class="doctor-exam-danger-button" @onclick="CancelService"
                            disabled="@DoctorExamStateService.IsSubmitting">

                        @(DoctorExamStateService.IsSubmitting
                            ? "Đang hủy..."
                            : "Hủy chỉ định")

                    </button>

                </div>

            </div>

        </div>
    }

</div>


@code
{

    // =====================================================
    // ROUTE
    // =====================================================

    [Parameter]
    public int MedicalRecordId { get; set; }


    // =====================================================
    // ADD SERVICE MODAL
    // =====================================================

    private bool IsAddServiceModalOpen;

    private int SelectedServiceId;

    private int ServiceQuantity = 1;

    private string AddServiceErrorMessage = string.Empty;

    // =====================================================
    // CANCEL SERVICE MODAL
    // =====================================================

    private bool IsCancelServiceModalOpen;

    private MedicalRecordServiceDTO? SelectedServiceToCancel;

    private string CancelServiceErrorMessage = string.Empty;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnParametersSetAsync()
    {
        await DoctorExamStateService
            .LoadMedicalRecordAsync(
                MedicalRecordId
            );

        await DoctorExamStateService
            .LoadAvailableServicesAsync();
    }

    // =====================================================
    // CANCEL SERVICE
    // =====================================================

    private async Task CancelService()
    {
        CancelServiceErrorMessage =
            string.Empty;

        if (SelectedServiceToCancel == null)
        {
            CancelServiceErrorMessage =
                "Không xác định được chỉ định.";

            return;
        }

        var success =
            await DoctorExamStateService
                .CancelMedicalRecordServiceAsync(
                    SelectedServiceToCancel.Id
                );

        if (!success)
        {
            CancelServiceErrorMessage =
                DoctorExamStateService
                    .ActionErrorMessage;

            return;
        }

        CloseCancelServiceModal();
    }


    // =====================================================
    // ADD SERVICE
    // =====================================================

    private async Task AddService()
    {
        AddServiceErrorMessage =
            string.Empty;


        var success =
            await DoctorExamStateService
                .AddMedicalRecordServiceAsync(
                    MedicalRecordId,
                    SelectedServiceId,
                    ServiceQuantity
                );


        if (!success)
        {
            AddServiceErrorMessage =
                DoctorExamStateService
                    .ActionErrorMessage;

            return;
        }


        // =================================================
        // CLOSE MODAL AFTER SUCCESS
        // =================================================

        CloseAddServiceModal();
    }


    // =====================================================
    // OPEN ADD SERVICE MODAL
    // =====================================================

    private void OpenAddServiceModal()
    {
        SelectedServiceId = 0;

        ServiceQuantity = 1;

        AddServiceErrorMessage =
            string.Empty;

        IsAddServiceModalOpen = true;
    }


    // =====================================================
    // CLOSE ADD SERVICE MODAL
    // =====================================================

    private void CloseAddServiceModal()
    {
        IsAddServiceModalOpen = false;

        SelectedServiceId = 0;

        ServiceQuantity = 1;

        AddServiceErrorMessage =
            string.Empty;
    }

    // =====================================================
    // OPEN CANCEL SERVICE MODAL
    // =====================================================

    private void OpenCancelServiceModal(
        MedicalRecordServiceDTO service)
    {
        SelectedServiceToCancel =
            service;

        CancelServiceErrorMessage =
            string.Empty;

        IsCancelServiceModalOpen =
            true;
    }


    // =====================================================
    // CLOSE CANCEL SERVICE MODAL
    // =====================================================

    private void CloseCancelServiceModal()
    {
        IsCancelServiceModalOpen =
            false;

        SelectedServiceToCancel =
            null;

        CancelServiceErrorMessage =
            string.Empty;
    }

    private static string GetServiceStatusText(byte status)
    {
        return status switch
        {
            (byte)MedicalRecordServiceStatus.Ordered
                => "Đã chỉ định",

            (byte)MedicalRecordServiceStatus.InProgress
                => "Đang thực hiện",

            (byte)MedicalRecordServiceStatus.Completed
                => "Đã hoàn thành",

            (byte)MedicalRecordServiceStatus.Cancelled
                => "Đã hủy",

            _ => "Không xác định"
        };
    }

    private static string GetServiceStatusClass(byte status)
    {
        return status switch
        {
            (byte)MedicalRecordServiceStatus.Ordered
                => "doctor-exam-status doctor-exam-status-ordered",

            (byte)MedicalRecordServiceStatus.InProgress
                => "doctor-exam-status doctor-exam-status-in-progress",

            (byte)MedicalRecordServiceStatus.Completed
                => "doctor-exam-status doctor-exam-status-completed",

            (byte)MedicalRecordServiceStatus.Cancelled
                => "doctor-exam-status doctor-exam-status-cancelled",

            _ => "doctor-exam-status"
        };
    }


    // =====================================================
    // BACK
    // =====================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            $"/doctor/exam/{MedicalRecordId}"
        );
    }

}