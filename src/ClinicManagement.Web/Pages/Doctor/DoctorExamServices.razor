@page "/doctor/exam/{MedicalRecordId:int}/services"
@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]

@using ClinicManagementSystem.Application.DTOs.MedicalRecord
@using Microsoft.AspNetCore.Authorization

@inject DoctorExamStateService DoctorExamStateService
@inject NavigationManager NavigationManager

@implements IDisposable


<PageTitle>Chỉ định cận lâm sàng</PageTitle>


<div class="doctor-exam-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="doctor-exam-header">

        <div>

            <div class="doctor-exam-label">
                VC-14
            </div>

            <h1>
                Chỉ định cận lâm sàng
            </h1>

            <p>
                Quản lý các dịch vụ cận lâm sàng của bệnh án.
            </p>

        </div>

    </div>


    <!-- =====================================================
         ERROR
         ===================================================== -->

    @if (!string.IsNullOrWhiteSpace(
        DoctorExamStateService.ErrorMessage))
    {
        <div class="doctor-exam-message doctor-exam-error">

            @DoctorExamStateService.ErrorMessage

        </div>
    }


    <!-- =====================================================
         LOADING
         ===================================================== -->

    @if (DoctorExamStateService.IsLoading)
    {
        <div class="doctor-exam-state">

            Đang tải thông tin bệnh án...

        </div>
    }
    else if (DoctorExamStateService.MedicalRecord == null)
    {
        <div class="doctor-exam-state">

            Không tìm thấy thông tin bệnh án.

        </div>
    }
    else
    {
        var record =
            DoctorExamStateService.MedicalRecord;


        <!-- =================================================
             MEDICAL RECORD
             ================================================= -->

        <section class="doctor-exam-card">

            <!-- =================================================
                 CARD HEADER
                 ================================================= -->

            <div class="doctor-exam-card-header">

                <div>

                    <div class="doctor-exam-card-label">
                        BỆNH ÁN
                    </div>

                    <h2>
                        #@record.Id
                    </h2>

                </div>

            </div>


            <div class="doctor-exam-content">

                <!-- =================================================
                     BASIC INFORMATION
                     ================================================= -->

                <div class="doctor-exam-section">

                    <div class="doctor-exam-section-title">
                        Thông tin bệnh án
                    </div>


                    <div class="doctor-exam-grid">

                        <div class="doctor-exam-field">

                            <label>
                                Bác sĩ
                            </label>

                            <div>
                                @record.DoctorName
                            </div>

                        </div>


                        <div class="doctor-exam-field">

                            <label>
                                Mã lịch hẹn
                            </label>

                            <div>
                                @record.AppointmentId
                            </div>

                        </div>


                        <div class="doctor-exam-field">

                            <label>
                                Triệu chứng
                            </label>

                            <div>
                                @(string.IsNullOrWhiteSpace(
                                    record.Symptoms)
                                    ? "—"
                                    : record.Symptoms)
                            </div>

                        </div>


                        <div class="doctor-exam-field">

                            <label>
                                Chẩn đoán
                            </label>

                            <div>
                                @(string.IsNullOrWhiteSpace(
                                    record.Diagnosis)
                                    ? "—"
                                    : record.Diagnosis)
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SERVICES
                     ================================================= -->

                <div class="doctor-exam-section">

                    <div class="doctor-exam-section-title">
                        Dịch vụ cận lâm sàng
                    </div>


                    <div class="doctor-exam-state">

                        Bước tiếp theo sẽ hiển thị các chỉ định
                        cận lâm sàng tại đây.

                    </div>

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="doctor-exam-actions">

                    <button
                        type="button"
                        class="doctor-exam-secondary-button"
                        @onclick="GoBack">

                        Quay lại khám bệnh

                    </button>

                </div>

            </div>

        </section>
    }

</div>


@code {

    // =====================================================
    // ROUTE
    // =====================================================

    [Parameter]
    public int MedicalRecordId { get; set; }


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override void OnInitialized()
    {
        DoctorExamStateService.OnChange +=
            HandleStateChanged;
    }


    protected override async Task OnParametersSetAsync()
    {
        await DoctorExamStateService
            .LoadMedicalRecordAsync(
                MedicalRecordId
            );
    }


    // =====================================================
    // STATE CHANGE
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // BACK
    // =====================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            $"/doctor/exam/{MedicalRecordId}"
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        DoctorExamStateService.OnChange -=
            HandleStateChanged;
    }

}