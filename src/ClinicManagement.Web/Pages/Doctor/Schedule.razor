@page "/doctor/schedule"

@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]


<PageTitle>Lịch làm việc</PageTitle>


@* =====================================================
   PAGE HEADER
   ===================================================== *@

<div class="d-flex justify-content-between
            align-items-center
            mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Lịch làm việc
        </h1>

        <p class="text-secondary mb-0">
            Xem lịch làm việc và lịch khám của bác sĩ.
        </p>

    </div>


    <a href="/doctor"
       class="btn btn-outline-secondary">

        <i class="fas fa-arrow-left me-1"></i>

        Quay lại

    </a>

</div>


@* =====================================================
   WORKING SCHEDULE
   ===================================================== *@

<div class="card shadow-sm border-0">

    <div class="card-body">

        @* =============================================
           TEMPORARY CONTENT
           Chưa kết nối API lịch làm việc
           ============================================= *@

        <div class="text-center py-5">

            <i class="fas fa-calendar-alt
                      fa-3x
                      text-secondary
                      mb-3">
            </i>

            <h5>
                Chưa có dữ liệu lịch làm việc
            </h5>

            <p class="text-secondary mb-0">

                Lịch làm việc và lịch khám
                của bác sĩ sẽ được hiển thị tại đây.

            </p>

        </div>

    </div>

</div>