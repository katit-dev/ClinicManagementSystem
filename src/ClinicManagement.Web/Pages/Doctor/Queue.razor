@page "/doctor/queue"

@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]


<PageTitle>Hàng chờ khám</PageTitle>


@* =====================================================
   PAGE HEADER
   ===================================================== *@

<div class="d-flex justify-content-between
            align-items-center
            mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Hàng chờ khám
        </h1>

        <p class="text-secondary mb-0">
            Danh sách bệnh nhân đang chờ bác sĩ khám.
        </p>

    </div>


    <a href="/doctor"
       class="btn btn-outline-secondary">

        <i class="fas fa-arrow-left me-1"></i>

        Quay lại

    </a>

</div>


@* =====================================================
   PATIENT QUEUE
   ===================================================== *@

<div class="card shadow-sm border-0">

    <div class="card-body">

        @* =============================================
           TEMPORARY CONTENT
           Chưa kết nối API
           ============================================= *@

        <div class="text-center py-5">

            <i class="fas fa-users
                      fa-3x
                      text-secondary
                      mb-3">
            </i>

            <h5>
                Chưa có dữ liệu hàng chờ
            </h5>

            <p class="text-secondary mb-0">

                Danh sách bệnh nhân chờ khám
                sẽ được hiển thị tại đây.

            </p>

        </div>

    </div>

</div>