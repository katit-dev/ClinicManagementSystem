@page "/doctor/exam/{MedicalRecordId:int}"

@layout HomePageMaster

@attribute [Authorize(Roles = "Doctor")]

@using ClinicManagementSystem.Application.DTOs.MedicalRecord
@using ClinicManagementSystem.Application.Enums
@using Microsoft.AspNetCore.Authorization

@inject DoctorExamStateService DoctorExamStateService

@implements IDisposable


<PageTitle>Khám bệnh</PageTitle>


<div class="doctor-exam-page">

    @* =====================================================
       HEADER
       ===================================================== *@

    <div class="doctor-exam-header">

        <div>

            <div class="doctor-exam-label">
                KHÁM BỆNH
            </div>

            <h1>
                Màn hình khám bệnh
            </h1>

            <p>
                Thực hiện khám và cập nhật bệnh án của bệnh nhân.
            </p>

        </div>

    </div>


    @* =====================================================
       ERROR
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(
        DoctorExamStateService.ErrorMessage))
    {
        <div class="doctor-exam-message doctor-exam-error">

            @DoctorExamStateService.ErrorMessage

        </div>
    }


    @* =====================================================
       ACTION SUCCESS
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(
        DoctorExamStateService.ActionMessage))
    {
        <div class="doctor-exam-message doctor-exam-success">

            @DoctorExamStateService.ActionMessage

        </div>
    }


    @* =====================================================
       ACTION ERROR
       ===================================================== *@

    @if (!string.IsNullOrWhiteSpace(
        DoctorExamStateService.ActionErrorMessage))
    {
        <div class="doctor-exam-message doctor-exam-error">

            @DoctorExamStateService.ActionErrorMessage

        </div>
    }


    @* =====================================================
       LOADING
       ===================================================== *@

    @if (DoctorExamStateService.IsLoading)
    {
        <div class="doctor-exam-state">

            Đang tải thông tin bệnh án...

        </div>
    }
    else if (DoctorExamStateService.MedicalRecord == null)
    {
        <div class="doctor-exam-state">

            Không tìm thấy thông tin bệnh án.

        </div>
    }
    else
    {
        var record =
            DoctorExamStateService.MedicalRecord;


        @* =================================================
           MEDICAL RECORD
           ================================================= *@

        <section class="doctor-exam-card">


            @* =================================================
               CARD HEADER
               ================================================= *@

            <div class="doctor-exam-card-header">

                <div>

                    <div class="doctor-exam-card-label">
                        BỆNH ÁN
                    </div>

                    <h2>
                        #@record.Id
                    </h2>

                </div>


                <div class="doctor-exam-status">

                    @if (IsFinalized)
                    {
                        <span class="doctor-exam-status-finalized">
                            Đã chốt
                        </span>
                    }
                    else
                    {
                        <span class="doctor-exam-status-draft">
                            Nháp
                        </span>
                    }

                </div>

            </div>


            <div class="doctor-exam-content">


                @* =================================================
                   BASIC INFORMATION
                   ================================================= *@

                <div class="doctor-exam-section">

                    <div class="doctor-exam-section-title">
                        Thông tin khám
                    </div>


                    <div class="doctor-exam-grid">


                        @* =================================================
                           DOCTOR
                           ================================================= *@

                        <div class="doctor-exam-field">

                            <label>
                                Bác sĩ
                            </label>

                            <div>
                                @record.DoctorName
                            </div>

                        </div>


                        @* =================================================
                           APPOINTMENT
                           ================================================= *@

                        <div class="doctor-exam-field">

                            <label>
                                Mã lịch hẹn
                            </label>

                            <div>
                                @record.AppointmentId
                            </div>

                        </div>


                        @* =================================================
                           SYMPTOMS
                           ================================================= *@

                        <div class="doctor-exam-form-group doctor-exam-field-full">

                            <label>
                                Triệu chứng
                            </label>

                            <textarea class="doctor-exam-input doctor-exam-textarea" rows="4" @bind="Form.Symptoms"
                                      disabled="@IsFinalized">
                            </textarea>

                        </div>


                        @* =================================================
                           DIAGNOSIS
                           ================================================= *@

                        <div class="doctor-exam-form-group doctor-exam-field-full">

                            <label>

                                Chẩn đoán

                                <span class="required">
                                    *
                                </span>

                            </label>

                            <textarea class="doctor-exam-input doctor-exam-textarea" rows="4" @bind="Form.Diagnosis"
                                      disabled="@IsFinalized">
                            </textarea>

                        </div>


                        @* =================================================
                           ICD10
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Mã ICD-10
                            </label>

                            <input type="text" class="doctor-exam-input" @bind="Form.Icd10Code" disabled="@IsFinalized" />

                        </div>


                        @* =================================================
                           FOLLOW UP
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Ngày tái khám
                            </label>

                            <input type="date" class="doctor-exam-input" @bind="Form.FollowUpDate"
                                   disabled="@IsFinalized" />

                        </div>


                        @* =================================================
                           TREATMENT PLAN
                           ================================================= *@

                        <div class="doctor-exam-form-group doctor-exam-field-full">

                            <label>
                                Hướng điều trị
                            </label>

                            <textarea class="doctor-exam-input doctor-exam-textarea" rows="4" @bind="Form.TreatmentPlan"
                                      disabled="@IsFinalized">
                            </textarea>

                        </div>


                        @* =================================================
                           NOTE
                           ================================================= *@

                        <div class="doctor-exam-form-group doctor-exam-field-full">

                            <label>
                                Ghi chú
                            </label>

                            <textarea class="doctor-exam-input doctor-exam-textarea" rows="3" @bind="Form.Note"
                                      disabled="@IsFinalized">
                            </textarea>

                        </div>

                    </div>

                </div>


                @* =================================================
                   PATIENT VITAL
                   ================================================= *@

                <div class="doctor-exam-section">

                    <div class="doctor-exam-section-title">
                        Sinh hiệu
                    </div>


                    <div class="doctor-exam-vital-form-grid">


                        @* =================================================
                           TEMPERATURE
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Nhiệt độ
                            </label>

                            <div class="doctor-exam-input-unit">

                                <input type="number" step="0.1" class="doctor-exam-input" @bind="Form.Temperature"
                                       disabled="@IsFinalized" />

                                <span>
                                    °C
                                </span>

                            </div>

                        </div>


                        @* =================================================
                           PULSE
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Mạch
                            </label>

                            <div class="doctor-exam-input-unit">

                                <input type="number" class="doctor-exam-input" @bind="Form.Pulse" disabled="@IsFinalized" />

                                <span>
                                    bpm
                                </span>

                            </div>

                        </div>


                        @* =================================================
                           BLOOD PRESSURE
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Huyết áp
                            </label>

                            <input type="text" class="doctor-exam-input" placeholder="120/80" @bind="Form.BloodPressure"
                                   disabled="@IsFinalized" />

                        </div>


                        @* =================================================
                           WEIGHT
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Cân nặng
                            </label>

                            <div class="doctor-exam-input-unit">

                                <input type="number" step="0.1" class="doctor-exam-input" @bind="Form.Weight"
                                       disabled="@IsFinalized" />

                                <span>
                                    kg
                                </span>

                            </div>

                        </div>


                        @* =================================================
                           HEIGHT
                           ================================================= *@

                        <div class="doctor-exam-form-group">

                            <label>
                                Chiều cao
                            </label>

                            <div class="doctor-exam-input-unit">

                                <input type="number" step="0.1" class="doctor-exam-input" @bind="Form.Height"
                                       disabled="@IsFinalized" />

                                <span>
                                    cm
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                @* =================================================
                   ACTIONS
                   ================================================= *@

                <div class="doctor-exam-actions">


                    @* =================================================
                       CLS
                       ================================================= *@

                    <button type="button" class="doctor-exam-secondary-button" disabled="@IsFinalized">

                        Chỉ định cận lâm sàng

                    </button>


                    @* =================================================
                       PRESCRIPTION
                       ================================================= *@

                    <button type="button" class="doctor-exam-secondary-button" disabled="@IsFinalized">

                        Kê đơn thuốc

                    </button>


                    @* =================================================
                       SAVE DRAFT
                       ================================================= *@

                    <button type="button" class="doctor-exam-primary-button"
                            disabled="@(IsFinalized || DoctorExamStateService.IsSubmitting)" @onclick="SaveDraftAsync">

                        @(DoctorExamStateService.IsSubmitting
                            ? "Đang lưu..."
                            : "Lưu nháp")

                    </button>


                    @* =================================================
                       FINALIZE
                       ================================================= *@

                    <button type="button" class="doctor-exam-finalize-button"
                            disabled="@(IsFinalized || DoctorExamStateService.IsFinalizing)"
                            @onclick="FinalizeMedicalRecordAsync">

                        @(DoctorExamStateService.IsFinalizing
                            ? "Đang chốt..."
                            : "Hoàn tất & chốt bệnh án")

                    </button>

                </div>

            </div>

        </section>
    }

</div>


@code {

    // =====================================================
    // ROUTE
    // =====================================================

    [Parameter]
    public int MedicalRecordId { get; set; }


    // =====================================================
    // FORM
    // =====================================================

    private readonly DoctorExamFormModel Form = new();


    // =====================================================
    // FINALIZED
    // =====================================================

    private bool IsFinalized =>
        DoctorExamStateService.MedicalRecord != null &&
        DoctorExamStateService.MedicalRecord.Status ==
            (byte)MedicalRecordStatus.Finalized;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override void OnInitialized()
    {
        DoctorExamStateService.OnChange +=
            HandleStateChanged;
    }


    protected override async Task OnParametersSetAsync()
    {
        var loaded =
            await DoctorExamStateService
                .LoadMedicalRecordAsync(
                    MedicalRecordId
                );

        if (loaded &&
            DoctorExamStateService.MedicalRecord != null)
        {
            MapMedicalRecordToForm(
                DoctorExamStateService.MedicalRecord
            );
        }
    }

    // =====================================================
    // FINALIZE MEDICAL RECORD
    // =====================================================

    private async Task FinalizeMedicalRecordAsync()
    {
        // =================================================
        // DO NOT FINALIZE AGAIN
        // =================================================

        if (IsFinalized)
        {
            return;
        }


        // =================================================
        // CALL STATE SERVICE
        // =================================================

        await DoctorExamStateService
            .FinalizeMedicalRecordAsync(
                MedicalRecordId
            );
    }


    // =====================================================
    // SAVE DRAFT
    // =====================================================

    private async Task SaveDraftAsync()
    {
        // =================================================
        // DO NOT SAVE FINALIZED RECORD
        // =================================================

        if (IsFinalized)
        {
            return;
        }


        // =================================================
        // CREATE REQUEST
        // =================================================

        var request =
            new MedicalRecordDraftRequestDTO
            {
                Symptoms =
                    Form.Symptoms,

                Diagnosis =
                    Form.Diagnosis,

                Icd10Code =
                    Form.Icd10Code,

                TreatmentPlan =
                    Form.TreatmentPlan,

                Note =
                    Form.Note,

                FollowUpDate =
                    Form.FollowUpDate,

                Vitals =
                    BuildVitalRequest()
            };


        // =================================================
        // CALL STATE SERVICE
        // =================================================

        var success =
            await DoctorExamStateService
                .SaveDraftAsync(request);


        // =================================================
        // UPDATE FORM FROM RESPONSE
        // =================================================

        if (success &&
            DoctorExamStateService.MedicalRecord != null)
        {
            MapMedicalRecordToForm(
                DoctorExamStateService.MedicalRecord
            );
        }
    }


    // =====================================================
    // BUILD PATIENT VITAL REQUEST
    // =====================================================

    private PatientVitalRequestDTO? BuildVitalRequest()
    {
        var existingVital =
            DoctorExamStateService
                .MedicalRecord?
                .Vital;


        // =================================================
        // CHECK VITAL INPUT
        // =================================================

        var hasVitalInput =
            Form.Temperature.HasValue ||
            Form.Pulse.HasValue ||
            !string.IsNullOrWhiteSpace(
                Form.BloodPressure
            ) ||
            Form.Weight.HasValue ||
            Form.Height.HasValue;


        // =================================================
        // NO VITAL
        // =================================================

        if (!hasVitalInput &&
            existingVital == null)
        {
            return null;
        }


        // =================================================
        // BUILD REQUEST
        // =================================================

        return new PatientVitalRequestDTO
        {
            Temperature =
                Form.Temperature,

            Pulse =
                Form.Pulse,

            BloodPressure =
                Form.BloodPressure,

            Weight =
                Form.Weight,

            Height =
                Form.Height
        };
    }


    // =====================================================
    // MAP RESPONSE → FORM
    // =====================================================

    private void MapMedicalRecordToForm(
        MedicalRecordExamDTO record)
    {
        Form.Symptoms =
            record.Symptoms;

        Form.Diagnosis =
            record.Diagnosis;

        Form.Icd10Code =
            record.Icd10Code;

        Form.TreatmentPlan =
            record.TreatmentPlan;

        Form.Note =
            record.Note;

        Form.FollowUpDate =
            record.FollowUpDate;


        // =================================================
        // VITAL EXISTS
        // =================================================

        if (record.Vital != null)
        {
            Form.Temperature =
                record.Vital.Temperature;

            Form.Pulse =
                record.Vital.Pulse;

            Form.BloodPressure =
                record.Vital.BloodPressure;

            Form.Weight =
                record.Vital.Weight;

            Form.Height =
                record.Vital.Height;
        }
        else
        {
            Form.Temperature = null;

            Form.Pulse = null;

            Form.BloodPressure = null;

            Form.Weight = null;

            Form.Height = null;
        }
    }


    // =====================================================
    // STATE CHANGE
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        DoctorExamStateService.OnChange -=
            HandleStateChanged;
    }


    // =====================================================
    // FORM MODEL
    // =====================================================

    private sealed class DoctorExamFormModel
    {
        public string? Symptoms { get; set; }

        public string? Diagnosis { get; set; }

        public string? Icd10Code { get; set; }

        public string? TreatmentPlan { get; set; }

        public string? Note { get; set; }

        public DateOnly? FollowUpDate { get; set; }

        public decimal? Temperature { get; set; }

        public int? Pulse { get; set; }

        public string? BloodPressure { get; set; }

        public decimal? Weight { get; set; }

        public decimal? Height { get; set; }
    }

}