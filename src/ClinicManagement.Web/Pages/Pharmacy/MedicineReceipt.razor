@page "/pharmacy/receipt"

@layout HomePageMaster

@attribute [Authorize(Roles = "Pharmacist")]

@using ClinicManagementSystem.Application.DTOs
@using ClinicManagementSystem.Application.DTOs.Pharmacy
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web


@inject MedicineReceiptStateService MedicineReceiptStateService

@inject NavigationManager NavigationManager


@implements IDisposable


<PageTitle>
    Nhập thuốc
</PageTitle>


<div class="medicine-receipt-page">

    <div class="medicine-receipt-container">


        @* =====================================================
           BACK
           ===================================================== *@

        <button
            type="button"
            class="medicine-receipt-back-button"
            @onclick="GoBack">

            <i class="fas fa-arrow-left"></i>

            Quay lại kho thuốc

        </button>


        @* =====================================================
           HEADER
           ===================================================== *@

        <div class="medicine-receipt-header">

            <div class="medicine-receipt-label">
                PHARMACY · MEDICINE RECEIPT
            </div>

            <h1>
                Nhập thuốc
            </h1>

            <p>
                Ghi nhận thuốc nhập vào kho và thông tin lô thuốc.
            </p>

        </div>


        @* =====================================================
           ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ErrorMessage))
        {
            <div class="medicine-receipt-error">

                <i class="fas fa-exclamation-circle"></i>

                @MedicineReceiptStateService.ErrorMessage

            </div>
        }


        @* =====================================================
           ACTION ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ActionErrorMessage))
        {
            <div class="medicine-receipt-error">

                <i class="fas fa-exclamation-circle"></i>

                @MedicineReceiptStateService.ActionErrorMessage

            </div>
        }


        @* =====================================================
           SUCCESS
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ActionMessage))
        {
            <div class="medicine-receipt-success">

                <i class="fas fa-check-circle"></i>

                <div>

                    <strong>
                        @MedicineReceiptStateService.ActionMessage
                    </strong>

                    <div>
                        Thuốc đã được cập nhật vào kho.
                    </div>

                </div>


                <button
                    type="button"
                    class="medicine-receipt-view-inventory-button"
                    @onclick="GoToInventory">

                    Xem kho thuốc

                </button>

            </div>
        }


        <div class="medicine-receipt-layout">


            @* =================================================
               RECEIPT INFORMATION
               ================================================= *@

            <section class="medicine-receipt-card">

                <div class="medicine-receipt-card-header">

                    <div>

                        <div class="medicine-receipt-card-label">
                            RECEIPT INFORMATION
                        </div>

                        <h2>
                            Thông tin nhập thuốc
                        </h2>

                    </div>

                </div>


                <div class="medicine-receipt-card-body">


                    @* =============================================
                       SUPPLIER
                       ============================================= *@

                    <div class="medicine-receipt-field">

                        <label>
                            Nhà cung cấp
                        </label>

                        <input
                            type="text"
                            class="medicine-receipt-input"
                            @bind="
                                MedicineReceiptStateService.SupplierName"
                            @bind:event="oninput"
                            maxlength="255"
                            placeholder="Nhập tên nhà cung cấp..." />

                    </div>


                    @* =============================================
                       REFERENCE CODE
                       ============================================= *@

                    <div class="medicine-receipt-field">

                        <label>
                            Số hóa đơn / mã tham chiếu
                        </label>

                        <input
                            type="text"
                            class="medicine-receipt-input"
                            @bind="
                                MedicineReceiptStateService.ReferenceCode"
                            @bind:event="oninput"
                            maxlength="100"
                            placeholder="Ví dụ: HD-DHG-8891" />

                    </div>


                </div>

            </section>


            @* =================================================
               MEDICINE BATCH
               ================================================= *@

            <section class="medicine-receipt-card">

                <div class="medicine-receipt-card-header">

                    <div>

                        <div class="medicine-receipt-card-label">
                            MEDICINE BATCH
                        </div>

                        <h2>
                            Thông tin thuốc nhập
                        </h2>

                    </div>

                </div>


                <div class="medicine-receipt-card-body">


                    @* =============================================
                       SEARCH MEDICINE
                       ============================================= *@

                    <div class="medicine-receipt-field">

                        <label>
                            Tìm thuốc
                        </label>


                        <div class="medicine-search-row">

                            <input
                                type="text"
                                class="medicine-receipt-input"
                                @bind="
                                    MedicineReceiptStateService.SearchKeyword"
                                @bind:event="oninput"
                                @onkeydown="HandleSearchKeyDown"
                                placeholder="Nhập tên, mã hoặc hoạt chất..." />


                            <button
                                type="button"
                                class="medicine-search-button"
                                @onclick="SearchMedicinesAsync">

                                <i class="fas fa-search"></i>

                                @(MedicineReceiptStateService.IsSearching
                                    ? "Đang tìm..."
                                    : "Tìm")

                            </button>

                        </div>


                        @* =============================================
                           SEARCH RESULTS
                           ============================================= *@

                        @if (
                            MedicineReceiptStateService
                                .SearchResults
                                .Count > 0
                        )
                        {
                            <div class="medicine-search-results">

                                @foreach (
                                    var medicine
                                    in MedicineReceiptStateService
                                        .SearchResults)
                                {
                                    <button
                                        type="button"
                                        class="medicine-search-result"
                                        @onclick="
                                            () => SelectMedicine(medicine)">

                                        <div class="medicine-search-result-name">

                                            @medicine.Name

                                        </div>


                                        <div class="medicine-search-result-meta">

                                            @if (
                                                !string.IsNullOrWhiteSpace(
                                                    medicine.Code))
                                            {
                                                <span>
                                                    @medicine.Code
                                                </span>
                                            }


                                            @if (
                                                !string.IsNullOrWhiteSpace(
                                                    medicine.ActiveIngredient))
                                            {
                                                <span>
                                                    · @medicine.ActiveIngredient
                                                </span>
                                            }


                                            @if (
                                                !string.IsNullOrWhiteSpace(
                                                    medicine.Concentration))
                                            {
                                                <span>
                                                    · @medicine.Concentration
                                                </span>
                                            }

                                        </div>

                                    </button>
                                }

                            </div>
                        }


                        @* =============================================
                           NO RESULT
                           ============================================= *@

                        @if (
                            !MedicineReceiptStateService.IsSearching &&
                            !string.IsNullOrWhiteSpace(
                                MedicineReceiptStateService.SearchKeyword) &&
                            MedicineReceiptStateService.SearchResults.Count == 0 &&
                            MedicineReceiptStateService.SelectedMedicineId == 0
                        )
                        {
                            <div class="medicine-search-empty">

                                Không tìm thấy thuốc phù hợp.

                            </div>
                        }

                    </div>


                    @* =============================================
                       SELECTED MEDICINE
                       ============================================= *@

                    @if (
                        MedicineReceiptStateService.SelectedMedicineId > 0
                    )
                    {
                        <div class="medicine-selected">

                            <div class="medicine-selected-icon">

                                <i class="fas fa-pills"></i>

                            </div>


                            <div class="medicine-selected-info">

                                <span>
                                    Thuốc đã chọn
                                </span>

                                <strong>
                                    @MedicineReceiptStateService.SearchKeyword
                                </strong>

                            </div>


                            <div class="medicine-selected-status">

                                <i class="fas fa-check"></i>

                                Đã chọn

                            </div>

                        </div>
                    }


                    @* =============================================
                       BATCH + EXPIRY
                       ============================================= *@

                    <div class="medicine-receipt-grid">


                        <div class="medicine-receipt-field">

                            <label>
                                Số lô
                            </label>

                            <input
                                type="text"
                                class="medicine-receipt-input"
                                @bind="
                                    MedicineReceiptStateService.BatchNo"
                                @bind:event="oninput"
                                maxlength="50"
                                placeholder="Ví dụ: L2409" />

                        </div>


                        <div class="medicine-receipt-field">

                            <label>
                                Hạn sử dụng
                            </label>

                            <input
                                type="date"
                                class="medicine-receipt-input"
                                @bind="
                                    MedicineReceiptStateService.ExpiryDate" />

                        </div>


                    </div>


                    @* =============================================
                       QUANTITY + PRICE
                       ============================================= *@

                    <div class="medicine-receipt-grid">


                        <div class="medicine-receipt-field">

                            <label>
                                Số lượng
                            </label>

                            <input
                                type="number"
                                min="1"
                                class="medicine-receipt-input"
                                @bind="
                                    MedicineReceiptStateService.Quantity"
                                @bind:event="oninput"
                                placeholder="Nhập số lượng..." />

                        </div>


                        <div class="medicine-receipt-field">

                            <label>
                                Giá nhập / đơn vị
                            </label>

                            <input
                                type="number"
                                min="0"
                                step="0.01"
                                class="medicine-receipt-input"
                                @bind="
                                    MedicineReceiptStateService.ImportPrice"
                                @bind:event="oninput"
                                placeholder="0" />

                        </div>


                    </div>


                </div>

            </section>


            @* =================================================
               NOTE
               ================================================= *@

            <section class="medicine-receipt-note">

                <i class="fas fa-info-circle"></i>

                <div>

                    <strong>
                        Lưu ý
                    </strong>

                    <p>
                        Mỗi lô thuốc được xác định bởi thuốc và
                        số lô. Hạn sử dụng và giá nhập sẽ được
                        kiểm tra khi lưu phiếu nhập.
                    </p>

                </div>

            </section>


            @* =================================================
               ACTIONS
               ================================================= *@

            <div class="medicine-receipt-actions">


                <button
                    type="button"
                    class="medicine-receipt-cancel-button"
                    @onclick="GoBack">

                    Hủy

                </button>


                <button
                    type="button"
                    class="medicine-receipt-submit-button"
                    disabled="@(!MedicineReceiptStateService.CanSubmit)"
                    @onclick="SubmitReceiptAsync">

                    <i class="fas fa-check"></i>

                    @(MedicineReceiptStateService.IsSubmitting
                        ? "Đang nhập..."
                        : "Nhập thuốc")

                </button>


            </div>


        </div>

    </div>

</div>


@code {


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override void OnInitialized()
    {
        MedicineReceiptStateService.OnChange +=
            HandleStateChanged;

        MedicineReceiptStateService.Reset();
    }


    // =====================================================
    // STATE CHANGE
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // SEARCH MEDICINES
    // =====================================================

    private async Task SearchMedicinesAsync()
    {
        await MedicineReceiptStateService
            .SearchMedicinesAsync();
    }


    // =====================================================
    // SEARCH BY ENTER
    // =====================================================

    private async Task HandleSearchKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchMedicinesAsync();
        }
    }


    // =====================================================
    // SELECT MEDICINE
    // =====================================================

    private void SelectMedicine(
        MedicineDTO medicine)
    {
        MedicineReceiptStateService
            .SelectMedicine(medicine);
    }


    // =====================================================
    // SUBMIT
    // =====================================================

    private async Task SubmitReceiptAsync()
    {
        if (!MedicineReceiptStateService.CanSubmit)
        {
            return;
        }


        await MedicineReceiptStateService
            .SubmitReceiptAsync();
    }


    // =====================================================
    // GO TO INVENTORY
    // =====================================================

    private void GoToInventory()
    {
        NavigationManager.NavigateTo(
            "/pharmacy/inventory",
            forceLoad: true
        );
    }


    // =====================================================
    // BACK
    // =====================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/pharmacy/inventory"
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        MedicineReceiptStateService.OnChange -=
            HandleStateChanged;
    }
}