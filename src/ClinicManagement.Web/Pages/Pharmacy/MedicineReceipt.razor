@page "/pharmacy/receipt"

@layout HomePageMaster

@attribute [Authorize(Roles = "Pharmacist")]

@using ClinicManagementSystem.Application.DTOs.Pharmacy
@using Microsoft.AspNetCore.Authorization


@inject MedicineReceiptStateService MedicineReceiptStateService

@inject NavigationManager NavigationManager


@implements IDisposable


<PageTitle>
    Nhập thuốc
</PageTitle>


<div class="medicine-receipt-page">

    <div class="medicine-receipt-container">


        @* =====================================================
           BACK
           ===================================================== *@

        <button type="button" class="medicine-receipt-back-button" @onclick="GoBack">

            <i class="fas fa-arrow-left"></i>

            Quay lại kho thuốc

        </button>


        @* =====================================================
           HEADER
           ===================================================== *@

        <div class="medicine-receipt-header">

            <h1>
                Nhập thuốc
            </h1>

            <p>
                Ghi nhận thuốc nhập vào kho và thông tin lô thuốc.
            </p>

        </div>


        @* =====================================================
           LOAD ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ErrorMessage))
        {
            <div class="medicine-receipt-error">

                <i class="fas fa-exclamation-circle"></i>

                @MedicineReceiptStateService.ErrorMessage

            </div>
        }


        @* =====================================================
           ACTION ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ActionErrorMessage))
        {
            <div class="medicine-receipt-error">

                <i class="fas fa-exclamation-circle"></i>

                @MedicineReceiptStateService.ActionErrorMessage

            </div>
        }


        @* =====================================================
           SUCCESS
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(
            MedicineReceiptStateService.ActionMessage))
        {
            <div class="medicine-receipt-success">

                <i class="fas fa-check-circle"></i>

                @MedicineReceiptStateService.ActionMessage

            </div>
        }


        @* =====================================================
           LOADING
           ===================================================== *@

        @if (MedicineReceiptStateService.IsLoading)
        {
            <div class="medicine-receipt-state">

                <div class="medicine-receipt-spinner"></div>

                <span>
                    Đang tải danh sách thuốc...
                </span>

            </div>
        }
        else
        {
            <div class="medicine-receipt-layout">


                @* =================================================
                   RECEIPT INFORMATION
                   ================================================= *@

                <section class="medicine-receipt-card">

                    <div class="medicine-receipt-card-header">

                        <div>

                            <div class="medicine-receipt-card-label">
                                RECEIPT INFORMATION
                            </div>

                            <h2>
                                Thông tin nhập thuốc
                            </h2>

                        </div>

                    </div>


                    <div class="medicine-receipt-card-body">


                        <div class="medicine-receipt-field">

                            <label>
                                Nhà cung cấp
                            </label>

                            <input type="text" class="medicine-receipt-input" @bind="
                                   MedicineReceiptStateService.SupplierName" maxlength="255"
       placeholder="Nhập tên nhà cung cấp..." />

</div>


                        <div class="medicine-receipt-field">

                            <label>
                                Số hóa đơn / mã tham chiếu
                            </label>

                            <input type="text" class="medicine-receipt-input" @bind="
                                   MedicineReceiptStateService.ReferenceCode" maxlength="100"
       placeholder="Ví dụ: HD-DHG-8891" />

</div>


                    </div>

                </section>


                @* =================================================
                   MEDICINE BATCH
                   ================================================= *@

                <section class="medicine-receipt-card">

                    <div class="medicine-receipt-card-header">

                        <div>

                            <div class="medicine-receipt-card-label">
                                MEDICINE BATCH
                            </div>

                            <h2>
                                Thông tin thuốc nhập
                            </h2>

                        </div>

                    </div>


                    <div class="medicine-receipt-card-body">


                        @if (
                            MedicineReceiptStateService
                                .Medicines
                                .Count == 0
                        )
                        {
                            <div class="medicine-receipt-empty">

                                <i class="fas fa-pills"></i>

                                <h3>
                                    Không có thuốc
                                </h3>

                                <p>
                                    Không tìm thấy thuốc đang hoạt động.
                                </p>

                            </div>
                        }
                        else
                        {
                            @* =========================================
                               MEDICINE
                               ========================================= *@

                            <div class="medicine-receipt-field">

                                <label>
                                    Thuốc
                                </label>

                                <select class="medicine-receipt-input" @bind="
                                        MedicineReceiptStateService
                                            .SelectedMedicineId">

<option value="0">
                                        -- Chọn thuốc --
                                    </option>


                                    @foreach (
                                        var medicine
                                        in MedicineReceiptStateService
                                            .Medicines)
                                    {
                                        <option value="@medicine.Id">

                                            @(medicine.Code
                                                ?? $"TH{medicine.Id:000}")

                                            -

                                            @medicine.Name

                                        </option>
                                    }

                                </select>

                            </div>


                            @* =========================================
                               BATCH + EXPIRY
                               ========================================= *@

                            <div class="medicine-receipt-grid">


                                <div class="medicine-receipt-field">

                                    <label>
                                        Số lô
                                    </label>

                                    <input type="text" class="medicine-receipt-input" @bind="
                                           MedicineReceiptStateService
                                               .BatchNo" maxlength="50" placeholder="Ví dụ: L2409" />

</div>


                                <div class="medicine-receipt-field">

                                    <label>
                                        Hạn sử dụng
                                    </label>

                                    <input type="date" class="medicine-receipt-input" @bind="
                                           MedicineReceiptStateService
                                               .ExpiryDate" />

</div>


                            </div>


                            @* =========================================
                               QUANTITY + PRICE
                               ========================================= *@

                            <div class="medicine-receipt-grid">


                                <div class="medicine-receipt-field">

                                    <label>
                                        Số lượng
                                    </label>

                                    <input type="number" min="1" class="medicine-receipt-input" @bind="
                                           MedicineReceiptStateService
                                               .Quantity" placeholder="Nhập số lượng..." />

</div>


                                <div class="medicine-receipt-field">

                                    <label>
                                        Giá nhập / đơn vị
                                    </label>

                                    <input type="number" min="0" step="0.01" class="medicine-receipt-input" @bind="
                                           MedicineReceiptStateService
                                               .ImportPrice" placeholder="0" />

</div>


                            </div>
                        }


                    </div>

                </section>


                @* =================================================
                   NOTE
                   ================================================= *@

                <section class="medicine-receipt-note">

                    <i class="fas fa-info-circle"></i>

                    <div>

                        <strong>
                            Lưu ý
                        </strong>

                        <p>
                            Mỗi lô thuốc được xác định bởi thuốc và
                            số lô. Hạn sử dụng và giá nhập sẽ được
                            kiểm tra khi lưu phiếu nhập.
                        </p>

                    </div>

                </section>


                @* =================================================
                   ACTIONS
                   ================================================= *@

                <div class="medicine-receipt-actions">


                    <button type="button" class="medicine-receipt-cancel-button" @onclick="GoBack">

                        Hủy

                    </button>


                    <button type="button" class="medicine-receipt-submit-button"
                            disabled="@(!MedicineReceiptStateService.CanSubmit)" @onclick="SubmitReceiptAsync">

                        <i class="fas fa-check"></i>

                        @(MedicineReceiptStateService.IsSubmitting
                            ? "Đang nhập..."
                            : "Nhập thuốc")

                    </button>


                </div>


            </div>
        }


    </div>

</div>


@code {


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override void OnInitialized()
    {
        MedicineReceiptStateService.OnChange +=
            HandleStateChanged;

        MedicineReceiptStateService.Reset();
    }


    protected override async Task OnInitializedAsync()
    {
        await MedicineReceiptStateService
            .LoadMedicinesAsync();
    }


    // =====================================================
    // STATE CHANGE
    // =====================================================

    private void HandleStateChanged()
    {
        InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // SUBMIT
    // =====================================================

    private async Task SubmitReceiptAsync()
    {
        if (!MedicineReceiptStateService.CanSubmit)
        {
            return;
        }


        var success =
            await MedicineReceiptStateService
                .SubmitReceiptAsync();


        if (!success)
        {
            return;
        }


        // Không chuyển trang ngay.
        // Cho user thấy message thành công.
    }
    // =====================================================
    // BACK
    // =====================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/pharmacy/inventory"
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        MedicineReceiptStateService.OnChange -=
            HandleStateChanged;
    }
}