@page "/pharmacy/receipt"

@layout HomePageMaster

@attribute [Authorize(Roles = "Pharmacist")]

@using System.Net.Http.Json
@using ClinicManagementSystem.Application.DTOs
@using ClinicManagementSystem.Application.DTOs.Pharmacy
@using Microsoft.AspNetCore.Authorization

@inject AuthorizedApiService AuthorizedApiService
@inject NavigationManager NavigationManager


<PageTitle>Nhập thuốc</PageTitle>


<div class="medicine-receipt-page">

    <div class="medicine-receipt-container">

        @* =====================================================
           BACK
           ===================================================== *@

        <button type="button" class="medicine-receipt-back-button" @onclick="GoBack">

            <i class="fas fa-arrow-left"></i>

            Quay lại kho thuốc

        </button>


        @* =====================================================
           HEADER
           ===================================================== *@

        <div class="medicine-receipt-header">

            <div class="medicine-receipt-label">
                PHARMACY · MEDICINE RECEIPT
            </div>

            <h1>
                Nhập thuốc
            </h1>

            <p>
                Ghi nhận thuốc nhập vào kho và thông tin lô thuốc.
            </p>

        </div>


        @* =====================================================
           ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="medicine-receipt-error">

                <i class="fas fa-exclamation-circle"></i>

                @ErrorMessage

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ActionMessage))
        {
            <div class="medicine-receipt-success">

                <i class="fas fa-check-circle"></i>

                @ActionMessage

            </div>
        }


        @* =====================================================
           LOADING
           ===================================================== *@

        @if (IsLoading)
        {
            <div class="medicine-receipt-state">

                <div class="medicine-receipt-spinner"></div>

                <span>
                    Đang tải danh sách thuốc...
                </span>

            </div>
        }
        else
        {
            <div class="medicine-receipt-layout">

                @* =================================================
                   RECEIPT INFORMATION
                   ================================================= *@

                <section class="medicine-receipt-card">

                    <div class="medicine-receipt-card-header">

                        <div>

                            <div class="medicine-receipt-card-label">
                                RECEIPT INFORMATION
                            </div>

                            <h2>
                                Thông tin nhập thuốc
                            </h2>

                        </div>

                    </div>


                    <div class="medicine-receipt-card-body">

                        <div class="medicine-receipt-field">

                            <label>
                                Nhà cung cấp
                            </label>

                            <input type="text" class="medicine-receipt-input" @bind="SupplierName" maxlength="255"
                                   placeholder="Nhập tên nhà cung cấp..." />

                        </div>


                        <div class="medicine-receipt-field">

                            <label>
                                Số hóa đơn / mã tham chiếu
                            </label>

                            <input type="text" class="medicine-receipt-input" @bind="ReferenceCode" maxlength="100"
                                   placeholder="Ví dụ: HD-DHG-8891" />

                        </div>

                    </div>

                </section>


                @* =================================================
                   MEDICINE ITEM
                   ================================================= *@

                <section class="medicine-receipt-card">

                    <div class="medicine-receipt-card-header">

                        <div>

                            <div class="medicine-receipt-card-label">
                                MEDICINE BATCH
                            </div>

                            <h2>
                                Thông tin thuốc nhập
                            </h2>

                        </div>

                    </div>


                    <div class="medicine-receipt-card-body">

                        @if (Medicines.Count == 0)
                        {
                            <div class="medicine-receipt-empty">

                                <i class="fas fa-pills"></i>

                                <h3>
                                    Không có thuốc
                                </h3>

                                <p>
                                    Không tìm thấy thuốc đang hoạt động.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="medicine-receipt-field">

                                <label>
                                    Thuốc
                                </label>

                                <select class="medicine-receipt-input" @bind="SelectedMedicineId">

                                    <option value="0">
                                        -- Chọn thuốc --
                                    </option>

                                    @foreach (var medicine in Medicines)
                                    {
                                        <option value="@medicine.Id">

                                            @(medicine.Code ?? $"TH{medicine.Id:000}")
                                            -
                                            @medicine.Name

                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="medicine-receipt-grid">

                                <div class="medicine-receipt-field">

                                    <label>
                                        Số lô
                                    </label>

                                    <input type="text" class="medicine-receipt-input" @bind="BatchNo" maxlength="50"
                                           placeholder="Ví dụ: L2409" />

                                </div>


                                <div class="medicine-receipt-field">

                                    <label>
                                        Hạn sử dụng
                                    </label>

                                    <input type="date" class="medicine-receipt-input" @bind="ExpiryDate" />

                                </div>

                            </div>


                            <div class="medicine-receipt-grid">

                                <div class="medicine-receipt-field">

                                    <label>
                                        Số lượng
                                    </label>

                                    <input type="number" min="1" class="medicine-receipt-input" @bind="Quantity"
                                           placeholder="Nhập số lượng..." />

                                </div>


                                <div class="medicine-receipt-field">

                                    <label>
                                        Giá nhập / đơn vị
                                    </label>

                                    <input type="number" min="0" step="0.01" class="medicine-receipt-input" @bind="ImportPrice"
                                           placeholder="0" />

                                </div>

                            </div>
                        }

                    </div>

                </section>


                @* =================================================
                   NOTE
                   ================================================= *@

                <section class="medicine-receipt-note">

                    <i class="fas fa-info-circle"></i>

                    <div>

                        <strong>
                            Lưu ý
                        </strong>

                        <p>
                            Mỗi lô thuốc được xác định bởi thuốc và
                            số lô. Hạn sử dụng và giá nhập sẽ được
                            kiểm tra khi lưu phiếu nhập.
                        </p>

                    </div>

                </section>


                @* =================================================
                   ACTIONS
                   ================================================= *@

                <div class="medicine-receipt-actions">

                    <button type="button" class="medicine-receipt-cancel-button" @onclick="GoBack">

                        Hủy

                    </button>


                    <button type="button" class="medicine-receipt-submit-button" disabled="@(!CanSubmit || IsSubmitting)"
                            @onclick="SubmitReceiptAsync">

                        <i class="fas fa-check"></i>

                        @(IsSubmitting
                            ? "Đang nhập..."
                            : "Nhập thuốc")

                    </button>

                </div>

            </div>
        }

    </div>

</div>


@code {

    // =====================================================
    // STATE
    // =====================================================

    private List<MedicineInventoryDTO> Medicines =
        new();

    private bool IsLoading;

    private string ErrorMessage =
        string.Empty;

    private bool IsSubmitting;

    private string ActionMessage =
        string.Empty;


    // =====================================================
    // FORM
    // =====================================================

    private string SupplierName =
        string.Empty;

    private string ReferenceCode =
        string.Empty;

    private int SelectedMedicineId;

    private string BatchNo =
        string.Empty;

    private DateTime ExpiryDate =
        DateTime.Today.AddYears(1);

    private int Quantity;

    private decimal ImportPrice;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadMedicinesAsync();
    }

    // =====================================================
    // SUBMIT MEDICINE RECEIPT
    //
    // POST:
    // /api/medicines/receipts
    //
    // Current UI đang nhập 1 dòng thuốc,
    // nên request.Items chỉ có 1 item.
    // =====================================================

    private async Task SubmitReceiptAsync()
    {
        // =================================================
        // PREVENT DOUBLE SUBMIT
        // =================================================

        if (IsSubmitting)
        {
            return;
        }


        // =================================================
        // CLIENT VALIDATION
        // =================================================

        if (SelectedMedicineId <= 0)
        {
            ErrorMessage =
                "Vui lòng chọn thuốc.";

            return;
        }


        if (string.IsNullOrWhiteSpace(BatchNo))
        {
            ErrorMessage =
                "Vui lòng nhập số lô.";

            return;
        }


        if (ExpiryDate.Date <= DateTime.Today)
        {
            ErrorMessage =
                "Hạn sử dụng phải lớn hơn ngày hiện tại.";

            return;
        }


        if (Quantity <= 0)
        {
            ErrorMessage =
                "Số lượng phải lớn hơn 0.";

            return;
        }


        if (ImportPrice < 0)
        {
            ErrorMessage =
                "Giá nhập không được nhỏ hơn 0.";

            return;
        }


        // =================================================
        // START SUBMIT
        // =================================================

        IsSubmitting = true;

        ErrorMessage =
            string.Empty;

        ActionMessage =
            string.Empty;


        try
        {
            // =================================================
            // CREATE REQUEST
            // =================================================

            var request =
                new MedicineReceiptRequestDTO
                {
                    SupplierName =
                        string.IsNullOrWhiteSpace(
                            SupplierName)
                            ? null
                            : SupplierName.Trim(),

                    ReferenceCode =
                        string.IsNullOrWhiteSpace(
                            ReferenceCode)
                            ? null
                            : ReferenceCode.Trim(),

                    Items =
                        new List<
                            MedicineReceiptItemRequestDTO
                        >
                        {
                        new MedicineReceiptItemRequestDTO
                        {
                            MedicineId =
                                SelectedMedicineId,

                            BatchNo =
                                BatchNo.Trim(),

                            ExpiryDate =
                                ExpiryDate,

                            Quantity =
                                Quantity,

                            ImportPrice =
                                ImportPrice
                        }
                        }
                };


            // =================================================
            // CREATE JSON CONTENT
            // =================================================

            var content =
                JsonContent.Create(request);


            // =================================================
            // CALL API
            //
            // POST:
            // /api/medicines/receipts
            // =================================================

            var response =
                await AuthorizedApiService
                    .PostAsync(
                        "/api/medicines/receipts",
                        content
                    );


            // =================================================
            // READ RESPONSE
            // =================================================

            var responseData =
                await response.Content
                    .ReadFromJsonAsync<
                        HttpResponseData<bool>
                    >();


            // =================================================
            // API FAILED
            // =================================================

            if (!response.IsSuccessStatusCode ||
                responseData == null ||
                responseData.StatusCode < 200 ||
                responseData.StatusCode >= 300)
            {
                ErrorMessage =
                    responseData?.Message
                    ?? "Không thể nhập thuốc.";

                return;
            }


            // =================================================
            // SUCCESS
            // =================================================

            ActionMessage =
                responseData.Message
                ?? "Nhập thuốc thành công.";


            // =================================================
            // RETURN TO INVENTORY
            // =================================================

            await Task.Delay(500);

            NavigationManager.NavigateTo(
                "/pharmacy/inventory"
            );
        }
        catch
        {
            ErrorMessage =
                "Không thể kết nối đến hệ thống.";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private bool CanSubmit =>
    SelectedMedicineId > 0 &&
    !string.IsNullOrWhiteSpace(BatchNo) &&
    ExpiryDate.Date > DateTime.Today &&
    Quantity > 0 &&
    ImportPrice >= 0;


    // =====================================================
    // LOAD MEDICINES
    //
    // Dùng inventory API để lấy danh sách thuốc đang active.
    // =====================================================

    private async Task LoadMedicinesAsync()
    {
        if (IsLoading)
        {
            return;
        }

        IsLoading = true;

        ErrorMessage =
            string.Empty;

        try
        {
            var response =
                await AuthorizedApiService.GetAsync(
                    "/api/medicines/inventory" +
                    "?lowStock=false" +
                    "&nearExpiry=30"
                );


            var responseData =
                await response.Content
                    .ReadFromJsonAsync<
                        HttpResponseData<
                            List<MedicineInventoryDTO>
                        >
                    >();


            if (!response.IsSuccessStatusCode ||
                responseData == null ||
                responseData.StatusCode < 200 ||
                responseData.StatusCode >= 300)
            {
                ErrorMessage =
                    responseData?.Message
                    ?? "Không thể tải danh sách thuốc.";

                Medicines =
                    new List<MedicineInventoryDTO>();

                return;
            }


            Medicines =
                responseData.Content
                ?? new List<MedicineInventoryDTO>();
        }
        catch
        {
            ErrorMessage =
                "Không thể kết nối đến hệ thống.";

            Medicines =
                new List<MedicineInventoryDTO>();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // =====================================================
    // BACK
    // =====================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/pharmacy/inventory"
        );
    }
}