@page "/pharmacy/inventory"

@layout HomePageMaster

@attribute [Authorize(Roles = "Pharmacist")]

@using ClinicManagementSystem.Application.DTOs
@using ClinicManagementSystem.Application.DTOs.Pharmacy
@using Microsoft.AspNetCore.Authorization

@inject AuthorizedApiService AuthorizedApiService
@inject NavigationManager NavigationManager


<PageTitle>Kho thuốc</PageTitle>


<div class="pharmacy-inventory-page">

    <div class="pharmacy-inventory-container">

        @* =====================================================
           HEADER
           ===================================================== *@

        <div class="pharmacy-inventory-header">

            <div>

                <h1>
                    Kho thuốc & lô hạn dùng
                </h1>

                <p>
                    Theo dõi tồn kho, lô thuốc và cảnh báo sắp hết,
                    gần hết hạn.
                </p>

            </div>

        </div>


        @* =====================================================
           ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="pharmacy-inventory-message pharmacy-inventory-error">

                @ErrorMessage

            </div>
        }


        @* =====================================================
           LOADING
           ===================================================== *@

        @if (IsLoading)
        {
            <div class="pharmacy-inventory-state">

                <div class="pharmacy-inventory-spinner"></div>

                <span>
                    Đang tải tồn kho...
                </span>

            </div>
        }
        else
        {
            @* =================================================
               SUMMARY
               ================================================= *@

            <div class="pharmacy-inventory-summary">

                <div class="pharmacy-inventory-summary-card low-stock">

                    <div class="pharmacy-inventory-summary-icon">

                        <i class="fas fa-exclamation-triangle"></i>

                    </div>

                    <div>

                        <div class="pharmacy-inventory-summary-label">
                            Thuốc dưới min_stock
                        </div>

                        <div class="pharmacy-inventory-summary-value">
                            @LowStockCount
                        </div>

                    </div>

                </div>


                <div class="pharmacy-inventory-summary-card near-expiry">

                    <div class="pharmacy-inventory-summary-icon">

                        <i class="fas fa-calendar-times"></i>

                    </div>

                    <div>

                        <div class="pharmacy-inventory-summary-label">
                            Lô hết hạn trong 30 ngày
                        </div>

                        <div class="pharmacy-inventory-summary-value">
                            @NearExpiryBatchCount
                        </div>

                    </div>

                </div>

            </div>


            @* =================================================
               INVENTORY CARD
               ================================================= *@

            <section class="pharmacy-inventory-card">

                <div class="pharmacy-inventory-card-header">

                    <div>

                        <div class="pharmacy-inventory-card-label">
                            MEDICINES + MEDICINE_BATCHES
                        </div>

                        <h2>
                            Danh sách kho thuốc
                        </h2>

                    </div>

                    <button type="button" class="pharmacy-inventory-refresh-button" @onclick="LoadInventoryAsync"
                            disabled="@IsLoading">

                        <i class="fas fa-sync-alt"></i>

                        Làm mới

                    </button>

                </div>


                @if (Inventory.Count == 0)
                {
                    <div class="pharmacy-inventory-empty">

                        <i class="fas fa-pills"></i>

                        <h3>
                            Chưa có thuốc trong kho
                        </h3>

                        <p>
                            Không tìm thấy dữ liệu tồn kho.
                        </p>

                    </div>
                }
                else
                {
                    <div class="pharmacy-inventory-table-wrapper">

                        <table class="pharmacy-inventory-table">

                            <thead>

                                <tr>

                                    <th>
                                        Mã
                                    </th>

                                    <th>
                                        Tên thuốc
                                    </th>

                                    <th>
                                        Hoạt chất
                                    </th>

                                    <th class="text-right">
                                        Tồn tổng
                                    </th>

                                    <th class="text-right">
                                        Min
                                    </th>

                                    <th>
                                        Lô gần hết hạn
                                    </th>

                                    <th>
                                        Trạng thái
                                    </th>

                                    <th>
                                        Thao tác
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var medicine in Inventory)
                                {
                                    <tr>

                                        <td>

                                            <span class="medicine-code">
                                                @(medicine.Code ?? $"TH{medicine.Id:000}")
                                            </span>

                                        </td>


                                        <td>

                                            <strong>
                                                @medicine.Name
                                            </strong>

                                        </td>


                                        <td>

                                            <span class="active-ingredient">
                                                @(medicine.ActiveIngredient ?? "—")
                                            </span>

                                        </td>


                                        <td class="text-right">

                                            <span class="stock-value">
                                                @medicine.StockQuantity
                                            </span>

                                        </td>


                                        <td class="text-right">

                                            @medicine.MinStock

                                        </td>


                                        <td>

                                            @if (!string.IsNullOrWhiteSpace(
                                                medicine.NearExpiryBatchNo))
                                            {
                                                <div class="batch-info">

                                                    <strong>
                                                        @medicine.NearExpiryBatchNo
                                                    </strong>

                                                    @if (medicine.NearExpiryDate.HasValue)
                                                    {
                                                        <span>
                                                            @medicine.NearExpiryDate.Value
                                                            .ToString("dd/MM/yyyy")
                                                        </span>
                                                    }

                                                </div>
                                            }
                                            else
                                            {
                                                <span class="muted">
                                                    —
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            @if (medicine.IsLowStock)
                                            {
                                                <span class="inventory-status danger">
                                                    Sắp hết
                                                </span>
                                            }
                                            else if (medicine.IsNearExpiry)
                                            {
                                                <span class="inventory-status warning">
                                                    Gần hết hạn
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inventory-status success">
                                                    Đủ
                                                </span>
                                            }

                                        </td>

                                        <td class="inventory-actions">

                                            <button type="button" class="inventory-adjust-button"
                                                    @onclick="() => OpenAdjustModal(medicine)">

                                                <i class="fas fa-sliders-h"></i>
                                                Điều chỉnh

                                            </button>

                                            <button type="button" class="inventory-history-button"
                                                    @onclick="() => ViewStockCard(medicine.Id)">

                                                <i class="fas fa-history"></i>
                                                Thẻ kho

                                            </button>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>

            @if (ShowAdjustModal && SelectedMedicine != null)
            {
                <div class="inventory-modal-backdrop" @onclick="CloseAdjustModal">

                    <div class="inventory-modal" @onclick:stopPropagation="true">

                        <div class="inventory-modal-header">

                            <div>
                                <div class="inventory-modal-label">
                                    ĐIỀU CHỈNH TỒN
                                </div>

                                <h3>
                                    @SelectedMedicine.Name
                                </h3>

                                <span>
                                    @(SelectedMedicine.Code
                                        ?? $"TH{SelectedMedicine.Id:000}")
                                </span>
                            </div>

                            <button type="button" class="inventory-modal-close" @onclick="CloseAdjustModal">

                                <i class="fas fa-times"></i>

                            </button>

                        </div>


                        <div class="inventory-modal-body">

                            @if (!string.IsNullOrWhiteSpace(AdjustError))
                            {
                                <div class="inventory-adjust-error">
                                    @AdjustError
                                </div>
                            }


                            <div class="inventory-adjust-field">

                                <label>
                                    Lô thuốc
                                </label>

                                <select class="inventory-adjust-input" @bind="SelectedBatchId">

                                    <option value="0">
                                        -- Chọn lô thuốc --
                                    </option>

                                    @foreach (var batch in SelectedMedicine.Batches)
                                    {
                                        <option value="@batch.BatchId">
                                            @batch.BatchNo
                                            — tồn @batch.Quantity
                                            — HSD @batch.ExpiryDate.ToString("dd/MM/yyyy")
                                        </option>
                                    }

                                </select>

                            </div>


                            <div class="inventory-adjust-field">

                                <label>
                                    Số lượng điều chỉnh
                                </label>

                                <input type="number" class="inventory-adjust-input" @bind="AdjustQuantity"
                                       placeholder="Ví dụ: 5 hoặc -5" />

                                <small>
                                    Số dương để cộng tồn, số âm để trừ tồn.
                                </small>

                            </div>


                            <div class="inventory-adjust-field">

                                <label>
                                    Lý do
                                </label>

                                <textarea class="inventory-adjust-input inventory-adjust-textarea" @bind="AdjustReason"
                                          maxlength="500" placeholder="Nhập lý do điều chỉnh...">
                    </textarea>

                            </div>

                        </div>


                        <div class="inventory-modal-footer">

                            <button type="button" class="inventory-cancel-button" @onclick="CloseAdjustModal"
                                    disabled="@IsAdjusting">

                                Hủy

                            </button>

                            <button type="button" class="inventory-confirm-button" @onclick="AdjustStockAsync"
                                    disabled="@IsAdjusting">

                                @if (IsAdjusting)
                                {
                                    <span>
                                        Đang lưu...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        <i class="fas fa-check"></i>
                                        Xác nhận điều chỉnh
                                    </span>
                                }

                            </button>

                        </div>

                    </div>

                </div>
            }

        }

    </div>

</div>


@code {

    // =====================================================
    // STATE
    // =====================================================

    private List<MedicineInventoryDTO> Inventory =
        new();

    private bool IsLoading;

    private string ErrorMessage =
        string.Empty;


    // =====================================================
    // SUMMARY
    // =====================================================

    private int LowStockCount =>
        Inventory.Count(
            x => x.IsLowStock
        );

    private int NearExpiryBatchCount =>
        Inventory.Sum(
            x => x.NearExpiryBatchCount
        );

    // =====================================================
    // ADJUST STOCK MODAL
    // =====================================================

    private bool ShowAdjustModal;

    private MedicineInventoryDTO? SelectedMedicine;

    private int SelectedBatchId;

    private int AdjustQuantity;

    private string AdjustReason =
        string.Empty;

    private string AdjustError =
        string.Empty;

    private bool IsAdjusting;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadInventoryAsync();
    }

    // Goi api adjust
    private async Task AdjustStockAsync()
    {
        if (SelectedMedicine == null)
        {
            return;
        }


        AdjustError =
            string.Empty;


        if (SelectedBatchId <= 0)
        {
            AdjustError =
                "Vui lòng chọn lô thuốc.";

            return;
        }


        if (AdjustQuantity == 0)
        {
            AdjustError =
                "Số lượng điều chỉnh phải khác 0.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
            AdjustReason))
        {
            AdjustError =
                "Vui lòng nhập lý do điều chỉnh.";

            return;
        }


        IsAdjusting =
            true;


        try
        {
            var request =
                new AdjustMedicineStockRequestDTO
                {
                    BatchId =
                        SelectedBatchId,

                    Quantity =
                        AdjustQuantity,

                    Reason =
                        AdjustReason.Trim()
                };


            var content = JsonContent.Create(request);

            var response =
                await AuthorizedApiService.PostAsync(
                    $"/api/medicines/{SelectedMedicine.Id}/adjust",
                    content
                );


            var responseData =
                await response.Content
                    .ReadFromJsonAsync<
                        HttpResponseData<
                            StockTransactionDTO
                        >
                    >();


            if (!response.IsSuccessStatusCode ||
                responseData == null ||
                responseData.StatusCode < 200 ||
                responseData.StatusCode >= 300)
            {
                AdjustError =
                    responseData?.Message
                    ?? "Không thể điều chỉnh tồn kho.";

                return;
            }


            // =============================================
            // SUCCESS
            // =============================================

            ShowAdjustModal =
                false;

            SelectedMedicine =
                null;

            await LoadInventoryAsync();
        }
        catch
        {
            AdjustError =
                "Không thể kết nối đến hệ thống.";
        }
        finally
        {
            IsAdjusting =
                false;
        }
    }
    // Mo modal
    private void OpenAdjustModal(
    MedicineInventoryDTO medicine)
    {
        SelectedMedicine =
            medicine;

        SelectedBatchId =
            0;

        AdjustQuantity =
            0;

        AdjustReason =
            string.Empty;

        AdjustError =
            string.Empty;

        ShowAdjustModal =
            true;
    }

    // dong modal
    private void CloseAdjustModal()
    {
        if (IsAdjusting)
        {
            return;
        }

        ShowAdjustModal =
            false;

        SelectedMedicine =
            null;

        AdjustError =
            string.Empty;
    }


    // =====================================================
    // LOAD INVENTORY
    //
    // GET:
    // /api/medicines/inventory
    // =====================================================

    private async Task LoadInventoryAsync()
    {
        if (IsLoading)
        {
            return;
        }

        IsLoading = true;

        ErrorMessage =
            string.Empty;

        try
        {
            var response =
                await AuthorizedApiService.GetAsync(
                    "/api/medicines/inventory" +
                    "?lowStock=false" +
                    "&nearExpiry=30"
                );


            var responseData =
                await response.Content
                    .ReadFromJsonAsync<
                        HttpResponseData<
                            List<MedicineInventoryDTO>
                        >
                    >();


            // =================================================
            // API FAILED
            // =================================================

            if (!response.IsSuccessStatusCode ||
                responseData == null ||
                responseData.StatusCode < 200 ||
                responseData.StatusCode >= 300)
            {
                ErrorMessage =
                    responseData?.Message
                    ?? "Không thể tải tồn kho.";

                Inventory =
                    new List<MedicineInventoryDTO>();

                return;
            }


            // =================================================
            // SUCCESS
            // =================================================

            Inventory =
                responseData.Content
                ?? new List<MedicineInventoryDTO>();
        }
        catch
        {
            ErrorMessage =
                "Không thể kết nối đến hệ thống.";

            Inventory =
                new List<MedicineInventoryDTO>();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ViewStockCard(int medicineId)
    {
        NavigationManager.NavigateTo(
            $"/pharmacy/inventory/{medicineId}/transactions"
        );
    }

}