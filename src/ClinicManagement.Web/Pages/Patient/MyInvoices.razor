@page "/patient/invoices"
@layout HomePageMaster
@attribute [Authorize(Roles = "Patient")]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using ClinicManagementSystem.Application.DTOs.Invoice
@inject PatientInvoiceStateService InvoiceState

<PageTitle>Hóa đơn của tôi</PageTitle>


<div class="patient-invoices-page">

    @* =====================================================
       PAGE HEADER
       ===================================================== *@

    <div class="patient-invoices-header">
        <h1>Hóa đơn của tôi</h1>
        <p>Theo dõi chi phí khám, thanh toán và lịch sử hóa đơn.</p>
    </div>


    @* =====================================================
       CONTENT
       ===================================================== *@

    <div class="patient-invoices-content">

        @if (InvoiceState.IsLoading)
        {
            <div class="patient-invoices-loading">
                Đang tải danh sách hóa đơn...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(InvoiceState.ErrorMessage))
        {
            <div class="patient-invoices-error">
                <p>@InvoiceState.ErrorMessage</p>

                <button type="button" @onclick="RetryAsync">
                    Thử lại
                </button>
            </div>
        }
        else if (InvoiceState.Invoices.Count == 0)
        {
            <div class="patient-invoices-empty">
                <i class="fas fa-file-invoice"></i>
                <h3>Chưa có hóa đơn</h3>
                <p>Bạn chưa có hóa đơn nào trong hệ thống.</p>
            </div>
        }
        else
        {
            <div class="patient-invoice-list">

                @foreach (var invoice in InvoiceState.Invoices)
                {
                    <div class="patient-invoice-card">

                        @* =================================================
                        HEADER
                        ================================================= *@

                        <div class="patient-invoice-card-header">

                            <div>
                                <div class="patient-invoice-number">
                                    @invoice.InvoiceNo
                                </div>

                                <div class="patient-invoice-date">
                                    @invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                            <span class="patient-invoice-status">
                                @GetInvoiceStatusText(invoice.Status)
                            </span>

                        </div>


                        @* =================================================
                        AMOUNTS
                        ================================================= *@

                        <div class="patient-invoice-summary">

                            <div class="patient-invoice-summary-item">
                                <span>Tổng hóa đơn</span>
                                <strong>@FormatMoney(GetPayableAmount(invoice))</strong>
                            </div>

                            <div class="patient-invoice-summary-item">
                                <span>Đã thanh toán</span>
                                <strong>@FormatMoney(invoice.PaidAmount)</strong>
                            </div>

                            <div class="patient-invoice-summary-item">
                                <span>Còn lại</span>
                                <strong>@FormatMoney(GetRemainingAmount(invoice))</strong>
                            </div>

                        </div>


                        @* =================================================
                        REFERENCE
                        ================================================= *@

                        <div class="patient-invoice-reference">

                            @if (invoice.AppointmentId.HasValue)
                            {
                                <span>
                                    Lịch hẹn #@invoice.AppointmentId
                                </span>
                            }

                            @if (invoice.MedicalRecordId.HasValue)
                            {
                                <span>
                                    Bệnh án #@invoice.MedicalRecordId
                                </span>
                            }

                        </div>

                        @* =================================================
                        ACTION
                        ================================================= *@

                        <div class="patient-invoice-actions">
                            <button type="button" class="patient-invoice-detail-button"
                                    @onclick="() => ToggleInvoiceDetail(invoice.Id)">
                                @(IsInvoiceExpanded(invoice.Id)
                                    ? "Thu gọn"
                                    : "Xem chi tiết")
                            </button>
                        </div>


                        @* =================================================
                        DETAIL
                        ================================================= *@

                        @if (IsInvoiceExpanded(invoice.Id))
                        {
                            <div class="patient-invoice-detail">

                                @* =================================================
                                INVOICE ITEMS
                                ================================================= *@

                                <div class="patient-invoice-section">

                                    <div class="patient-invoice-section-header">
                                        <h5>Chi tiết hóa đơn</h5>
                                    </div>

                                    @if (invoice.Items.Count == 0)
                                    {
                                        <div class="patient-invoice-section-empty">
                                            Hóa đơn chưa có chi tiết.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-invoice-items-table-wrapper">

                                            <table class="patient-invoice-items-table">
                                                <thead>
                                                    <tr>
                                                        <th>Nội dung</th>
                                                        <th>SL</th>
                                                        <th>Đơn giá</th>
                                                        <th>Giảm giá</th>
                                                        <th>Thành tiền</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var item in invoice.Items)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @GetInvoiceItemDescription(item.Description)
                                                            </td>

                                                            <td>
                                                                @item.Quantity
                                                            </td>

                                                            <td>
                                                                @FormatMoney(item.UnitPrice)
                                                            </td>

                                                            <td>
                                                                @FormatMoney(item.DiscountAmount)
                                                            </td>

                                                            <td>
                                                                <strong>
                                                                    @FormatMoney(item.Amount)
                                                                </strong>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                        </div>
                                    }

                                </div>

                                @* =================================================
   PAYMENTS
   ================================================= *@

                                <div class="patient-invoice-section">

                                    <div class="patient-invoice-section-header">
                                        <h5>Lịch sử thanh toán</h5>
                                    </div>

                                    @if (invoice.Payments.Count == 0)
                                    {
                                        <div class="patient-invoice-section-empty">
                                            Hóa đơn chưa có giao dịch thanh toán.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-invoice-payments">

                                            @foreach (var payment in invoice.Payments)
                                            {
                                                <div class="patient-invoice-payment-item">

                                                    <div class="patient-invoice-payment-main">

                                                        <div class="patient-invoice-payment-method">
                                                            @GetPaymentMethodText(payment.Method)
                                                        </div>

                                                        <div class="patient-invoice-payment-date">
                                                            @payment.PaidAt.ToString("dd/MM/yyyy HH:mm")
                                                        </div>

                                                    </div>

                                                    <div class="patient-invoice-payment-info">

                                                        <strong>
                                                            @FormatMoney(payment.Amount)
                                                        </strong>

                                                        @if (payment.IsRefund)
                                                        {
                                                            <span class="patient-invoice-refund-badge">
                                                                Hoàn tiền
                                                            </span>
                                                        }

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(payment.ReferenceCode))
                                                    {
                                                        <div class="patient-invoice-payment-reference">
                                                            Mã tham chiếu: @payment.ReferenceCode
                                                        </div>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(payment.Note))
                                                    {
                                                        <div class="patient-invoice-payment-note">
                                                            @payment.Note
                                                        </div>
                                                    }

                                                </div>
                                            }

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>

</div>


@code {

    // State
    private int? _expandedInvoiceId;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        _expandedInvoiceId = null;

        InvoiceState.OnChange = HandleStateChanged;

        await InvoiceState.LoadInvoicesAsync();
    }



    // =====================================================
    // PAYMENT METHOD
    // =====================================================

    private string GetPaymentMethodText(byte method)
    {
        return method switch
        {
            0 => "Tiền mặt",
            1 => "Thẻ",
            2 => "Chuyển khoản",
            3 => "Ví điện tử",
            _ => "Không xác định"
        };
    }
    
    // =====================================================
    // TOGGLE INVOICE DETAIL
    // =====================================================

    private void ToggleInvoiceDetail(int invoiceId)
    {
        _expandedInvoiceId =
            _expandedInvoiceId == invoiceId
                ? null
                : invoiceId;
    }


    // =====================================================
    // CHECK EXPANDED
    // =====================================================

    private bool IsInvoiceExpanded(int invoiceId)
    {
        return _expandedInvoiceId == invoiceId;
    }

    // INVOICE STATUS
    private string GetInvoiceStatusText(byte status)
    {
        return status switch
        {
            0 => "Chưa thanh toán",
            1 => "Thanh toán một phần",
            2 => "Đã thanh toán",
            3 => "Đã hủy",
            _ => "Không xác định"
        };
    }

    // PAYABLE AMOUNT
    private decimal GetPayableAmount(PatientInvoiceDTO invoice)
    {
        return invoice.TotalAmount
            + invoice.TaxAmount
            - invoice.DiscountAmount
            - invoice.InsuranceAmount;
    }


    // REMAINING AMOUNT
    private decimal GetRemainingAmount(PatientInvoiceDTO invoice)
    {
        var remaining = GetPayableAmount(invoice) - invoice.PaidAmount;

        return remaining < 0
            ? 0
            : remaining;
    }


    // FORMAT MONEY
    private string FormatMoney(decimal amount)
    {
        return $"{amount:N0} đ";
    }


    // =====================================================
    // RETRY
    // =====================================================
    private async Task RetryAsync()
    {
        _expandedInvoiceId = null;

        await InvoiceState.LoadInvoicesAsync();
    }

    // =====================================================
    // Helper
    // =====================================================

    // INVOICE ITEM DESCRIPTION
    private string GetInvoiceItemDescription(string? description)
    {
        return string.IsNullOrWhiteSpace(description)
            ? "Không có mô tả"
            : description;
    }


    // =====================================================
    // STATE CHANGED
    // =====================================================

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        InvoiceState.OnChange = null;
    }
}