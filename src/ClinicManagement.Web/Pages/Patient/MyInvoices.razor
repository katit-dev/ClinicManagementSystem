@page "/patient/invoices"
@layout HomePageMaster
@attribute [Authorize(Roles = "Patient")]
@implements IDisposable

@using Microsoft.AspNetCore.Authorization
@using ClinicManagementSystem.Application.DTOs.Invoice
@inject PatientInvoiceStateService InvoiceState

<PageTitle>Hóa đơn của tôi</PageTitle>


<div class="patient-invoices-page">

    @* =====================================================
       PAGE HEADER
       ===================================================== *@

    <div class="patient-invoices-header">
        <h1>Hóa đơn của tôi</h1>
        <p>Theo dõi chi phí khám, thanh toán và lịch sử hóa đơn.</p>
    </div>


    @* =====================================================
       CONTENT
       ===================================================== *@

    <div class="patient-invoices-content">

        @if (InvoiceState.IsLoading)
        {
            <div class="patient-invoices-loading">
                Đang tải danh sách hóa đơn...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(InvoiceState.ErrorMessage))
        {
            <div class="patient-invoices-error">
                <p>@InvoiceState.ErrorMessage</p>

                <button type="button" @onclick="RetryAsync">
                    Thử lại
                </button>
            </div>
        }
        else if (InvoiceState.Invoices.Count == 0)
        {
            <div class="patient-invoices-empty">
                <i class="fas fa-file-invoice"></i>
                <h3>Chưa có hóa đơn</h3>
                <p>Bạn chưa có hóa đơn nào trong hệ thống.</p>
            </div>
        }
        else
        {
            <div class="patient-invoice-list">

                @foreach (var invoice in InvoiceState.Invoices)
                {
                    <div class="patient-invoice-card">

                        @* =================================================
                   HEADER
                   ================================================= *@

                        <div class="patient-invoice-card-header">

                            <div>
                                <div class="patient-invoice-number">
                                    @invoice.InvoiceNo
                                </div>

                                <div class="patient-invoice-date">
                                    @invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                            <span class="patient-invoice-status">
                                @GetInvoiceStatusText(invoice.Status)
                            </span>

                        </div>


                        @* =================================================
                   AMOUNTS
                   ================================================= *@

                        <div class="patient-invoice-summary">

                            <div class="patient-invoice-summary-item">
                                <span>Tổng hóa đơn</span>
                                <strong>@FormatMoney(GetPayableAmount(invoice))</strong>
                            </div>

                            <div class="patient-invoice-summary-item">
                                <span>Đã thanh toán</span>
                                <strong>@FormatMoney(invoice.PaidAmount)</strong>
                            </div>

                            <div class="patient-invoice-summary-item">
                                <span>Còn lại</span>
                                <strong>@FormatMoney(GetRemainingAmount(invoice))</strong>
                            </div>

                        </div>


                        @* =================================================
                   REFERENCE
                   ================================================= *@

                        <div class="patient-invoice-reference">

                            @if (invoice.AppointmentId.HasValue)
                            {
                                <span>
                                    Lịch hẹn #@invoice.AppointmentId
                                </span>
                            }

                            @if (invoice.MedicalRecordId.HasValue)
                            {
                                <span>
                                    Bệnh án #@invoice.MedicalRecordId
                                </span>
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>


@code {

    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        InvoiceState.OnChange = HandleStateChanged;

        await InvoiceState.LoadInvoicesAsync();
    }
    



    // INVOICE STATUS
    private string GetInvoiceStatusText(byte status)
    {
        return status switch
        {
            0 => "Chưa thanh toán",
            1 => "Thanh toán một phần",
            2 => "Đã thanh toán",
            3 => "Đã hủy",
            _ => "Không xác định"
        };
    }

    // PAYABLE AMOUNT
    private decimal GetPayableAmount(PatientInvoiceDTO invoice)
    {
        return invoice.TotalAmount
            + invoice.TaxAmount
            - invoice.DiscountAmount
            - invoice.InsuranceAmount;
    }


    // REMAINING AMOUNT
    private decimal GetRemainingAmount(PatientInvoiceDTO invoice)
    {
        var remaining = GetPayableAmount(invoice) - invoice.PaidAmount;

        return remaining < 0
            ? 0
            : remaining;
    }


    // FORMAT MONEY
    private string FormatMoney(decimal amount)
    {
        return $"{amount:N0} đ";
    }


    // =====================================================
    // RETRY
    // =====================================================

    private async Task RetryAsync()
    {
        await InvoiceState.LoadInvoicesAsync();
    }


    // =====================================================
    // STATE CHANGED
    // =====================================================

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        InvoiceState.OnChange = null;
    }
}