@page "/patient"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject NavigationManager _navigationManager
@inject UserStateService _userStateService


<PageTitle>Patient Dashboard</PageTitle>


@* =====================================================
   PATIENT DASHBOARD
   ===================================================== *@

<div>


    @* =====================================================
    WELCOME HEADER
    ===================================================== *@

    <section class="patient-welcome">

        @* =============================================
       WELCOME CONTENT
       ============================================= *@

        <div class="patient-welcome-content">

            <div class="patient-welcome-label">

                <i class="fas fa-heartbeat"></i>

                <span>
                    Tổng quan sức khỏe
                </span>

            </div>


            <h2 class="patient-welcome-title">

                Xin chào,

                <span>
                    @GetPatientName()
                </span>

                👋

            </h2>


            <p class="patient-welcome-description">

                Chào mừng bạn quay trở lại.
                Theo dõi lịch khám và thông tin
                sức khỏe của bạn tại đây.

            </p>

        </div>


        @* =============================================
       DECORATION
       ============================================= *@

        <div class="patient-welcome-icon">

            <i class="fas fa-user-md"></i>

        </div>

    </section>


    @* =================================================
       PATIENT FEATURES
       ================================================= *@

    <div class="row g-4">


        @* =================================================
           BOOKING
           ================================================= *@

        <div class="col-12 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="mb-3">

                        <h4 class="fw-bold mb-2">
                            Đặt lịch khám
                        </h4>

                        <p class="text-secondary mb-0">
                            Chọn bác sĩ, ngày khám
                            và khung giờ phù hợp.
                        </p>

                    </div>

                    <button type="button" class="btn btn-primary" @onclick="GoToBooking">

                        Đặt lịch khám

                    </button>

                </div>

            </div>

        </div>


        @* =================================================
           MY APPOINTMENTS
           ================================================= *@

        <div class="col-12 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="mb-3">

                        <h4 class="fw-bold mb-2">
                            Lịch hẹn của tôi
                        </h4>

                        <p class="text-secondary mb-0">
                            Theo dõi các lịch hẹn khám
                            đã đặt và trạng thái hiện tại.
                        </p>

                    </div>

                    <button type="button" class="btn btn-outline-primary" @onclick="GoToAppointments">

                        Xem lịch hẹn

                    </button>

                </div>

            </div>

        </div>


        @* =================================================
           MEDICAL RECORDS
           ================================================= *@

        <div class="col-12 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="mb-3">

                        <h4 class="fw-bold mb-2">
                            Lịch sử khám & đơn thuốc
                        </h4>

                        <p class="text-secondary mb-0">
                            Xem lại lịch sử khám bệnh
                            và các đơn thuốc đã được kê.
                        </p>

                    </div>

                    <button type="button" class="btn btn-outline-primary" @onclick="GoToRecords">

                        Xem lịch sử khám

                    </button>

                </div>

            </div>

        </div>


        @* =================================================
           INVOICES
           ================================================= *@

        <div class="col-12 col-md-6">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="mb-3">

                        <h4 class="fw-bold mb-2">
                            Hóa đơn của tôi
                        </h4>

                        <p class="text-secondary mb-0">
                            Theo dõi các hóa đơn
                            và thông tin thanh toán.
                        </p>

                    </div>

                    <button type="button" class="btn btn-outline-primary" @onclick="GoToInvoices">

                        Xem hóa đơn

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


@code {


    // =====================================================
    // GET PATIENT NAME
    // =====================================================

    private string GetPatientName()
    {
        var fullName =
            _userStateService
                .CurrentUser?
                .FullName;


        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "bạn";
        }


        return fullName;
    }

    // =====================================================
    // BOOKING NAVIGATION
    // =====================================================

    private void GoToBooking()
    {
        _navigationManager.NavigateTo(
            "/patient/booking"
        );
    }


    // =====================================================
    // APPOINTMENTS NAVIGATION
    // =====================================================

    private void GoToAppointments()
    {
        _navigationManager.NavigateTo(
            "/patient/appointments"
        );
    }


    // =====================================================
    // MEDICAL RECORDS NAVIGATION
    // =====================================================

    private void GoToRecords()
    {
        _navigationManager.NavigateTo(
            "/patient/records"
        );
    }


    // =====================================================
    // INVOICES NAVIGATION
    // =====================================================

    private void GoToInvoices()
    {
        _navigationManager.NavigateTo(
            "/patient/invoices"
        );
    }

}