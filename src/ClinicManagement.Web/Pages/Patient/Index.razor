@page "/patient"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject NavigationManager _navigationManager
@inject UserStateService _userStateService
@inject IPatientDashboardService _patientDashboardService
@using ClinicManagementSystem.Application.Enums;
@using ClinicManagementSystem.Application.DTOs.Appointment

<PageTitle>Patient Dashboard</PageTitle>


@* =====================================================
   PATIENT DASHBOARD
   ===================================================== *@

<div>


    @* =====================================================
    WELCOME HEADER
    ===================================================== *@

    <section class="patient-welcome">

        @* =============================================
       WELCOME CONTENT
       ============================================= *@

        <div class="patient-welcome-content">

            <div class="patient-welcome-label">

                <i class="fas fa-heartbeat"></i>

                <span>
                    Tổng quan sức khỏe
                </span>

            </div>


            <h2 class="patient-welcome-title">

                Xin chào,

                <span>
                    @GetPatientName()
                </span>

                👋

            </h2>


            <p class="patient-welcome-description">

                Chào mừng bạn quay trở lại.
                Theo dõi lịch khám và thông tin
                sức khỏe của bạn tại đây.

            </p>

        </div>


        @* =============================================
       DECORATION
       ============================================= *@

        <div class="patient-welcome-icon">

            <i class="fas fa-user-md"></i>

        </div>

    </section>

    @* =====================================================
    SUMMARY
    ==================================================== *@

    <section class="patient-summary">

        @* =================================================
       SECTION HEADER
       ================================================= *@

        <div class="patient-section-header">

            <div>

                <h3 class="patient-section-title">
                    Tổng quan lịch khám
                </h3>

                <p class="patient-section-description">
                    Theo dõi nhanh tình trạng các lịch hẹn của bạn.
                </p>

            </div>

        </div>

        @* =====================================================
         SUMMARY ERROR
        ===================================================== *@

        @if (_hasSummaryError)
        {
            <div class="patient-summary-error">

                <div class="patient-summary-error-content">

                    <i class="fas fa-exclamation-circle"></i>

                    <span>
                        Không thể tải dữ liệu tổng quan lịch khám.
                    </span>

                </div>


                <button type="button" class="patient-summary-retry" @onclick="LoadAppointmentSummaryAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }


        @* =================================================
       SUMMARY CARDS
       ================================================= *@

        <div class="patient-summary-grid">


            @* =============================================
           UPCOMING APPOINTMENTS
           ============================================= *@

            <div class="patient-summary-card">

                <div class="summary-card-icon summary-card-icon-upcoming">

                    <i class="fas fa-calendar-alt"></i>

                </div>


                <div class="summary-card-content">

                    <div class="summary-card-label">
                        Lịch hẹn sắp tới
                    </div>

                    <div class="summary-card-value">
                        @GetSummaryDisplayValue(
                            _upcomingAppointmentCount
                        )
                    </div>

                    <div class="summary-card-note">
                        Các lịch đang chờ khám
                    </div>

                </div>

            </div>


            @* =============================================
           COMPLETED APPOINTMENTS
           ============================================= *@

            <div class="patient-summary-card">

                <div class="summary-card-icon summary-card-icon-completed">

                    <i class="fas fa-check-circle"></i>

                </div>


                <div class="summary-card-content">

                    <div class="summary-card-label">
                        Đã khám
                    </div>

                    <div class="summary-card-value">
                        @GetSummaryDisplayValue(
                            _completedAppointmentCount
                        )
                    </div>

                    <div class="summary-card-note">
                        Các lịch đã hoàn thành
                    </div>

                </div>

            </div>


            @* =============================================
           CANCELLED APPOINTMENTS
           ============================================= *@

            <div class="patient-summary-card">

                <div class="summary-card-icon summary-card-icon-cancelled">

                    <i class="fas fa-calendar-times"></i>

                </div>


                <div class="summary-card-content">

                    <div class="summary-card-label">
                        Đã hủy
                    </div>

                    <div class="summary-card-value">
                        @GetSummaryDisplayValue(
                            _cancelledAppointmentCount
                        )
                    </div>

                    <div class="summary-card-note">
                        Các lịch đã được hủy
                    </div>

                </div>

            </div>

        </div>

    </section>

    @* =====================================================
    UPCOMING APPOINTMENT
    ===================================================== *@

    <section class="patient-upcoming">

        @* =================================================
        SECTION HEADER
        ================================================= *@

        <div class="patient-section-header">

            <div>

                <h3 class="patient-section-title">
                    Lịch hẹn gần nhất
                </h3>

                <p class="patient-section-description">
                    Thông tin lịch khám sắp tới của bạn.
                </p>

            </div>


            @if (!_isUpcomingLoading &&
                 !_hasUpcomingError &&
                 _nearestUpcomingAppointment != null)
            {
                <button type="button" class="patient-section-action" @onclick="GoToAppointments">

                    Xem tất cả

                    <i class="fas fa-arrow-right"></i>

                </button>
            }

        </div>


        @* =================================================
        LOADING
        ================================================= *@

        @if (_isUpcomingLoading)
        {
            <div class="upcoming-state-card">

                <div class="upcoming-state-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>

                <div>

                    <h4>
                        Đang tải lịch hẹn
                    </h4>

                    <p>
                        Vui lòng chờ trong giây lát.
                    </p>

                </div>

            </div>
        }


        @* =================================================
        ERROR
        ================================================= *@

        else if (_hasUpcomingError)
        {
            <div class="upcoming-state-card upcoming-state-error">

                <div class="upcoming-state-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <div class="upcoming-state-content">

                    <h4>
                        Không thể tải lịch hẹn
                    </h4>

                    <p>
                        Đã xảy ra lỗi khi tải lịch hẹn gần nhất.
                    </p>

                </div>


                <button type="button" class="patient-summary-retry" @onclick="LoadNearestUpcomingAppointmentAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }


        @* =================================================
        EMPTY
        ================================================= *@

        else if (_nearestUpcomingAppointment == null)
        {
            <div class="upcoming-state-card upcoming-state-empty">

                <div class="upcoming-state-icon">

                    <i class="far fa-calendar-plus"></i>

                </div>


                <div class="upcoming-state-content">

                    <h4>
                        Bạn chưa có lịch hẹn sắp tới
                    </h4>

                    <p>
                        Đặt lịch khám với bác sĩ
                        vào thời gian phù hợp với bạn.
                    </p>

                </div>


                <button type="button" class="patient-section-action" @onclick="GoToBooking">

                    <i class="fas fa-plus"></i>

                    Đặt lịch khám

                </button>

            </div>
        }
        @* =====================================================
   APPOINTMENT
   ===================================================== *@

        else
        {
            var appointment =
                _nearestUpcomingAppointment!;


            <div class="upcoming-appointment-card">

                @* =================================================
           DATE
           ================================================= *@

                <div class="upcoming-date">

                    <span class="upcoming-date-day">
                        @(appointment.StartTime.ToString("dd"))
                    </span>

                    <span class="upcoming-date-month">
                        Tháng @(appointment.StartTime.ToString("MM"))
                    </span>

                </div>


                @* =================================================
           APPOINTMENT INFORMATION
           ================================================= *@

                <div class="upcoming-information">

                    @* =============================================
               DOCTOR
               ============================================= *@

                    <div class="upcoming-doctor">

                        <div class="upcoming-doctor-icon">

                            <i class="fas fa-user-md"></i>

                        </div>


                        <div>

                            <h4 class="upcoming-doctor-name">
                                @(appointment.DoctorName)
                            </h4>

                            <div class="upcoming-specialty">
                                @(appointment.SpecialtyName)
                            </div>

                        </div>

                    </div>


                    @* =============================================
               DETAILS
               ============================================= *@

                    <div class="upcoming-details">

                        @* =========================================
                   TIME
                   ========================================= *@

                        <div class="upcoming-detail">

                            <i class="far fa-clock"></i>

                            <span>
                                @(appointment.StartTime.ToString("HH:mm"))
                                -
                                @(appointment.EndTime.ToString("HH:mm"))
                            </span>

                        </div>


                        @* =========================================
                   DATE
                   ========================================= *@

                        <div class="upcoming-detail">

                            <i class="far fa-calendar"></i>

                            <span>
                                @(appointment.StartTime.ToString("dd/MM/yyyy"))
                            </span>

                        </div>


                        @* =========================================
                   APPOINTMENT CODE
                   ========================================= *@

                        <div class="upcoming-detail">

                            <i class="fas fa-ticket-alt"></i>

                            <span>
                                @(appointment.AppointmentCode)
                            </span>

                        </div>


                        @* =========================================
                   QUEUE NUMBER
                   ========================================= *@

                        @if (appointment.QueueNumber.HasValue)
                        {
                            <div class="upcoming-detail">

                                <i class="fas fa-list-ol"></i>

                                <span>
                                    Số thứ tự:
                                    @(appointment.QueueNumber.Value)
                                </span>

                            </div>
                        }

                    </div>

                </div>


                @* =================================================
           STATUS
           ================================================= *@

                <div class="upcoming-status">

                    <span class="@GetAppointmentStatusClass(appointment.Status)">

                        @GetAppointmentStatusText(
                            appointment.Status
                        )

                    </span>

                </div>

            </div>
        }


        

    </section>

   
    

</div>
@code {

    // =====================================================
    // UPCOMING APPOINTMENT STATE
    // =====================================================

    private MyAppointmentDTO? _nearestUpcomingAppointment;

    private bool _isUpcomingLoading = true;

    private bool _hasUpcomingError;

    // =====================================================
    // SUMMARY STATE
    // =====================================================

    private int? _upcomingAppointmentCount;

    private int? _completedAppointmentCount;

    private int? _cancelledAppointmentCount;


    private bool _isSummaryLoading = true;

    private bool _hasSummaryError;

    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointmentSummaryAsync();

        await LoadNearestUpcomingAppointmentAsync();
    }

    // =====================================================
    // GET APPOINTMENT STATUS TEXT
    // =====================================================

    private string GetAppointmentStatusText(
        byte status)
    {
        return status switch
        {
            0 => "Chờ xác nhận",
            1 => "Đã xác nhận",
            2 => "Đã check-in",
            3 => "Đã hoàn thành",
            4 => "Đã hủy",
            5 => "Vắng mặt",

            _ => "Không xác định"
        };
    }


    // =====================================================
    // GET APPOINTMENT STATUS CLASS
    // =====================================================

    private string GetAppointmentStatusClass(
        byte status)
    {
        return status switch
        {
            0 => "appointment-status appointment-status-pending",

            1 => "appointment-status appointment-status-confirmed",

            2 => "appointment-status appointment-status-checked-in",

            3 => "appointment-status appointment-status-completed",

            4 => "appointment-status appointment-status-cancelled",

            5 => "appointment-status appointment-status-no-show",

            _ => "appointment-status"
        };
    }

    // =====================================================
    // LOAD NEAREST UPCOMING APPOINTMENT
    // =====================================================
    private async Task LoadNearestUpcomingAppointmentAsync()
    {
        // =================================================
        // START LOADING
        // =================================================

        _isUpcomingLoading = true;

        _hasUpcomingError = false;

        _nearestUpcomingAppointment = null;


        try
        {
            // =================================================
            // GET UPCOMING APPOINTMENTS
            // =================================================

            var appointments =
                await _patientDashboardService
                    .GetAppointmentsAsync(
                        MyAppointmentFilter.Upcoming
                    );


            // =================================================
            // API FAILED
            // =================================================

            if (appointments == null)
            {
                _hasUpcomingError = true;

                return;
            }


            // =================================================
            // GET NEAREST APPOINTMENT
            //
            // List rỗng => FirstOrDefault() trả null.
            // Đây là trạng thái hợp lệ, không phải lỗi.
            // =================================================

            _nearestUpcomingAppointment =
                appointments
                    .OrderBy(
                        appointment =>
                            appointment.StartTime
                    )
                    .FirstOrDefault();
        }
        catch
        {
            _hasUpcomingError = true;
        }
        finally
        {
            _isUpcomingLoading = false;
        }
    }

    // =====================================================
    // LOAD APPOINTMENT SUMMARY
    // =====================================================
    private async Task LoadAppointmentSummaryAsync()
    {
        // =================================================
        // START LOADING
        // =================================================

        _isSummaryLoading = true;

        _hasSummaryError = false;


        _upcomingAppointmentCount = null;

        _completedAppointmentCount = null;

        _cancelledAppointmentCount = null;


        try
        {
            // =================================================
            // UPCOMING
            // =================================================

            var upcomingCount =
                await _patientDashboardService
                    .GetAppointmentCountAsync(
                        MyAppointmentFilter.Upcoming
                    );


            // =================================================
            // COMPLETED
            // =================================================

            var completedCount =
                await _patientDashboardService
                    .GetAppointmentCountAsync(
                        MyAppointmentFilter.Completed
                    );


            // =================================================
            // CANCELLED
            // =================================================

            var cancelledCount =
                await _patientDashboardService
                    .GetAppointmentCountAsync(
                        MyAppointmentFilter.Cancelled
                    );


            // =================================================
            // CHECK ERROR
            // =================================================

            if (!upcomingCount.HasValue ||
                !completedCount.HasValue ||
                !cancelledCount.HasValue)
            {
                _hasSummaryError = true;

                return;
            }


            // =================================================
            // UPDATE STATE
            // =================================================

            _upcomingAppointmentCount =
                upcomingCount.Value;

            _completedAppointmentCount =
                completedCount.Value;

            _cancelledAppointmentCount =
                cancelledCount.Value;
        }
        catch
        {
            _hasSummaryError = true;
        }
        finally
        {
            _isSummaryLoading = false;
        }
    }

    // =====================================================
    // GET SUMMARY DISPLAY VALUE
    // =====================================================

    private string GetSummaryDisplayValue(
        int? value)
    {
        if (_isSummaryLoading)
        {
            return "...";
        }


        if (_hasSummaryError ||
            !value.HasValue)
        {
            return "--";
        }


        return value.Value.ToString();
    }


    // =====================================================
    // GET PATIENT NAME
    // =====================================================

    private string GetPatientName()
    {
        var fullName =
            _userStateService
                .CurrentUser?
                .FullName;


        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "bạn";
        }


        return fullName;
    }

    // =====================================================
    // BOOKING NAVIGATION
    // =====================================================

    private void GoToBooking()
    {
        _navigationManager.NavigateTo(
            "/patient/booking"
        );
    }


    // =====================================================
    // APPOINTMENTS NAVIGATION
    // =====================================================

    private void GoToAppointments()
    {
        _navigationManager.NavigateTo(
            "/patient/appointments"
        );
    }


    // =====================================================
    // MEDICAL RECORDS NAVIGATION
    // =====================================================

    private void GoToRecords()
    {
        _navigationManager.NavigateTo(
            "/patient/records"
        );
    }


    // =====================================================
    // INVOICES NAVIGATION
    // =====================================================

    private void GoToInvoices()
    {
        _navigationManager.NavigateTo(
            "/patient/invoices"
        );
    }

}