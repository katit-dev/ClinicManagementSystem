@page "/patient/appointments"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject PatientAppointmentStateService _appointmentStateService

@implements IDisposable

@using ClinicManagementSystem.Application.DTOs.Appointment
@using ClinicManagementSystem.Application.Enums


<PageTitle>Lịch hẹn của tôi</PageTitle>


@* =====================================================
   MY APPOINTMENTS PAGE
   ===================================================== *@

<div class="appointments-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="appointments-header">

        <div>

            <div class="appointments-header-label">

                <i class="fas fa-calendar-check"></i>

                <span>
                    VC-04
                </span>

            </div>


            <h1 class="appointments-title">
                Lịch hẹn của tôi
            </h1>


            <p class="appointments-description">
                Theo dõi và quản lý các lịch hẹn khám
                của bạn.
            </p>

        </div>

    </div>


    @* =================================================
       FILTERS
       ================================================= *@

    <div class="appointments-filter">

        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.All)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.All)">

            <i class="fas fa-list"></i>

            Tất cả

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Upcoming)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Upcoming)">

            <i class="far fa-clock"></i>

            Sắp tới

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Completed)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Completed)">

            <i class="fas fa-check-circle"></i>

            Hoàn thành

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Cancelled)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Cancelled)">

            <i class="fas fa-times-circle"></i>

            Đã hủy

        </button>

    </div>


    @* =================================================
       APPOINTMENT CONTENT
       ================================================= *@

    <section class="appointments-content">


        @* =================================================
           CONTENT HEADER
           ================================================= *@

        <div class="appointments-content-header">

            <div>

                <h2>
                    @GetFilterTitle()
                </h2>


                <p>
                    @GetFilterDescription()
                </p>

            </div>

        </div>


        @* =================================================
           LOADING
           ================================================= *@

        @if (_appointmentStateService.IsLoading)
        {
            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>


                <h3>
                    Đang tải lịch hẹn
                </h3>


                <p>
                    Vui lòng chờ trong giây lát.
                </p>

            </div>
        }


        @* =================================================
           ERROR
           ================================================= *@

        else if (!string.IsNullOrWhiteSpace(
            _appointmentStateService.ErrorMessage))
        {
            <div class="appointments-placeholder appointments-error">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <h3>
                    Không thể tải lịch hẹn
                </h3>


                <p>
                    @_appointmentStateService.ErrorMessage
                </p>


                <button type="button" class="appointments-retry-button" @onclick="RetryAppointmentsAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }


        @* =================================================
           EMPTY
           ================================================= *@

        else if (_appointmentStateService.Appointments.Count == 0)
        {
            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="far fa-calendar-times"></i>

                </div>


                <h3>
                    Chưa có lịch hẹn
                </h3>


                <p>
                    Bạn chưa có lịch hẹn nào
                    trong nhóm đang xem.
                </p>

            </div>
        }


        @* =================================================
           APPOINTMENT LIST
           ================================================= *@

        else
        {
            <div class="appointment-list">

                @foreach (var appointment in
                    _appointmentStateService.Appointments)
                {
                    <article class="appointment-card">


                        @* =====================================
                           DATE
                           ===================================== *@

                        <div class="appointment-date">

                            <span class="appointment-date-day">

                                @(appointment.StartTime
                                    .ToString("dd"))

                            </span>


                            <span class="appointment-date-month">

                                Tháng
                                @(appointment.StartTime
                                    .ToString("MM"))

                            </span>


                            <span class="appointment-date-year">

                                @(appointment.StartTime
                                    .ToString("yyyy"))

                            </span>

                        </div>


                        @* =====================================
                           CONTENT
                           ===================================== *@

                        <div class="appointment-card-content">


                            @* =================================
                               HEADER
                               ================================= *@

                            <div class="appointment-card-header">

                                <div>

                                    <span class="appointment-code">
                                        @appointment.AppointmentCode
                                    </span>


                                    <h3 class="appointment-doctor">
                                        @appointment.DoctorName
                                    </h3>


                                    <p class="appointment-specialty">

                                        <i class="fas fa-stethoscope"></i>

                                        @appointment.SpecialtyName

                                    </p>

                                </div>


                                <span class="appointment-status @GetStatusClass(appointment.Status)">

                                    @GetStatusText(
                                        appointment.Status)

                                </span>

                            </div>


                            @* =================================
                               DETAILS
                               ================================= *@

                            <div class="appointment-details">


                                @* =============================
                                   TIME
                                   ============================= *@

                                <div class="appointment-detail-item">

                                    <i class="far fa-clock"></i>


                                    <div>

                                        <span>
                                            Thời gian
                                        </span>


                                        <strong>

                                            @(appointment.StartTime
                                                .ToString("HH:mm"))

                                            -

                                            @(appointment.EndTime
                                                .ToString("HH:mm"))

                                        </strong>

                                    </div>

                                </div>


                                @* =============================
                                   DATE
                                   ============================= *@

                                <div class="appointment-detail-item">

                                    <i class="far fa-calendar-alt"></i>


                                    <div>

                                        <span>
                                            Ngày khám
                                        </span>


                                        <strong>

                                            @(appointment.StartTime
                                                .ToString("dd/MM/yyyy"))

                                        </strong>

                                    </div>

                                </div>


                                @* =============================
                                   QUEUE NUMBER
                                   ============================= *@

                                @if (appointment.QueueNumber.HasValue)
                                {
                                    <div class="appointment-detail-item">

                                        <i class="fas fa-list-ol"></i>


                                        <div>

                                            <span>
                                                Số thứ tự
                                            </span>


                                            <strong>

                                                #@appointment.QueueNumber.Value

                                            </strong>

                                        </div>

                                    </div>
                                }

                            </div>


                            @* =================================
                               ACTIONS
                               ================================= *@

                            @if (CanCancelAppointment(
                                appointment))
                            {
                                <div class="appointment-actions">

                                    <button type="button" class="appointment-cancel-button"
                                            @onclick="() => OpenCancelAppointment(appointment.Id)">

                                        <i class="fas fa-times"></i>

                                        Hủy lịch

                                    </button>

                                </div>
                            }
                            
                            @* =================================
                            CANCEL FORM
                             ================================= *@

                            @if (_cancelAppointmentId ==
                                appointment.Id)
                            {
                                <div class="appointment-cancel-form">

                                    <div class="appointment-cancel-form-header">

                                        <div>

                                            <h4>
                                                Hủy lịch hẹn
                                            </h4>

                                            <p>
                                                Vui lòng nhập lý do hủy lịch.
                                            </p>

                                        </div>

                                    </div>


                                    <textarea class="appointment-cancel-reason" rows="3" maxlength="500"
                                              placeholder="Ví dụ: Tôi có việc đột xuất..." value="@_cancelReason"
                                              @oninput="HandleCancelReasonChanged"></textarea>


                                    <div class="appointment-cancel-count">

                                        @_cancelReason.Length/500

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
    _appointmentStateService.CancelErrorMessage))
                                    {
                                        <div class="appointment-cancel-error">

                                            <i class="fas fa-exclamation-circle"></i>

                                            <span>
                                                @_appointmentStateService.CancelErrorMessage
                                            </span>

                                        </div>
                                    }


                                    <div class="appointment-cancel-form-actions">

                                        <button type="button" class="appointment-cancel-close-button"
                                                @onclick="CloseCancelAppointment">

                                            Đóng

                                        </button>


                                        <button type="button" class="appointment-cancel-confirm-button"
                                                disabled="@_appointmentStateService.IsCancelling" @onclick="() => ConfirmCancelAppointmentAsync(
                                                    appointment.Id)">

                                            @if (_appointmentStateService.IsCancelling &&
                                _appointmentStateService.CancellingAppointmentId == appointment.Id)
                                            {
                                                <i class="fas fa-spinner fa-spin"></i>

                                                <span>
                                                    Đang hủy...
                                                </span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle"></i>

                                                <span>
                                                    Xác nhận hủy
                                                </span>
                                            }

                                        </button>

                                    </div>

                                </div>
                            }

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


@code
{
    // STATE
    private int? _cancelAppointmentId;
    private string _cancelReason = string.Empty;



    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {

        _appointmentStateService.OnChange +=
            HandleAppointmentStateChanged;


        _appointmentStateService.Reset();

        await _appointmentStateService
            .LoadAppointmentsAsync();
    }

    // CHANGE FILTER
    private async Task ChangeFilterAsync(
        MyAppointmentFilter filter)
    {
        // SAME FILTER
        if (_appointmentStateService.CurrentFilter == filter &&
            _appointmentStateService.Appointments.Count > 0)
        {
            return;
        }


        // LOAD FILTER
        await _appointmentStateService
            .LoadAppointmentsAsync(
                filter
            );
    }


    // =====================================================
    // RETRY APPOINTMENTS
    // =====================================================

    private async Task RetryAppointmentsAsync()
    {
        await _appointmentStateService
            .LoadAppointmentsAsync(
                _appointmentStateService.CurrentFilter
            );
    }


    // =====================================================
    // GET FILTER CLASS
    // =====================================================

    private string GetFilterClass(
        MyAppointmentFilter filter)
    {
        return _appointmentStateService.CurrentFilter == filter
            ? "active"
            : string.Empty;
    }


    // =====================================================
    // GET FILTER TITLE
    // =====================================================

    private string GetFilterTitle()
    {
        return _appointmentStateService.CurrentFilter switch
        {
            MyAppointmentFilter.All =>
                "Tất cả lịch hẹn",

            MyAppointmentFilter.Upcoming =>
                "Lịch hẹn sắp tới",

            MyAppointmentFilter.Completed =>
                "Lịch hẹn đã hoàn thành",

            MyAppointmentFilter.Cancelled =>
                "Lịch hẹn đã hủy",

            _ =>
                "Danh sách lịch hẹn"
        };
    }


    // =====================================================
    // GET FILTER DESCRIPTION
    // =====================================================

    private string GetFilterDescription()
    {
        return _appointmentStateService.CurrentFilter switch
        {
            MyAppointmentFilter.All =>
                "Toàn bộ lịch hẹn của bạn.",

            MyAppointmentFilter.Upcoming =>
                "Các lịch hẹn sắp diễn ra.",

            MyAppointmentFilter.Completed =>
                "Các lịch khám đã hoàn thành.",

            MyAppointmentFilter.Cancelled =>
                "Các lịch hẹn đã được hủy.",

            _ =>
                string.Empty
        };
    }


    // =====================================================
    // GET APPOINTMENT STATUS TEXT
    // =====================================================

    private string GetStatusText(
        byte status)
    {
        return status switch
        {
            0 =>
                "Chờ xác nhận",

            1 =>
                "Đã xác nhận",

            2 =>
                "Đã check-in",

            3 =>
                "Hoàn thành",

            4 =>
                "Đã hủy",

            5 =>
                "Không đến",

            _ =>
                "Không xác định"
        };
    }


    // =====================================================
    // GET APPOINTMENT STATUS CLASS
    // =====================================================

    private string GetStatusClass(
        byte status)
    {
        return status switch
        {
            0 =>
                "pending",

            1 =>
                "confirmed",

            2 =>
                "checked-in",

            3 =>
                "completed",

            4 =>
                "cancelled",

            5 =>
                "no-show",

            _ =>
                string.Empty
        };
    }


    // =====================================================
    // CAN CANCEL APPOINTMENT
    // =====================================================

    private bool CanCancelAppointment(
        MyAppointmentDTO appointment)
    {
        // =================================================
        // CHỈ PENDING / CONFIRMED
        // VÀ LỊCH PHẢI Ở TƯƠNG LAI
        //
        // 0 = Pending
        // 1 = Confirmed
        // =================================================

        var canCancelStatus =
            appointment.Status == 0 ||
            appointment.Status == 1;


        var isFuture =
            appointment.StartTime >
            DateTime.Now;


        return canCancelStatus &&
               isFuture;
    }


    // =====================================================
    // OPEN CANCEL APPOINTMENT
    // =====================================================

    private void OpenCancelAppointment(
        int appointmentId)
    {
        _appointmentStateService
            .ClearCancelError();


        _cancelAppointmentId =
            appointmentId;

        _cancelReason =
            string.Empty;
    }


    // =====================================================
    // CLOSE CANCEL APPOINTMENT
    // =====================================================

    private void CloseCancelAppointment()
    {
        _appointmentStateService
            .ClearCancelError();


        _cancelAppointmentId =
            null;

        _cancelReason =
            string.Empty;
    }

    // =====================================================
    // CONFIRM CANCEL APPOINTMENT
    // =====================================================

    private async Task ConfirmCancelAppointmentAsync(
        int appointmentId)
    {
        var success =
            await _appointmentStateService
                .CancelAppointmentAsync(
                    appointmentId,
                    _cancelReason
                );


        if (!success)
        {
            return;
        }


        // =================================================
        // CLOSE FORM
        // =================================================

        _cancelAppointmentId =
            null;

        _cancelReason =
            string.Empty;


        // =================================================
        // RELOAD CURRENT FILTER
        // =================================================

        await _appointmentStateService
            .LoadAppointmentsAsync(
                _appointmentStateService.CurrentFilter
            );
    }

    // =====================================================
    // HANDLE CANCEL REASON CHANGED
    // =====================================================

    private void HandleCancelReasonChanged(
        ChangeEventArgs e)
    {
        _cancelReason = e.Value?.ToString() ?? string.Empty;
    }


    // =====================================================
    // HANDLE STATE CHANGED
    // =====================================================

    private void HandleAppointmentStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _appointmentStateService.OnChange -=
            HandleAppointmentStateChanged;
    }
}