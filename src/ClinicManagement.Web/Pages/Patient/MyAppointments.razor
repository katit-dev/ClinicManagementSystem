@page "/patient/appointments"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject PatientAppointmentStateService _appointmentStateService

@implements IDisposable


<PageTitle>Lịch hẹn của tôi</PageTitle>


@* =====================================================
   MY APPOINTMENTS PAGE
   ===================================================== *@

<div class="appointments-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="appointments-header">

        <div>

            <h1 class="appointments-title">
                Lịch hẹn của tôi
            </h1>


            <p class="appointments-description">
                Theo dõi và quản lý các lịch hẹn khám
                của bạn.
            </p>

        </div>

    </div>


    @* =================================================
       FILTERS
       ================================================= *@

    <div class="appointments-filter">

        <button type="button" class="appointments-filter-button active">

            <i class="fas fa-list"></i>

            Tất cả

        </button>


        <button type="button" class="appointments-filter-button">

            <i class="far fa-clock"></i>

            Sắp tới

        </button>


        <button type="button" class="appointments-filter-button">

            <i class="fas fa-check-circle"></i>

            Hoàn thành

        </button>


        <button type="button" class="appointments-filter-button">

            <i class="fas fa-times-circle"></i>

            Đã hủy

        </button>

    </div>


    @* =================================================
       APPOINTMENT CONTENT
       ================================================= *@

    <section class="appointments-content">

        <div class="appointments-content-header">

            <div>

                <h2>
                    Danh sách lịch hẹn
                </h2>

                <p>
                    Các lịch hẹn của bạn sẽ được
                    hiển thị tại đây.
                </p>

            </div>

        </div>


        @* =================================================
           PLACEHOLDER
           ================================================= *@

        @* =================================================
   APPOINTMENT STATE
   ================================================= *@

        @if (_appointmentStateService.IsLoading)
        {
            @* =============================================
       LOADING
       ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>


                <h3>
                    Đang tải lịch hẹn
                </h3>


                <p>
                    Vui lòng chờ trong giây lát.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(
            _appointmentStateService.ErrorMessage))
        {
            @* =============================================
       ERROR
       ============================================= *@

            <div class="appointments-placeholder appointments-error">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <h3>
                    Không thể tải lịch hẹn
                </h3>


                <p>
                    @_appointmentStateService.ErrorMessage
                </p>


                <button type="button" class="appointments-retry-button" @onclick="RetryAppointmentsAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }
        else if (_appointmentStateService.Appointments.Count == 0)
        {
            @* =============================================
       EMPTY
       ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="far fa-calendar-times"></i>

                </div>


                <h3>
                    Chưa có lịch hẹn
                </h3>


                <p>
                    Bạn chưa có lịch hẹn nào
                    trong nhóm đang xem.
                </p>

            </div>
        }
        else
        {
            @* =============================================
       DATA LOADED
       ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-calendar-check"></i>

                </div>


                <h3>
                    Đã tải lịch hẹn
                </h3>


                <p>
                    Có @_appointmentStateService.Appointments.Count
                    lịch hẹn.
                </p>

            </div>
        }

    </section>

</div>

@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _appointmentStateService.OnChange +=
            HandleAppointmentStateChanged;


        // =================================================
        // RESET STATE
        // =================================================

        _appointmentStateService.Reset();


        // =================================================
        // LOAD ALL APPOINTMENTS
        // =================================================

        await _appointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // RETRY APPOINTMENTS
    // =====================================================

    private async Task RetryAppointmentsAsync()
    {
        await _appointmentStateService
            .LoadAppointmentsAsync(
                _appointmentStateService.CurrentFilter
            );
    }


    // =====================================================
    // HANDLE STATE CHANGED
    // =====================================================

    private void HandleAppointmentStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _appointmentStateService.OnChange -=
            HandleAppointmentStateChanged;
    }
}