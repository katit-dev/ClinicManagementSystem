@page "/patient/appointments"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject PatientAppointmentStateService _appointmentStateService

@implements IDisposable

@using ClinicManagementSystem.Application.Enums


<PageTitle>Lịch hẹn của tôi</PageTitle>


@* =====================================================
   MY APPOINTMENTS PAGE
   ===================================================== *@

<div class="appointments-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="appointments-header">

        <div>

            <h1 class="appointments-title">
                Lịch hẹn của tôi
            </h1>


            <p class="appointments-description">
                Theo dõi và quản lý các lịch hẹn khám
                của bạn.
            </p>

        </div>

    </div>


    @* =================================================
    FILTERS
    ================================================= *@

    <div class="appointments-filter">

        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.All)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.All)">

            <i class="fas fa-list"></i>

            Tất cả

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Upcoming)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Upcoming)">

            <i class="far fa-clock"></i>

            Sắp tới

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Completed)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Completed)">

            <i class="fas fa-check-circle"></i>

            Hoàn thành

        </button>


        <button type="button" class="appointments-filter-button @GetFilterClass(MyAppointmentFilter.Cancelled)"
                @onclick="() => ChangeFilterAsync(MyAppointmentFilter.Cancelled)">

            <i class="fas fa-times-circle"></i>

            Đã hủy

        </button>

    </div>


    @* =================================================
       APPOINTMENT CONTENT
       ================================================= *@

    <section class="appointments-content">

        <div class="appointments-content-header">

            <div>

                <h2>
                    @GetFilterTitle()
                </h2>

                <p>
                    Các lịch hẹn của bạn sẽ được
                    hiển thị tại đây.
                </p>

            </div>

        </div>


        @* =================================================
           PLACEHOLDER
           ================================================= *@

        @* =================================================
        APPOINTMENT STATE
        ================================================= *@

        @if (_appointmentStateService.IsLoading)
        {
            @* =============================================
            LOADING
            ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>


                <h3>
                    Đang tải lịch hẹn
                </h3>


                <p>
                    Vui lòng chờ trong giây lát.
                </p>

            </div>
        }
        else if (!string.IsNullOrWhiteSpace(
            _appointmentStateService.ErrorMessage))
        {
            @* =============================================
       ERROR
       ============================================= *@

            <div class="appointments-placeholder appointments-error">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <h3>
                    Không thể tải lịch hẹn
                </h3>


                <p>
                    @_appointmentStateService.ErrorMessage
                </p>


                <button type="button" class="appointments-retry-button" @onclick="RetryAppointmentsAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }
        else if (_appointmentStateService.Appointments.Count == 0)
        {
            @* =============================================
            EMPTY
            ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="far fa-calendar-times"></i>

                </div>


                <h3>
                    Chưa có lịch hẹn
                </h3>


                <p>
                    Bạn chưa có lịch hẹn nào
                    trong nhóm đang xem.
                </p>

            </div>
        }
        else
        {
            @* =============================================
            DATA LOADED
            ============================================= *@

            <div class="appointments-placeholder">

                <div class="appointments-placeholder-icon">

                    <i class="fas fa-calendar-check"></i>

                </div>


                <h3>
                    Đã tải lịch hẹn
                </h3>


                <p>
                    Có @_appointmentStateService.Appointments.Count
                    lịch hẹn.
                </p>

            </div>
        }

    </section>

</div>

@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _appointmentStateService.OnChange +=
            HandleAppointmentStateChanged;


        // =================================================
        // RESET STATE
        // =================================================

        _appointmentStateService.Reset();


        // =================================================
        // LOAD ALL APPOINTMENTS
        // =================================================

        await _appointmentStateService
            .LoadAppointmentsAsync();
    }


    // =====================================================
    // RETRY APPOINTMENTS
    // =====================================================

    private async Task RetryAppointmentsAsync()
    {
        await _appointmentStateService
            .LoadAppointmentsAsync(
                _appointmentStateService.CurrentFilter
            );
    }

    // =====================================================
    // CHANGE FILTER
    // =====================================================

    private async Task ChangeFilterAsync(
        MyAppointmentFilter filter)
    {
        // =================================================
        // SAME FILTER
        // =================================================

        if (_appointmentStateService.CurrentFilter == filter &&
            _appointmentStateService.Appointments.Count > 0)
        {
            return;
        }


        // =================================================
        // LOAD APPOINTMENTS BY FILTER
        // =================================================

        await _appointmentStateService
            .LoadAppointmentsAsync(
                filter
            );
    }

    // =====================================================
    // GET FILTER CLASS
    // =====================================================

    private string GetFilterClass(
        MyAppointmentFilter filter)
    {
        return _appointmentStateService.CurrentFilter == filter
            ? "active"
            : string.Empty;
    }

    // =====================================================
    // GET FILTER TITLE
    // =====================================================

    private string GetFilterTitle()
    {
        return _appointmentStateService.CurrentFilter switch
        {
            MyAppointmentFilter.All =>
                "Tất cả lịch hẹn",

            MyAppointmentFilter.Upcoming =>
                "Lịch hẹn sắp tới",

            MyAppointmentFilter.Completed =>
                "Lịch hẹn đã hoàn thành",

            MyAppointmentFilter.Cancelled =>
                "Lịch hẹn đã hủy",

            _ =>
                "Danh sách lịch hẹn"
        };
    }


    // =====================================================
    // GET FILTER DESCRIPTION
    // =====================================================

    private string GetFilterDescription()
    {
        return _appointmentStateService.CurrentFilter switch
        {
            MyAppointmentFilter.All =>
                "Toàn bộ lịch hẹn của bạn.",

            MyAppointmentFilter.Upcoming =>
                "Các lịch hẹn sắp diễn ra.",

            MyAppointmentFilter.Completed =>
                "Các lịch khám đã hoàn thành.",

            MyAppointmentFilter.Cancelled =>
                "Các lịch hẹn đã được hủy.",

            _ =>
                string.Empty
        };
    }

    // =====================================================
    // HANDLE STATE CHANGED
    // =====================================================

    private void HandleAppointmentStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _appointmentStateService.OnChange -=
            HandleAppointmentStateChanged;
    }
}