@page "/patient/booking"

@layout PatientLayout

@attribute [Authorize(Roles = "Patient")]

@inject NavigationManager _navigationManager


<PageTitle>Đặt lịch khám</PageTitle>


@* =====================================================
   PATIENT BOOKING PAGE
   ===================================================== *@

<div>


    @* =================================================
       HEADER
       ================================================= *@

    <div class="d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h2 class="fw-bold mb-2">
                Đặt lịch khám
            </h2>

            <p class="text-secondary mb-0">
                Chọn chuyên khoa, bác sĩ,
                ngày khám và khung giờ phù hợp.
            </p>

        </div>


        <button type="button"
                class="btn btn-outline-secondary"
                @onclick="GoBack">

            Quay lại

        </button>

    </div>


    @* =================================================
       BOOKING FORM
       ================================================= *@

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">


            @* =================================================
               SPECIALTY
               ================================================= *@

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Chuyên khoa
                </label>

                <select class="form-select"
                        disabled>

                    <option>
                        Chọn chuyên khoa
                    </option>

                </select>

                <div class="form-text">
                    Danh sách chuyên khoa sẽ được tải từ hệ thống.
                </div>

            </div>


            @* =================================================
               DOCTOR
               ================================================= *@

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Bác sĩ
                </label>

                <select class="form-select"
                        disabled>

                    <option>
                        Chọn bác sĩ
                    </option>

                </select>

                <div class="form-text">
                    Danh sách bác sĩ sẽ phụ thuộc
                    vào chuyên khoa đã chọn.
                </div>

            </div>


            @* =================================================
               APPOINTMENT DATE
               ================================================= *@

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Ngày khám
                </label>

                <input type="date"
                       class="form-control"
                       disabled />

                <div class="form-text">
                    Chọn ngày khám phù hợp với lịch làm việc của bác sĩ.
                </div>

            </div>


            @* =================================================
               TIME SLOT
               ================================================= *@

            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Khung giờ khám
                </label>

                <select class="form-select"
                        disabled>

                    <option>
                        Chọn khung giờ
                    </option>

                </select>

                <div class="form-text">
                    Các khung giờ còn trống sẽ được hiển thị tại đây.
                </div>

            </div>


            @* =================================================
               SUBMIT
               ================================================= *@

            <div class="d-grid d-md-flex
                        justify-content-md-end">

                <button type="button"
                        class="btn btn-primary px-4"
                        disabled>

                    Đặt lịch

                </button>

            </div>

        </div>

    </div>

</div>


@code {

    // =====================================================
    // BACK TO PATIENT DASHBOARD
    // =====================================================

    private void GoBack()
    {
        _navigationManager.NavigateTo(
            "/patient"
        );
    }

}