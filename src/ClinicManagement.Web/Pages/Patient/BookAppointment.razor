@page "/patient/booking"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject BookingStateService _bookingStateService

@implements IDisposable

@using ClinicManagementSystem.Application.DTOs.Doctor
@using ClinicManagementSystem.Application.DTOs.Appointment


<PageTitle>Đặt lịch khám</PageTitle>


@* =====================================================
   BOOKING PAGE
   ===================================================== *@

<div class="booking-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="booking-header">

        <div>

            <div class="booking-header-label">

                <i class="fas fa-calendar-plus"></i>

                <span>
                    VC-03
                </span>

            </div>


            <h1 class="booking-title">
                Đặt lịch khám
            </h1>


            <p class="booking-description">
                Chọn chuyên khoa, bác sĩ và thời gian
                phù hợp để tạo lịch khám mới.
            </p>

        </div>

    </div>


    @* =====================================================
       BOOKING STEPS
       ===================================================== *@

    <div class="booking-steps">


        @* =================================================
           STEP 1 - SPECIALTY
           ================================================= *@

        <div class="booking-step @GetStepClass(1)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 1)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>1</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 1
                </span>

                <span class="booking-step-title">
                    Chuyên khoa
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(1)">
        </div>


        @* =================================================
           STEP 2 - DOCTOR
           ================================================= *@

        <div class="booking-step @GetStepClass(2)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 2)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>2</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 2
                </span>

                <span class="booking-step-title">
                    Bác sĩ
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(2)">
        </div>


        @* =================================================
           STEP 3 - TIME
           ================================================= *@

        <div class="booking-step @GetStepClass(3)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 3)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>3</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 3
                </span>

                <span class="booking-step-title">
                    Thời gian
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(3)">
        </div>


        @* =================================================
           STEP 4 - CONFIRM
           ================================================= *@

        <div class="booking-step @GetStepClass(4)">

            <div class="booking-step-number">

                <span>
                    4
                </span>

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 4
                </span>

                <span class="booking-step-title">
                    Xác nhận
                </span>

            </div>

        </div>

    </div>


    @* =====================================================
       BOOKING CONTENT
       ===================================================== *@

    <section class="booking-content">


        @* =================================================
           CONTENT HEADER
           ================================================= *@

        <div class="booking-content-header">

            <div class="booking-content-icon">

                <i class="@GetContentIcon()"></i>

            </div>


            <div>

                <h2>
                    @GetContentTitle()
                </h2>

                <p>
                    @GetContentDescription()
                </p>

            </div>

        </div>


        @* =================================================
           STEP 1 - SPECIALTY
           ================================================= *@

        @if (_bookingStateService.CurrentStep == 1)
        {
            @* =============================================
               LOADING
               ============================================= *@

            @if (_bookingStateService.IsLoading)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-spinner fa-spin"></i>

                    </div>


                    <h3>
                        Đang tải chuyên khoa
                    </h3>


                    <p>
                        Vui lòng chờ trong giây lát.
                    </p>

                </div>
            }


            @* =============================================
               ERROR
               ============================================= *@

            else if (!string.IsNullOrWhiteSpace(
                _bookingStateService.ErrorMessage))
            {
                <div class="booking-state booking-state-error">

                    <div class="booking-state-icon">

                        <i class="fas fa-exclamation-circle"></i>

                    </div>


                    <h3>
                        Không thể tải chuyên khoa
                    </h3>


                    <p>
                        @_bookingStateService.ErrorMessage
                    </p>


                    <button type="button" class="booking-retry-button" @onclick="RetrySpecialtiesAsync">

                        <i class="fas fa-redo-alt"></i>

                        Thử lại

                    </button>

                </div>
            }


            @* =============================================
               EMPTY
               ============================================= *@

            else if (_bookingStateService.Specialties.Count == 0)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-stethoscope"></i>

                    </div>


                    <h3>
                        Chưa có chuyên khoa
                    </h3>


                    <p>
                        Hiện chưa có chuyên khoa nào
                        đang hoạt động.
                    </p>

                </div>
            }


            @* =============================================
               SPECIALTY LIST
               ============================================= *@

            else
            {
                <div class="specialty-grid">

                    @foreach (var specialty in
                        _bookingStateService.Specialties)
                    {
                        var isSelected =
                            _bookingStateService
                                .SelectedSpecialtyId ==
                            specialty.Id;


                        <button type="button" class="specialty-card @(isSelected ? "selected" : "")"
                                @onclick="() => SelectSpecialtyAsync(specialty.Id)">


                            @* =================================
                               ICON
                               ================================= *@

                            <div class="specialty-card-icon">

                                <i class="fas fa-stethoscope"></i>

                            </div>


                            @* =================================
                               INFORMATION
                               ================================= *@

                            <div class="specialty-card-content">

                                <h3 class="specialty-card-name">
                                    @specialty.Name
                                </h3>


                                <p class="specialty-card-description">
                                    Chọn chuyên khoa này để xem
                                    danh sách bác sĩ phù hợp.
                                </p>

                            </div>


                            @* =================================
                               ACTION
                               ================================= *@

                            <div class="specialty-card-arrow">

                                @if (isSelected)
                                {
                                    <i class="fas fa-check"></i>
                                }
                                else
                                {
                                    <i class="fas fa-arrow-right"></i>
                                }

                            </div>

                        </button>
                    }

                </div>
            }
        }


        @* =================================================
           STEP 2 - DOCTOR
           ================================================= *@

        else if (_bookingStateService.CurrentStep == 2)
        {
            @* =============================================
               LOADING
               ============================================= *@

            @if (_bookingStateService.IsLoading)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-spinner fa-spin"></i>

                    </div>


                    <h3>
                        Đang tải danh sách bác sĩ
                    </h3>


                    <p>
                        Vui lòng chờ trong giây lát.
                    </p>

                </div>
            }


            @* =============================================
               ERROR
               ============================================= *@

            else if (!string.IsNullOrWhiteSpace(
                _bookingStateService.ErrorMessage))
            {
                <div class="booking-state booking-state-error">

                    <div class="booking-state-icon">

                        <i class="fas fa-exclamation-circle"></i>

                    </div>


                    <h3>
                        Không thể tải danh sách bác sĩ
                    </h3>


                    <p>
                        @_bookingStateService.ErrorMessage
                    </p>


                    <button type="button" class="booking-retry-button" @onclick="RetryDoctorsAsync">

                        <i class="fas fa-redo-alt"></i>

                        Thử lại

                    </button>

                </div>
            }


            @* =============================================
               EMPTY
               ============================================= *@

            else if (_bookingStateService.Doctors.Count == 0)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-user-md"></i>

                    </div>


                    <h3>
                        Chưa có bác sĩ phù hợp
                    </h3>


                    <p>
                        Hiện chưa có bác sĩ đang hoạt động
                        trong chuyên khoa đã chọn.
                    </p>

                </div>
            }


            @* =============================================
               DOCTOR LIST
               ============================================= *@

            else
            {
                <div class="doctor-grid">

                    @foreach (var doctor in
                        _bookingStateService.Doctors)
                    {
                        <button type="button" class="doctor-card" @onclick="() => SelectDoctor(doctor)">


                            @* =================================
                               AVATAR
                               ================================= *@

                            <div class="doctor-avatar">

                                @if (!string.IsNullOrWhiteSpace(
                                    doctor.AvatarUrl))
                                {
                                    <img src="@doctor.AvatarUrl" alt="@doctor.FullName" />
                                }
                                else
                                {
                                    <i class="fas fa-user-md"></i>
                                }

                            </div>


                            @* =================================
                               INFORMATION
                               ================================= *@

                            <div class="doctor-card-content">

                                <div class="doctor-card-header">

                                    <div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            doctor.Title))
                                        {
                                            <span class="doctor-title">
                                                @doctor.Title
                                            </span>
                                        }


                                        <h3 class="doctor-name">
                                            @doctor.FullName
                                        </h3>

                                    </div>


                                    <div class="doctor-select-icon">

                                        <i class="fas fa-arrow-right"></i>

                                    </div>

                                </div>


                                @* =================================
                                   DETAILS
                                   ================================= *@

                                <div class="doctor-details">

                                    @if (doctor.ExperienceYears > 0)
                                    {
                                        <div class="doctor-detail-item">

                                            <i class="fas fa-briefcase-medical"></i>

                                            <span>
                                                @doctor.ExperienceYears năm kinh nghiệm
                                            </span>

                                        </div>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(
                                        doctor.Room))
                                    {
                                        <div class="doctor-detail-item">

                                            <i class="fas fa-door-open"></i>

                                            <span>
                                                Phòng @doctor.Room
                                            </span>

                                        </div>
                                    }

                                </div>


                                @* =================================
                                   CONSULTATION FEE
                                   ================================= *@

                                <div class="doctor-card-footer">

                                    <span class="doctor-fee-label">
                                        Phí khám
                                    </span>


                                    <span class="doctor-fee">
                                        @doctor.ConsultationFee.ToString("N0") đ
                                    </span>

                                </div>

                            </div>

                        </button>
                    }

                </div>
            }
        }

        @* =================================================
        STEP 3 - TIME
        ================================================= *@

        else if (_bookingStateService.CurrentStep == 3)
        {
            <div class="booking-time-section">

                @* =============================================
           SELECTED DOCTOR
           ============================================= *@

                @if (_bookingStateService.SelectedDoctor != null)
                {
                    var doctor =
                        _bookingStateService.SelectedDoctor;


                    <div class="selected-doctor-summary">

                        <div class="selected-doctor-icon">

                            <i class="fas fa-user-md"></i>

                        </div>


                        <div class="selected-doctor-content">

                            <span class="selected-doctor-label">
                                Bác sĩ đã chọn
                            </span>


                            <h3 class="selected-doctor-name">
                                @doctor.FullName
                            </h3>


                            <div class="selected-doctor-meta">

                                @if (!string.IsNullOrWhiteSpace(
                                    doctor.Title))
                                {
                                    <span>
                                        @doctor.Title
                                    </span>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                                    doctor.Room))
                                {
                                    <span>
                                        Phòng @doctor.Room
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="selected-doctor-fee">

                            <span>
                                Phí khám
                            </span>

                            <strong>
                                @doctor.ConsultationFee.ToString("N0") đ
                            </strong>

                        </div>

                    </div>
                }


                @* =============================================
           DATE SECTION
           ============================================= *@

                <div class="booking-date-section">

                    <div class="booking-section-title">

                        <div>

                            <h3>
                                Chọn ngày khám
                            </h3>

                            <p>
                                Chọn ngày bạn muốn đến khám.
                            </p>

                        </div>

                    </div>


                    @* =========================================
                DATE PICKER
                ========================================= *@

                    <div class="booking-date-picker">

                        <label for="appointment-date" class="booking-date-label">

                            <i class="far fa-calendar-alt"></i>

                            Ngày khám

                        </label>


                        <input id="appointment-date" type="date" class="booking-date-input" min="@GetMinimumDate()"
                               value="@GetSelectedDateValue()" @onchange="HandleDateChanged" />


                        @if (_bookingStateService.SelectedDate.HasValue)
                        {
                            <div class="selected-date-info">

                                <i class="fas fa-check-circle"></i>

                                <span>
                                    Ngày đã chọn:
                                </span>

                                <strong>
                                    @_bookingStateService.SelectedDate.Value.ToString("dd/MM/yyyy")
                                </strong>

                            </div>
                        }
                        @* =========================================
                        SLOT LOAD STATE
                        ========================================= *@

                        @if (_bookingStateService.SelectedDate.HasValue)
                        {
                            @if (_bookingStateService.IsLoading)
                            {
                                <div class="slot-load-state">

                                    <i class="fas fa-spinner fa-spin"></i>

                                    <span>
                                        Đang kiểm tra khung giờ trống...
                                    </span>

                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(
                                _bookingStateService.ErrorMessage))
                            {
                                <div class="slot-load-state slot-load-error">

                                    <i class="fas fa-exclamation-circle"></i>

                                    <span>
                                        @_bookingStateService.ErrorMessage
                                    </span>

                                </div>
                            }
                            else
                            {
                                @* =========================================
                                AVAILABLE SLOT LIST
                                ========================================= *@

                                <div class="booking-slot-section">

                                    <div class="booking-section-title">

                                        <div>

                                            <h3>
                                                Chọn khung giờ
                                            </h3>

                                            <p>
                                                Chọn thời gian bạn muốn đến khám.
                                            </p>

                                        </div>

                                    </div>


                                    <div class="slot-grid">

                                        @foreach (var slot in
                                            _bookingStateService.AvailableSlots)
                                        {
                                            <button type="button" class="slot-card" @onclick="() => SelectSlot(slot)">

                                                <i class="far fa-clock"></i>

                                                <span>
                                                    @(slot.StartTime.ToString("HH:mm"))
                                                </span>

                                                <small>
                                                    @(slot.EndTime.ToString("HH:mm"))
                                                </small>

                                            </button>
                                        }

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>
        }

        @* =================================================
        STEP 4 - CONFIRM
        ================================================= *@

        else if (_bookingStateService.CurrentStep == 4)
        {
            <div class="booking-confirm-section">

                @* =============================================
                CONFIRM HEADER
                ============================================= *@

                <div class="booking-confirm-message">

                    <div class="booking-confirm-message-icon">

                        <i class="fas fa-clipboard-check"></i>

                    </div>


                    <div>

                        <h3>
                            Kiểm tra thông tin lịch khám
                        </h3>

                        <p>
                            Vui lòng kiểm tra lại thông tin
                            trước khi xác nhận đặt lịch.
                        </p>

                    </div>

                </div>


                @* =============================================
                DOCTOR
                ============================================= *@

                @if (_bookingStateService.SelectedDoctor != null)
                {
                    var doctor =
                        _bookingStateService.SelectedDoctor;


                    <div class="booking-confirm-item">

                        <div class="booking-confirm-icon">

                            <i class="fas fa-user-md"></i>

                        </div>


                        <div class="booking-confirm-content">

                            <span>
                                Bác sĩ
                            </span>

                            <strong>
                                @doctor.FullName
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(
                                doctor.Title))
                            {
                                <small>
                                    @doctor.Title
                                </small>
                            }

                        </div>

                    </div>
                }


                @* =============================================
                DATE
                ============================================= *@

                @if (_bookingStateService.SelectedDate.HasValue)
                {
                    <div class="booking-confirm-item">

                        <div class="booking-confirm-icon">

                            <i class="far fa-calendar-alt"></i>

                        </div>


                        <div class="booking-confirm-content">

                            <span>
                                Ngày khám
                            </span>

                            <strong>
                                @(_bookingStateService
                                    .SelectedDate.Value
                                    .ToString("dd/MM/yyyy"))
                            </strong>

                        </div>

                    </div>
                }


                @* =============================================
                SLOT
                ============================================= *@

                @if (_bookingStateService.SelectedSlot != null)
                {
                    var slot =
                        _bookingStateService.SelectedSlot;


                    <div class="booking-confirm-item">

                        <div class="booking-confirm-icon">

                            <i class="far fa-clock"></i>

                        </div>


                        <div class="booking-confirm-content">

                            <span>
                                Khung giờ
                            </span>

                            <strong>
                                @(slot.StartTime.ToString("HH:mm"))
                                -
                                @(slot.EndTime.ToString("HH:mm"))
                            </strong>

                        </div>

                    </div>
                }


                @* =============================================
                CONSULTATION FEE
                ============================================= *@

                @if (_bookingStateService.SelectedDoctor != null)
                {
                    <div class="booking-confirm-item">

                        <div class="booking-confirm-icon">

                            <i class="fas fa-money-bill-wave"></i>

                        </div>


                        <div class="booking-confirm-content">

                            <span>
                                Phí khám dự kiến
                            </span>

                            <strong>
                                @(_bookingStateService
                                    .SelectedDoctor
                                    .ConsultationFee
                                    .ToString("N0")) đ
                            </strong>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>


@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _bookingStateService.OnChange +=
            HandleBookingStateChanged;


        // =================================================
        // RESET BOOKING FLOW
        // =================================================

        _bookingStateService.Reset();


        // =================================================
        // LOAD SPECIALTIES
        // =================================================

        await _bookingStateService
            .LoadSpecialtiesAsync();
    }


    // =====================================================
    // SELECT SPECIALTY
    // =====================================================

    private async Task SelectSpecialtyAsync(
        int specialtyId)
    {
        // =================================================
        // UPDATE SELECTED SPECIALTY
        // =================================================

        _bookingStateService
            .SelectSpecialty(
                specialtyId
            );


        // =================================================
        // LOAD DOCTORS
        // =================================================

        await _bookingStateService
            .LoadDoctorsAsync();
    }


    // =====================================================
    // RETRY SPECIALTIES
    // =====================================================

    private async Task RetrySpecialtiesAsync()
    {
        await _bookingStateService
            .LoadSpecialtiesAsync();
    }


    // =====================================================
    // RETRY DOCTORS
    // =====================================================

    private async Task RetryDoctorsAsync()
    {
        await _bookingStateService
            .LoadDoctorsAsync();
    }


    // =====================================================
    // SELECT DOCTOR
    // =====================================================

    private void SelectDoctor(
        DoctorDTO doctor)
    {
        _bookingStateService
            .SelectDoctor(
                doctor
            );
    }


    // =====================================================
    // GET STEP CLASS
    // =====================================================

    private string GetStepClass(
        int step)
    {
        if (_bookingStateService.CurrentStep == step)
        {
            return "active";
        }


        if (_bookingStateService.CurrentStep > step)
        {
            return "completed";
        }


        return string.Empty;
    }


    // =====================================================
    // GET STEP LINE CLASS
    // =====================================================

    private string GetStepLineClass(
        int step)
    {
        return _bookingStateService.CurrentStep > step
            ? "completed"
            : string.Empty;
    }


    // =====================================================
    // GET CONTENT TITLE
    // =====================================================

    private string GetContentTitle()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "Chọn chuyên khoa",

            2 =>
                "Chọn bác sĩ",

            3 =>
                "Chọn thời gian khám",

            4 =>
                "Xác nhận lịch khám",

            _ =>
                "Đặt lịch khám"
        };
    }


    // =====================================================
    // GET CONTENT DESCRIPTION
    // =====================================================

    private string GetContentDescription()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "Chọn chuyên khoa phù hợp với nhu cầu khám của bạn.",

            2 =>
                "Chọn bác sĩ phù hợp trong chuyên khoa đã chọn.",

            3 =>
                "Chọn ngày và khung giờ khám còn trống.",

            4 =>
                "Kiểm tra lại thông tin trước khi xác nhận đặt lịch.",

            _ =>
                string.Empty
        };
    }


    // =====================================================
    // GET CONTENT ICON
    // =====================================================

    private string GetContentIcon()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "fas fa-stethoscope",

            2 =>
                "fas fa-user-md",

            3 =>
                "far fa-clock",

            4 =>
                "fas fa-clipboard-check",

            _ =>
                "fas fa-calendar-plus"
        };
    }

    // =====================================================
    // GET MINIMUM DATE
    // =====================================================

    private string GetMinimumDate()
    {
        return DateOnly
            .FromDateTime(
                DateTime.Today
            )
            .ToString(
                "yyyy-MM-dd"
            );
    }


    // =====================================================
    // GET SELECTED DATE VALUE
    // =====================================================

    private string GetSelectedDateValue()
    {
        return _bookingStateService
            .SelectedDate?
            .ToString(
                "yyyy-MM-dd"
            )
            ?? string.Empty;
    }


    // =====================================================
    // HANDLE DATE CHANGED
    // =====================================================

    private async Task HandleDateChanged(
        ChangeEventArgs e)
    {
        var value =
            e.Value?.ToString();


        // =================================================
        // EMPTY DATE
        // =================================================

        if (string.IsNullOrWhiteSpace(
            value))
        {
            return;
        }


        // =================================================
        // PARSE DATE
        // =================================================

        if (!DateOnly.TryParse(
            value,
            out var selectedDate))
        {
            return;
        }


        // =================================================
        // PREVENT PAST DATE
        // =================================================

        var today =
            DateOnly.FromDateTime(
                DateTime.Today
            );


        if (selectedDate < today)
        {
            return;
        }


        // =================================================
        // SELECT DATE
        // =================================================

        _bookingStateService
            .SelectDate(
                selectedDate
            );


        // =================================================
        // LOAD AVAILABLE SLOTS
        // =================================================

        await _bookingStateService
            .LoadAvailableSlotsAsync();
    }

    // =====================================================
    // SELECT SLOT
    // =====================================================

    private void SelectSlot(
        SlotDTO slot)
    {
        _bookingStateService
            .SelectSlot(
                slot
            );
    }

    

    // =====================================================
    // HANDLE BOOKING STATE CHANGED
    // =====================================================

    private void HandleBookingStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _bookingStateService.OnChange -=
            HandleBookingStateChanged;
    }
}