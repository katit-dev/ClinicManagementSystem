@page "/patient/booking"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject BookingStateService _bookingStateService

@implements IDisposable

<PageTitle>Đặt lịch khám</PageTitle>


@* =====================================================
   BOOKING PAGE
   ===================================================== *@

<div class="booking-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="booking-header">

        <div>

            <div class="booking-header-label">

                <i class="fas fa-calendar-plus"></i>

                <span>
                    VC-03
                </span>

            </div>


            <h1 class="booking-title">
                Đặt lịch khám
            </h1>


            <p class="booking-description">
                Chọn chuyên khoa, bác sĩ và thời gian
                phù hợp để tạo lịch khám mới.
            </p>

        </div>

    </div>


    @* =================================================
       BOOKING STEPS
       ================================================= *@

    <div class="booking-steps">

        @* =============================================
           STEP 1
           ============================================= *@

        <div class="booking-step active">

            <div class="booking-step-number">
                1
            </div>

            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 1
                </span>

                <span class="booking-step-title">
                    Chuyên khoa
                </span>

            </div>

        </div>


        <div class="booking-step-line"></div>


        @* =============================================
           STEP 2
           ============================================= *@

        <div class="booking-step">

            <div class="booking-step-number">
                2
            </div>

            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 2
                </span>

                <span class="booking-step-title">
                    Bác sĩ
                </span>

            </div>

        </div>


        <div class="booking-step-line"></div>


        @* =============================================
           STEP 3
           ============================================= *@

        <div class="booking-step">

            <div class="booking-step-number">
                3
            </div>

            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 3
                </span>

                <span class="booking-step-title">
                    Thời gian
                </span>

            </div>

        </div>


        <div class="booking-step-line"></div>


        @* =============================================
           STEP 4
           ============================================= *@

        <div class="booking-step">

            <div class="booking-step-number">
                4
            </div>

            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 4
                </span>

                <span class="booking-step-title">
                    Xác nhận
                </span>

            </div>

        </div>

    </div>


    @* =================================================
       BOOKING CONTENT
       ================================================= *@

    <section class="booking-content">

        <div class="booking-content-header">

            <div class="booking-content-icon">

                <i class="fas fa-stethoscope"></i>

            </div>


            <div>

                <h2>
                    Chọn chuyên khoa
                </h2>

                <p>
                    Chọn chuyên khoa phù hợp với
                    nhu cầu khám của bạn.
                </p>

            </div>

        </div>

        @* =====================================================
        SPECIALTY LIST
        ===================================================== *@

        @if (!_bookingStateService.IsLoading &&
             string.IsNullOrWhiteSpace(
                 _bookingStateService.ErrorMessage) &&
             _bookingStateService.Specialties.Count > 0)
        {
            <div class="specialty-grid">

                @foreach (var specialty in
                    _bookingStateService.Specialties)
                {
                    <button type="button" class="specialty-card" @onclick="() => SelectSpecialtyAsync(
                                specialty.Id)">

@* =========================================
                   ICON
                   ========================================= *@

<div class="specialty-card-icon">

                            <i class="fas fa-stethoscope"></i>

                        </div>


                        @* =========================================
                        INFORMATION
                        ========================================= *@

                        <div class="specialty-card-content">

                            <h3 class="specialty-card-name">
                                @specialty.Name
                            </h3>

                            <p class="specialty-card-description">
                                Chọn chuyên khoa này để xem
                                danh sách bác sĩ phù hợp.
                            </p>

                        </div>


                        @* =========================================
                        RROW
                        ========================================= *@

                        <div class="specialty-card-arrow">

                            <i class="fas fa-arrow-right"></i>

                        </div>

                    </button>
                }

            </div>
        }

    </section>

</div>

@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _bookingStateService.OnChange +=
            HandleBookingStateChanged;


        // =================================================
        // RESET BOOKING FLOW
        //
        // Khi user mở lại trang Booking
        // => bắt đầu một lượt đặt lịch mới.
        // =================================================

        _bookingStateService.Reset();


        // =================================================
        // LOAD SPECIALTIES
        // =================================================

        await _bookingStateService
            .LoadSpecialtiesAsync();
    }

    // =====================================================
    // SELECT SPECIALTY
    // =====================================================

    private async Task SelectSpecialtyAsync(
        int specialtyId)
    {
        // =================================================
        // UPDATE SELECTED SPECIALTY
        // =================================================

        _bookingStateService
            .SelectSpecialty(
                specialtyId
            );


        // =================================================
        // LOAD DOCTORS
        // =================================================

        await _bookingStateService
            .LoadDoctorsAsync();
    }


    // =====================================================
    // HANDLE BOOKING STATE CHANGED
    // =====================================================

    private void HandleBookingStateChanged()
    {
        InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _bookingStateService.OnChange -=
            HandleBookingStateChanged;
    }
}