@page "/patient/booking"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject BookingStateService _bookingStateService

@implements IDisposable


<PageTitle>Đặt lịch khám</PageTitle>


@* =====================================================
   BOOKING PAGE
   ===================================================== *@

<div class="booking-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="booking-header">

        <div>

            <div class="booking-header-label">

                <i class="fas fa-calendar-plus"></i>

                <span>
                    VC-03
                </span>

            </div>


            <h1 class="booking-title">
                Đặt lịch khám
            </h1>


            <p class="booking-description">
                Chọn chuyên khoa, bác sĩ và thời gian
                phù hợp để tạo lịch khám mới.
            </p>

        </div>

    </div>


    @* =====================================================
       BOOKING STEPS
       ===================================================== *@

    <div class="booking-steps">


        @* =================================================
           STEP 1 - SPECIALTY
           ================================================= *@

        <div class="booking-step @GetStepClass(1)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 1)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>1</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 1
                </span>

                <span class="booking-step-title">
                    Chuyên khoa
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(1)">
        </div>


        @* =================================================
           STEP 2 - DOCTOR
           ================================================= *@

        <div class="booking-step @GetStepClass(2)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 2)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>2</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 2
                </span>

                <span class="booking-step-title">
                    Bác sĩ
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(2)">
        </div>


        @* =================================================
           STEP 3 - TIME
           ================================================= *@

        <div class="booking-step @GetStepClass(3)">

            <div class="booking-step-number">

                @if (_bookingStateService.CurrentStep > 3)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    <span>3</span>
                }

            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 3
                </span>

                <span class="booking-step-title">
                    Thời gian
                </span>

            </div>

        </div>


        <div class="booking-step-line @GetStepLineClass(3)">
        </div>


        @* =================================================
           STEP 4 - CONFIRM
           ================================================= *@

        <div class="booking-step @GetStepClass(4)">

            <div class="booking-step-number">
                <span>4</span>
            </div>


            <div class="booking-step-content">

                <span class="booking-step-label">
                    Bước 4
                </span>

                <span class="booking-step-title">
                    Xác nhận
                </span>

            </div>

        </div>

    </div>


    @* =====================================================
       BOOKING CONTENT
       ===================================================== *@

    <section class="booking-content">


        @* =================================================
           CONTENT HEADER
           ================================================= *@

        <div class="booking-content-header">

            <div class="booking-content-icon">

                <i class="@GetContentIcon()"></i>

            </div>


            <div>

                <h2>
                    @GetContentTitle()
                </h2>

                <p>
                    @GetContentDescription()
                </p>

            </div>

        </div>


        @* =================================================
           STEP 1 - SPECIALTY
           ================================================= *@

        @if (_bookingStateService.CurrentStep == 1)
        {
            @* =============================================
               LOADING
               ============================================= *@

            @if (_bookingStateService.IsLoading)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-spinner fa-spin"></i>

                    </div>


                    <h3>
                        Đang tải chuyên khoa
                    </h3>


                    <p>
                        Vui lòng chờ trong giây lát.
                    </p>

                </div>
            }


            @* =============================================
               ERROR
               ============================================= *@

            else if (!string.IsNullOrWhiteSpace(
                _bookingStateService.ErrorMessage))
            {
                <div class="booking-state booking-state-error">

                    <div class="booking-state-icon">

                        <i class="fas fa-exclamation-circle"></i>

                    </div>


                    <h3>
                        Không thể tải chuyên khoa
                    </h3>


                    <p>
                        @_bookingStateService.ErrorMessage
                    </p>


                    <button type="button"
                            class="booking-retry-button"
                            @onclick="RetrySpecialtiesAsync">

                        <i class="fas fa-redo-alt"></i>

                        Thử lại

                    </button>

                </div>
            }


            @* =============================================
               EMPTY
               ============================================= *@

            else if (_bookingStateService.Specialties.Count == 0)
            {
                <div class="booking-state">

                    <div class="booking-state-icon">

                        <i class="fas fa-stethoscope"></i>

                    </div>


                    <h3>
                        Chưa có chuyên khoa
                    </h3>


                    <p>
                        Hiện chưa có chuyên khoa nào
                        đang hoạt động.
                    </p>

                </div>
            }


            @* =============================================
               SPECIALTY LIST
               ============================================= *@

            else
            {
                <div class="specialty-grid">

                    @foreach (var specialty in
                        _bookingStateService.Specialties)
                    {
                        var isSelected =
                            _bookingStateService
                                .SelectedSpecialtyId ==
                            specialty.Id;


                        <button type="button"
                                class="specialty-card @(isSelected ? "selected" : "")"
                                @onclick="() => SelectSpecialtyAsync(
                                    specialty.Id)">


                            @* =================================
                               ICON
                               ================================= *@

                            <div class="specialty-card-icon">

                                <i class="fas fa-stethoscope"></i>

                            </div>


                            @* =================================
                               INFORMATION
                               ================================= *@

                            <div class="specialty-card-content">

                                <h3 class="specialty-card-name">
                                    @specialty.Name
                                </h3>


                                <p class="specialty-card-description">
                                    Chọn chuyên khoa này để xem
                                    danh sách bác sĩ phù hợp.
                                </p>

                            </div>


                            @* =================================
                               ACTION
                               ================================= *@

                            <div class="specialty-card-arrow">

                                @if (isSelected)
                                {
                                    <i class="fas fa-check"></i>
                                }
                                else
                                {
                                    <i class="fas fa-arrow-right"></i>
                                }

                            </div>

                        </button>
                    }

                </div>
            }
        }


        @* =================================================
           STEP 2 - DOCTOR
           ================================================= *@

        else if (_bookingStateService.CurrentStep == 2)
        {
            <div class="booking-state">

                <div class="booking-state-icon">

                    <i class="fas fa-user-md"></i>

                </div>


                <h3>
                    Danh sách bác sĩ đã sẵn sàng
                </h3>


                <p>
                    Có @_bookingStateService.Doctors.Count
                    bác sĩ phù hợp với chuyên khoa đã chọn.
                </p>

            </div>
        }

    </section>

</div>


@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _bookingStateService.OnChange +=
            HandleBookingStateChanged;


        // =================================================
        // RESET BOOKING FLOW
        // =================================================

        _bookingStateService.Reset();


        // =================================================
        // LOAD SPECIALTIES
        // =================================================

        await _bookingStateService
            .LoadSpecialtiesAsync();
    }


    // =====================================================
    // SELECT SPECIALTY
    // =====================================================

    private async Task SelectSpecialtyAsync(
        int specialtyId)
    {
        // =================================================
        // UPDATE SELECTED SPECIALTY
        // =================================================

        _bookingStateService
            .SelectSpecialty(
                specialtyId
            );


        // =================================================
        // LOAD DOCTORS
        // =================================================

        await _bookingStateService
            .LoadDoctorsAsync();
    }


    // =====================================================
    // RETRY SPECIALTIES
    // =====================================================

    private async Task RetrySpecialtiesAsync()
    {
        await _bookingStateService
            .LoadSpecialtiesAsync();
    }


    // =====================================================
    // GET STEP CLASS
    // =====================================================

    private string GetStepClass(
        int step)
    {
        if (_bookingStateService.CurrentStep == step)
        {
            return "active";
        }


        if (_bookingStateService.CurrentStep > step)
        {
            return "completed";
        }


        return string.Empty;
    }


    // =====================================================
    // GET STEP LINE CLASS
    // =====================================================

    private string GetStepLineClass(
        int step)
    {
        return _bookingStateService.CurrentStep > step
            ? "completed"
            : string.Empty;
    }


    // =====================================================
    // GET CONTENT TITLE
    // =====================================================

    private string GetContentTitle()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "Chọn chuyên khoa",

            2 =>
                "Chọn bác sĩ",

            3 =>
                "Chọn thời gian khám",

            4 =>
                "Xác nhận lịch khám",

            _ =>
                "Đặt lịch khám"
        };
    }


    // =====================================================
    // GET CONTENT DESCRIPTION
    // =====================================================

    private string GetContentDescription()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "Chọn chuyên khoa phù hợp với nhu cầu khám của bạn.",

            2 =>
                "Chọn bác sĩ phù hợp trong chuyên khoa đã chọn.",

            3 =>
                "Chọn ngày và khung giờ khám còn trống.",

            4 =>
                "Kiểm tra lại thông tin trước khi xác nhận đặt lịch.",

            _ =>
                string.Empty
        };
    }


    // =====================================================
    // GET CONTENT ICON
    // =====================================================

    private string GetContentIcon()
    {
        return _bookingStateService.CurrentStep switch
        {
            1 =>
                "fas fa-stethoscope",

            2 =>
                "fas fa-user-md",

            3 =>
                "far fa-clock",

            4 =>
                "fas fa-clipboard-check",

            _ =>
                "fas fa-calendar-plus"
        };
    }


    // =====================================================
    // HANDLE BOOKING STATE CHANGED
    // =====================================================

    private void HandleBookingStateChanged()
    {
        _ = InvokeAsync(
            StateHasChanged
        );
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _bookingStateService.OnChange -=
            HandleBookingStateChanged;
    }
}