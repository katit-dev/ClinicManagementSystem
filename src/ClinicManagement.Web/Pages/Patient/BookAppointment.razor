@page "/patient/book-appointment"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Patient")]

<PageTitle>Đặt lịch khám</PageTitle>


<div class="container py-4">

    @* =====================================================
       PAGE HEADER
       ===================================================== *@

    <div class="mb-4">
        <h2>Đặt lịch khám</h2>

        <p class="text-muted mb-0">
            Chọn chuyên khoa, bác sĩ và thời gian khám phù hợp.
        </p>
    </div>


    @* =====================================================
       BOOKING FORM
       ===================================================== *@

    <div class="card shadow-sm">
        <div class="card-body">

            @* =================================================
               STEP 1 - SPECIALTY
               ================================================= *@

            <div class="mb-3">
                <label class="form-label">
                    Chuyên khoa
                </label>

                <select class="form-select"
                        disabled>
                    <option>
                        -- Chọn chuyên khoa --
                    </option>
                </select>
            </div>


            @* =================================================
               STEP 2 - DOCTOR
               ================================================= *@

            <div class="mb-3">
                <label class="form-label">
                    Bác sĩ
                </label>

                <select class="form-select"
                        disabled>
                    <option>
                        -- Chọn bác sĩ --
                    </option>
                </select>
            </div>


            @* =================================================
               STEP 3 - APPOINTMENT DATE
               ================================================= *@

            <div class="mb-3">
                <label class="form-label">
                    Ngày khám
                </label>

                <input type="date"
                       class="form-control"
                       disabled />
            </div>


            @* =================================================
               STEP 4 - AVAILABLE SLOT
               ================================================= *@

            <div class="mb-3">
                <label class="form-label">
                    Khung giờ
                </label>

                <div class="text-muted">
                    Chưa có khung giờ được chọn.
                </div>
            </div>


            @* =================================================
               STEP 5 - REASON
               ================================================= *@

            <div class="mb-3">
                <label class="form-label">
                    Lý do khám
                </label>

                <textarea class="form-control"
                          rows="3"
                          disabled>
                </textarea>
            </div>


            @* =================================================
               SUBMIT
               ================================================= *@

            <button type="button"
                    class="btn btn-primary"
                    disabled>
                Đặt lịch
            </button>

        </div>
    </div>

</div>