@page "/patient/records"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject PatientRecordStateService _recordStateService

@implements IDisposable

@using ClinicManagementSystem.Application.DTOs.PatientRecord


<PageTitle>Lịch sử khám & đơn thuốc</PageTitle>


@* =====================================================
   PATIENT RECORDS PAGE
   ===================================================== *@

<div class="patient-records-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="patient-records-header">

        <div>

            <h1 class="patient-records-title">
                Lịch sử khám & đơn thuốc
            </h1>


            <p class="patient-records-description">
                Xem lại chẩn đoán, đơn thuốc và kết quả
                cận lâm sàng của các lần khám.
            </p>

        </div>

    </div>


    @* =================================================
       CONTENT
       ================================================= *@

    <section class="patient-records-content">


        @* =================================================
           CONTENT HEADER
           ================================================= *@

        <div class="patient-records-content-header">

            <div>

                <h2>
                    Lịch sử khám
                </h2>

                <p>
                    Các bệnh án đã được hoàn tất.
                </p>

            </div>

        </div>


        @* =================================================
           LOADING
           ================================================= *@

        @if (_recordStateService.IsLoading)
        {
            <div class="patient-records-placeholder">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>


                <h3>
                    Đang tải lịch sử khám
                </h3>


                <p>
                    Vui lòng chờ trong giây lát.
                </p>

            </div>
        }


        @* =================================================
           ERROR
           ================================================= *@

        else if (!string.IsNullOrWhiteSpace(
            _recordStateService.ErrorMessage))
        {
            <div class="patient-records-placeholder patient-records-error">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <h3>
                    Không thể tải lịch sử khám
                </h3>


                <p>
                    @_recordStateService.ErrorMessage
                </p>


                <button type="button" class="patient-records-retry-button" @onclick="RetryRecordsAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }


        @* =================================================
           EMPTY
           ================================================= *@

        else if (_recordStateService.Records.Count == 0)
        {
            <div class="patient-records-placeholder">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-file-medical"></i>

                </div>


                <h3>
                    Chưa có lịch sử khám
                </h3>


                <p>
                    Bạn chưa có bệnh án nào đã được hoàn tất.
                </p>

            </div>
        }


        @* =================================================
           RECORD LIST PLACEHOLDER
           ================================================= *@

        else
        {
            <div class="patient-record-list">

                @foreach (var record in _recordStateService.Records)
                {
                    <article class="patient-record-card">

                        @* =====================================
                   RECORD HEADER
                   ===================================== *@

                        <div class="patient-record-card-header">

                            <div>

                                <div class="patient-record-date">

                                    <i class="far fa-calendar-alt"></i>

                                    <span>
                                        @(record.FinalizedAt?.ToString("dd/MM/yyyy")
                                            ?? record.CreatedAt.ToString("dd/MM/yyyy"))
                                    </span>

                                </div>


                                <h3 class="patient-record-diagnosis">

                                    @GetRecordDiagnosis(record)

                                </h3>


                                <div class="patient-record-doctor">

                                    <i class="fas fa-user-md"></i>

                                    <span>
                                        @record.DoctorName
                                    </span>

                                </div>

                            </div>


                            <span class="patient-record-status">

                                <i class="fas fa-check-circle"></i>

                                Đã hoàn tất

                            </span>

                        </div>


                        @* =====================================
                   RECORD INFORMATION
                   ===================================== *@

                        <div class="patient-record-info">

                            <div class="patient-record-info-item">

                                <span>
                                    Mã ICD-10
                                </span>

                                <strong>
                                    @GetRecordText(record.Icd10Code)
                                </strong>

                            </div>


                            <div class="patient-record-info-item">

                                <span>
                                    Ngày tái khám
                                </span>

                                <strong>
                                    @(record.FollowUpDate.HasValue
                                        ? record.FollowUpDate.Value.ToString("dd/MM/yyyy")
                                        : "Không có")
                                </strong>

                            </div>


                            <div class="patient-record-info-item">

                                <span>
                                    Mã bệnh án
                                </span>

                                <strong>
                                    #@record.Id
                                </strong>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>


@code
{
    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _recordStateService.OnChange += HandleRecordStateChanged;


        // =================================================
        // RESET STATE
        // =================================================

        _recordStateService.Reset();


        // =================================================
        // LOAD RECORDS
        // =================================================

        await _recordStateService.LoadRecordsAsync();
    }


    // =====================================================
    // RETRY RECORDS
    // =====================================================

    private async Task RetryRecordsAsync()
    {
        await _recordStateService.LoadRecordsAsync();
    }
    

    // =====================================================
    // Helper
    // =====================================================

    // GET RECORD DIAGNOSIS

    private string GetRecordDiagnosis(PatientRecordDTO record)
    {
        if (string.IsNullOrWhiteSpace(record.Diagnosis))
        {
            return "Chưa có chẩn đoán";
        }

        if (string.IsNullOrWhiteSpace(record.Icd10Code))
        {
            return record.Diagnosis;
        }

        return $"{record.Diagnosis} ({record.Icd10Code})";
    }

    // GET RECORD TEXT
    private string GetRecordText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Không có thông tin"
            : value;
    }


    // =====================================================
    // HANDLE STATE CHANGED
    // =====================================================

    private void HandleRecordStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _recordStateService.OnChange -= HandleRecordStateChanged;
    }
}