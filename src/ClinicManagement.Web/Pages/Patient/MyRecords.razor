@page "/patient/records"

@layout HomePageMaster

@attribute [Authorize(Roles = "Patient")]

@inject PatientRecordStateService _recordStateService

@implements IDisposable

@using ClinicManagementSystem.Application.DTOs.PatientRecord


<PageTitle>Lịch sử khám & đơn thuốc</PageTitle>


@* =====================================================
   PATIENT RECORDS PAGE
   ===================================================== *@

<div class="patient-records-page">


    @* =================================================
       PAGE HEADER
       ================================================= *@

    <div class="patient-records-header">

        <div>

            <h1 class="patient-records-title">
                Lịch sử khám & đơn thuốc
            </h1>


            <p class="patient-records-description">
                Xem lại chẩn đoán, đơn thuốc và kết quả
                cận lâm sàng của các lần khám.
            </p>

        </div>

    </div>


    @* =================================================
       CONTENT
       ================================================= *@

    <section class="patient-records-content">


        @* =================================================
           CONTENT HEADER
           ================================================= *@

        <div class="patient-records-content-header">

            <div>

                <h2>
                    Lịch sử khám
                </h2>


                <p>
                    Các bệnh án đã được hoàn tất.
                </p>

            </div>

        </div>


        @* =================================================
           LOADING
           ================================================= *@

        @if (_recordStateService.IsLoading)
        {
            <div class="patient-records-placeholder">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-spinner fa-spin"></i>

                </div>


                <h3>
                    Đang tải lịch sử khám
                </h3>


                <p>
                    Vui lòng chờ trong giây lát.
                </p>

            </div>
        }


        @* =================================================
           ERROR
           ================================================= *@

        else if (!string.IsNullOrWhiteSpace(
            _recordStateService.ErrorMessage))
        {
            <div class="patient-records-placeholder patient-records-error">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-exclamation-circle"></i>

                </div>


                <h3>
                    Không thể tải lịch sử khám
                </h3>


                <p>
                    @_recordStateService.ErrorMessage
                </p>


                <button type="button" class="patient-records-retry-button" @onclick="RetryRecordsAsync">

                    <i class="fas fa-redo-alt"></i>

                    Thử lại

                </button>

            </div>
        }


        @* =================================================
           EMPTY
           ================================================= *@

        else if (_recordStateService.Records.Count == 0)
        {
            <div class="patient-records-placeholder">

                <div class="patient-records-placeholder-icon">

                    <i class="fas fa-file-medical"></i>

                </div>


                <h3>
                    Chưa có lịch sử khám
                </h3>


                <p>
                    Bạn chưa có bệnh án nào đã được hoàn tất.
                </p>

            </div>
        }


        @* =================================================
           RECORD LIST
           ================================================= *@

        else
        {
            <div class="patient-record-list">

                @foreach (var record in _recordStateService.Records)
                {
                    <article class="patient-record-card">


                        @* =====================================
                           RECORD HEADER
                           ===================================== *@

                        <div class="patient-record-card-header">

                            <div>

                                <div class="patient-record-date">

                                    <i class="far fa-calendar-alt"></i>


                                    <span>
                                        @(record.FinalizedAt?.ToString("dd/MM/yyyy")
                                            ?? record.CreatedAt.ToString("dd/MM/yyyy"))
                                    </span>

                                </div>


                                <h3 class="patient-record-diagnosis">
                                    @GetRecordDiagnosis(record)
                                </h3>


                                <div class="patient-record-doctor">

                                    <i class="fas fa-user-md"></i>


                                    <span>
                                        @record.DoctorName
                                    </span>

                                </div>

                            </div>


                            <span class="patient-record-status">

                                <i class="fas fa-check-circle"></i>

                                Đã hoàn tất

                            </span>

                        </div>


                        @* =====================================
                           RECORD INFORMATION
                           ===================================== *@

                        <div class="patient-record-info">

                            <div class="patient-record-info-item">

                                <span>
                                    Mã ICD-10
                                </span>


                                <strong>
                                    @GetRecordText(record.Icd10Code)
                                </strong>

                            </div>


                            <div class="patient-record-info-item">

                                <span>
                                    Ngày tái khám
                                </span>


                                <strong>
                                    @(record.FollowUpDate.HasValue
                                        ? record.FollowUpDate.Value.ToString("dd/MM/yyyy")
                                        : "Không có")
                                </strong>

                            </div>


                            <div class="patient-record-info-item">

                                <span>
                                    Mã bệnh án
                                </span>


                                <strong>
                                    #@record.Id
                                </strong>

                            </div>

                        </div>


                        @* =====================================
                           RECORD ACTION
                           ===================================== *@

                        <div class="patient-record-actions">

                            <button type="button" class="patient-record-detail-button"
                                    @onclick="() => ToggleRecordDetail(record.Id)">

                                @if (IsRecordExpanded(record.Id))
                                {
                                    <i class="fas fa-chevron-up"></i>

                                    <span>
                                        Thu gọn
                                    </span>
                                }
                                else
                                {
                                    <i class="fas fa-chevron-down"></i>

                                    <span>
                                        Xem chi tiết
                                    </span>
                                }

                            </button>

                        </div>


                        @* =====================================
                           RECORD DETAIL
                           ===================================== *@

                        @if (IsRecordExpanded(record.Id))
                        {
                            <div class="patient-record-detail">

                                <div class="patient-record-detail-header">

                                    <div>

                                        <h4>
                                            Chi tiết lần khám
                                        </h4>


                                        <p>
                                            Thông tin đơn thuốc, kết quả cận lâm sàng
                                            và file đính kèm.
                                        </p>

                                    </div>

                                </div>


                                @* =================================
                                 PRESCRIPTION
                                ================================= *@

                                <div class="patient-record-section">

                                    <div class="patient-record-section-header">

                                        <div>

                                            <h5>
                                                <i class="fas fa-prescription-bottle-alt"></i>

                                                Đơn thuốc
                                            </h5>

                                            <p>
                                                Thuốc được kê trong lần khám này.
                                            </p>

                                        </div>

                                    </div>


                                    @if (record.Prescription == null)
                                    {
                                        <div class="patient-record-section-empty">

                                            <i class="fas fa-info-circle"></i>

                                            <span>
                                                Lần khám này không có đơn thuốc.
                                            </span>

                                        </div>
                                    }
                                    else if (record.Prescription.Items.Count == 0)
                                    {
                                        <div class="patient-record-section-empty">

                                            <i class="fas fa-info-circle"></i>

                                            <span>
                                                Đơn thuốc chưa có thuốc.
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-record-prescription-table-wrapper">

                                            <table class="patient-record-prescription-table">

                                                <thead>

                                                    <tr>

                                                        <th>
                                                            Thuốc
                                                        </th>

                                                        <th>
                                                            SL
                                                        </th>

                                                        <th>
                                                            Liều dùng
                                                        </th>

                                                        <th>
                                                            Tần suất
                                                        </th>

                                                        <th>
                                                            Số ngày
                                                        </th>

                                                        <th>
                                                            Hướng dẫn
                                                        </th>

                                                    </tr>

                                                </thead>


                                                <tbody>

                                                    @foreach (var item in record.Prescription.Items)
                                                    {
                                                        <tr>

                                                            <td>

                                                                <strong>
                                                                    @item.MedicineName
                                                                </strong>

                                                            </td>


                                                            <td>
                                                                @item.Quantity
                                                            </td>


                                                            <td>
                                                                @GetRecordText(item.Dosage)
                                                            </td>


                                                            <td>
                                                                @GetRecordText(item.Frequency)
                                                            </td>


                                                            <td>
                                                                @(item.DurationDays.HasValue
                                                                    ? $"{item.DurationDays.Value} ngày"
                                                                    : "Không có")
                                                            </td>


                                                            <td>
                                                                @GetRecordText(item.Instruction)
                                                            </td>

                                                        </tr>
                                                    }

                                                </tbody>

                                            </table>

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(record.Prescription.Note))
                                        {
                                            <div class="patient-record-prescription-note">

                                                <span>
                                                    Ghi chú đơn thuốc
                                                </span>

                                                <p>
                                                    @record.Prescription.Note
                                                </p>

                                            </div>
                                        }
                                    }

                                </div>

                                @* =================================
                                LAB RESULTS
                                 ================================= *@

                                <div class="patient-record-section">

                                    <div class="patient-record-section-header">

                                        <div>

                                            <h5>
                                                <i class="fas fa-vials"></i>

                                                Kết quả cận lâm sàng
                                            </h5>

                                            <p>
                                                Kết quả xét nghiệm và dịch vụ cận lâm sàng.
                                            </p>

                                        </div>

                                    </div>


                                    @if (record.LabResults.Count == 0)
                                    {
                                        <div class="patient-record-section-empty">

                                            <i class="fas fa-info-circle"></i>

                                            <span>
                                                Lần khám này chưa có kết quả cận lâm sàng.
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="patient-record-lab-table-wrapper">

                                            <table class="patient-record-lab-table">

                                                <thead>

                                                    <tr>

                                                        <th>
                                                            Dịch vụ
                                                        </th>

                                                        <th>
                                                            Mã
                                                        </th>

                                                        <th>
                                                            Kết quả
                                                        </th>

                                                        <th>
                                                            Khoảng tham chiếu
                                                        </th>

                                                        <th>
                                                            Kết luận
                                                        </th>

                                                        <th>
                                                            Ngày kết quả
                                                        </th>

                                                    </tr>

                                                </thead>


                                                <tbody>

                                                    @foreach (var labResult in record.LabResults)
                                                    {
                                                        <tr>

                                                            <td>

                                                                <strong>
                                                                    @labResult.ServiceName
                                                                </strong>

                                                            </td>


                                                            <td>
                                                                @GetRecordText(labResult.ServiceCode)
                                                            </td>


                                                            <td>
                                                                @GetRecordText(labResult.ResultValue)
                                                            </td>


                                                            <td>
                                                                @GetRecordText(labResult.ReferenceRange)
                                                            </td>


                                                            <td>
                                                                @GetRecordText(labResult.Conclusion)
                                                            </td>


                                                            <td>
                                                                @(labResult.ResultedAt.HasValue
                                                                    ? labResult.ResultedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                                    : "Không có")
                                                            </td>

                                                        </tr>
                                                    }

                                                </tbody>

                                            </table>

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </article>
                }

            </div>
        }

    </section>

</div>


@code
{
    // =====================================================
    // RECORD DETAIL STATE
    // =====================================================

    private int? _expandedRecordId;


    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        // =================================================
        // SUBSCRIBE STATE CHANGE
        // =================================================

        _recordStateService.OnChange += HandleRecordStateChanged;


        // =================================================
        // RESET STATE
        // =================================================

        _recordStateService.Reset();

        _expandedRecordId = null;


        // =================================================
        // LOAD RECORDS
        // =================================================

        await _recordStateService.LoadRecordsAsync();
    }


    // =====================================================
    // TOGGLE RECORD DETAIL
    // =====================================================

    private void ToggleRecordDetail(int recordId)
    {
        _expandedRecordId = _expandedRecordId == recordId
            ? null
            : recordId;
    }


    // =====================================================
    // IS RECORD EXPANDED
    // =====================================================

    private bool IsRecordExpanded(int recordId)
    {
        return _expandedRecordId == recordId;
    }


    // =====================================================
    // RETRY RECORDS
    // =====================================================

    private async Task RetryRecordsAsync()
    {
        _expandedRecordId = null;

        await _recordStateService.LoadRecordsAsync();
    }


    // =====================================================
    // GET RECORD DIAGNOSIS
    // =====================================================

    private string GetRecordDiagnosis(PatientRecordDTO record)
    {
        if (string.IsNullOrWhiteSpace(record.Diagnosis))
        {
            return "Chưa có chẩn đoán";
        }

        if (string.IsNullOrWhiteSpace(record.Icd10Code))
        {
            return record.Diagnosis;
        }

        return $"{record.Diagnosis} ({record.Icd10Code})";
    }


    // =====================================================
    // GET RECORD TEXT
    // =====================================================

    private string GetRecordText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "Không có thông tin"
            : value;
    }


    // =====================================================
    // HANDLE STATE CHANGED
    // =====================================================

    private void HandleRecordStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }


    // =====================================================
    // DISPOSE
    // =====================================================

    public void Dispose()
    {
        _recordStateService.OnChange -= HandleRecordStateChanged;
    }
}